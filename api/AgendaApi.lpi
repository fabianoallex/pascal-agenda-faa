<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <PathDelim Value="\"/>
    <General>
      <Flags>
        <MainUnitHasCreateFormStatements Value="False"/>
        <MainUnitHasTitleStatement Value="False"/>
        <MainUnitHasScaledStatement Value="False"/>
      </Flags>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="AgendaApi"/>
      <UseAppBundle Value="False"/>
      <ResourceType Value="res"/>
    </General>
    <BuildModes>
      <Item Name="Default" Default="True"/>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <RequiredPackages>
      <Item>
        <PackageName Value="pascal_common_faa"/>
        <DefaultFilename Value="..\external\pascal-common-faa\packages\pascal_common_faa.lpk" Prefer="True"/>
      </Item>
      <Item>
        <PackageName Value="pascaljsonmapper_pkg"/>
        <DefaultFilename Value="..\external\pascal-jsonmapper-faa\packages\pascaljsonmapper_pkg.lpk" Prefer="True"/>
      </Item>
      <Item>
        <PackageName Value="pascal_common_faa_jsonmapper"/>
        <DefaultFilename Value="..\external\pascal-common-faa\packages\pascal_common_faa_jsonmapper.lpk" Prefer="True"/>
      </Item>
      <Item>
        <PackageName Value="pascal_db_faa"/>
        <DefaultFilename Value="..\external\pascal-db-faa\packages\pascal_db_faa.lpk" Prefer="True"/>
      </Item>
      <Item>
        <PackageName Value="pascal_db_faa_sqldb"/>
        <DefaultFilename Value="..\external\pascal-db-faa\packages\pascal_db_faa_sqldb.lpk" Prefer="True"/>
      </Item>
      <Item>
        <PackageName Value="pascal_api_infra_faa"/>
        <DefaultFilename Value="..\external\pascal-api-infra-faa\packages\pascal_api_infra_faa.lpk" Prefer="True"/>
      </Item>
      <Item>
        <PackageName Value="FCL"/>
      </Item>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="AgendaApi.dpr"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="..\src\Agenda.Schema.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="..\src\Agenda.Database.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="..\src\Agenda.Passwords.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="..\src\Agenda.Tokens.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="..\src\Agenda.Auth.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="..\src\Agenda.AuthDtos.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="..\src\Agenda.Text.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="..\src\Agenda.Money.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="..\src\Agenda.Services.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="..\src\Agenda.Professionals.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <PathDelim Value="\"/>
    <Target>
      <Filename Value="AgendaApi"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="..\src;..\external\pascal-api-infra-faa\src;..\external\horse\src"/>
      <OtherUnitFiles Value="..\src;..\external\pascal-api-infra-faa\src\horse;..\external\horse\src"/>
      <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <Parsing>
      <SyntaxOptions>
        <SyntaxMode Value="Delphi"/>
      </SyntaxOptions>
    </Parsing>
    <Linking>
      <Debugging>
        <DebugInfoType Value="dsDwarf3"/>
        <UseHeaptrc Value="True"/>
      </Debugging>
    </Linking>
  </CompilerOptions>
</CONFIG>
