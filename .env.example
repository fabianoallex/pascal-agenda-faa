# Copy to .env next to the executable (or set in the environment).
# PORT=9400
# sqlite (default) or postgresql
# DB_ENGINE=sqlite
# DB_POOL_MAX=10
# SQLite: the file, and (FPC only) the library (default libsqlite3.so.0 on Linux, sqlite3.dll on Windows)
# DB_FILE=agenda.sqlite
# SQLITE_CLIENT=
# PostgreSQL: the database must exist; the migrations create the tables
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=agenda
# DB_USER=postgres
# DB_PASSWORD=
# libpq: on Windows the full path of a 64-bit libpq.dll (Delphi: Win64 only); found by itself on Linux
# PG_CLIENT=

# Seals the JWT signing keys in the database (AES-256-GCM). Required unless DEV_MODE=true.
# Generate: openssl rand -base64 32, then set "v1:<that>" (the part before ':' names the key).
# JWT_KEYS_MASTER_KEY=v1:...
# DEV_MODE=true

# ACCESS_TOKEN_SECONDS=900
# REFRESH_TOKEN_SECONDS=2592000
# PASSWORD_ITERATIONS=210000
# Requests a minute: /auth/ per client address, the rest per tenant
# AUTH_RATE_LIMIT=10
# RATE_LIMIT=600
# Seconds a tenant's catalog entry is cached (suspending one shows after this)
# CATALOG_TTL=30

# Spans to an OpenTelemetry collector (OTLP/HTTP JSON)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# A slot lock in Redis in front of the booking (the database decides either way;
# without REDIS_HOST, or with Redis down, the database alone)
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_CONNECT_TIMEOUT_MS=500
# REDIS_LOCK_PREFIX=agenda:lock:
