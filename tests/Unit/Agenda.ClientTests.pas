unit Agenda.ClientTests;

{ Tests for Agenda.Client on the fake transport: what each route sends (the
  path and query, the body, If-Match, Idempotency-Key), the server's DTOs
  read back, a body refused before any request (TApiSchema.Check), the
  login and the logout, and a 401 renewed through POST /auth/refresh. The
  same calls against the real api: tools/AgendaClientCheck.

  DUnitX master. The FPCUnit mirror (tests/Unit/fpc) is generated by
  tools/gen_fpc_mirror.py; never edit the mirror by hand. }

interface

uses
  DUnitX.TestFramework,
  Agenda.DUnitXCompat,
  SysUtils,
  PascalCommon.Optionals,
  PascalCommon.Validators,
  PascalJsonMapper.Json,
  PascalApi.HttpTransport,
  PascalApi.HttpTransport.Fake,
  Agenda.HttpClient,
  Agenda.Appointments.Dtos,
  Agenda.Customers.Dtos,
  Agenda.Day.Dtos,
  Agenda.Client;

type
  [TestFixture]
  TClientTests = class
  private
    FFake: TFakeHttpTransport;
    FTransport: IHttpTransport;
    FClient: TAgendaClient;
    procedure LoginAsStaff;
    procedure CreateNamelessCustomer;
  public
    [Setup] procedure Setup;
    [TearDown] procedure TearDown;
    [Test] procedure Login_StartsTheSession;
    [Test] procedure Login_Refused;
    [Test] procedure Day_PathAndQuery_Read;
    [Test] procedure Book_KeyAndBody_Read;
    [Test] procedure Move_IfMatch_OnlyStartsAt;
    [Test] procedure SetStatus_NeverRetried;
    [Test] procedure Cancel_IfMatch_NoBody;
    [Test] procedure Customers_PageRead;
    [Test] procedure Customer_CreateChecked_PatchThreeStates;
    [Test] procedure Expired_RefreshedOnce_ThenAgain;
    [Test] procedure Logout_SendsTheRefreshToken_Forgets;
  end;

implementation

const
  TOKENS_0 = '{"accessToken":"acc0","tokenType":"Bearer","expiresIn":900,"refreshToken":"ref0"}';
  TOKENS_1 = '{"accessToken":"acc1","tokenType":"Bearer","expiresIn":900,"refreshToken":"ref1"}';
  APPOINTMENT_1 = '{"id":"a1","professionalId":"p1","serviceId":"s1","customerId":"c1",' +
    '"startsAt":"2026-11-02T12:00:00Z","endsAt":"2026-11-02T12:30:00Z","status":"booked","version":1}';

procedure TClientTests.Setup;
begin
  FFake := TFakeHttpTransport.Create;
  FTransport := FFake;
  FClient := TAgendaClient.Create('http://agenda.test', FTransport);
end;

procedure TClientTests.TearDown;
begin
  FClient.Free;
  FClient := nil;
  FTransport := nil;
  FFake := nil;
end;

procedure TClientTests.LoginAsStaff;
begin
  FFake.Answer(200, TOKENS_0);
  FClient.Login('demo', 'staff@demo.test', 'secret');
end;

procedure TClientTests.CreateNamelessCustomer;
var
  LCustomer: TCustomerInsert;
  LKeep: ICustomerInsert;
begin
  LCustomer := TCustomerInsert.Create;
  LKeep := LCustomer;
  LCustomer.Name := StringOfChar('x', 101);
  FClient.CreateCustomer(LKeep);
end;

procedure TClientTests.Login_StartsTheSession;
var
  LSent: TTransportRequest;
begin
  TAssert.AssertFalse(FClient.LoggedIn);
  LoginAsStaff;
  TAssert.AssertTrue(FClient.LoggedIn);
  LSent := FFake.Request(0);
  TAssert.AssertEquals('POST', LSent.Method);
  TAssert.AssertEquals('http://agenda.test/auth/login', LSent.Url);
  TAssert.AssertEquals('{"tenant":"demo","email":"staff@demo.test","password":"secret"}', LSent.Body);
  TAssert.AssertEquals('', LSent.Header('Authorization'));
  // The next call carries the token.
  FFake.Answer(200, '{"id":"u1","email":"staff@demo.test","role":"staff","tenant":"demo"}');
  TAssert.AssertEquals('staff', FClient.Me.Role);
  TAssert.AssertEquals('Bearer acc0', FFake.Request(1).Header('Authorization'));
end;

procedure TClientTests.Login_Refused;
begin
  FFake.Answer(401, '{"error":"Invalid email or password.","code":"invalid_credentials"}');
  try
    FClient.Login('demo', 'staff@demo.test', 'wrong');
    TAssert.Fail('no EApiError');
  except
    on E: EApiError do
      TAssert.AssertEquals('invalid_credentials', E.Code);
  end;
  TAssert.AssertFalse(FClient.LoggedIn);
  TAssert.AssertEquals(1, FFake.RequestCount);
end;

procedure TClientTests.Day_PathAndQuery_Read;
var
  LDay: IDay;
begin
  LoginAsStaff;
  FFake.Answer(200, '{"date":"2026-11-02","timeZone":"America/Sao_Paulo","appointments":[' +
    '{"id":"a1","startsAt":"2026-11-02T12:00:00Z","endsAt":"2026-11-02T12:30:00Z",' +
    '"localStart":"2026-11-02T09:00:00","localEnd":"2026-11-02T09:30:00","status":"booked",' +
    '"version":3,"professionalId":"p 1","professionalName":"Ana","serviceId":"s1",' +
    '"serviceName":"Corte","customerId":"c1","customerName":"João"}]}');
  LDay := FClient.GetDay('2026-11-02', 'p 1');
  TAssert.AssertEquals('America/Sao_Paulo', LDay.TimeZone);
  TAssert.AssertEquals(1, Length(LDay.Appointments));
  TAssert.AssertEquals(3, LDay.Appointments[0].Version);
  TAssert.AssertEquals('2026-11-02T09:00:00', LDay.Appointments[0].LocalStart);
  TAssert.AssertEquals('João', LDay.Appointments[0].CustomerName);
  TAssert.AssertEquals('http://agenda.test/agenda/day?date=2026-11-02&professional=p%201',
    FFake.Request(1).Url);
end;

procedure TClientTests.Book_KeyAndBody_Read;
var
  LBooking: TAppointmentInsert;
  LKeep: IAppointmentInsert;
  LBooked: IAppointment;
  LSent: TTransportRequest;
begin
  LoginAsStaff;
  LBooking := TAppointmentInsert.Create;
  LKeep := LBooking;
  LBooking.ProfessionalId := 'p1';
  LBooking.ServiceId := 's1';
  LBooking.CustomerId := 'c1';
  LBooking.StartsAt := JsonStrToUtcDateTime('2026-11-02T12:00:00Z');
  FFake.Fail;
  FFake.Answer(201, APPOINTMENT_1, ['ETag: "1"']);
  FClient.Http.BackoffMs := 0;
  LBooked := FClient.Book(LKeep, 'key-1');
  TAssert.AssertEquals('a1', LBooked.Id);
  TAssert.AssertEquals(STATUS_BOOKED, LBooked.Status);
  TAssert.AssertEquals(3, FFake.RequestCount);
  LSent := FFake.Request(2);
  TAssert.AssertEquals('http://agenda.test/appointments', LSent.Url);
  TAssert.AssertEquals('key-1', LSent.Header('Idempotency-Key'));
  TAssert.AssertEquals('key-1', FFake.Request(1).Header('Idempotency-Key'));
  TAssert.AssertEquals('{"professionalId":"p1","serviceId":"s1","customerId":"c1",' +
    '"startsAt":"2026-11-02T12:00:00Z"}', LSent.Body);
end;

procedure TClientTests.Move_IfMatch_OnlyStartsAt;
var
  LSent: TTransportRequest;
begin
  LoginAsStaff;
  FFake.Answer(200, StringReplace(APPOINTMENT_1, '"version":1', '"version":4', []));
  TAssert.AssertEquals(4, FClient.Move('a1', 3, JsonStrToUtcDateTime('2026-11-02T13:00:00Z')).Version);
  LSent := FFake.Request(1);
  TAssert.AssertEquals('PATCH', LSent.Method);
  TAssert.AssertEquals('http://agenda.test/appointments/a1', LSent.Url);
  TAssert.AssertEquals('"3"', LSent.Header('If-Match'));
  TAssert.AssertEquals('{"startsAt":"2026-11-02T13:00:00Z"}', LSent.Body);
  TAssert.AssertEquals('', LSent.Header('Idempotency-Key'));
end;

procedure TClientTests.SetStatus_NeverRetried;
begin
  LoginAsStaff;
  FFake.Answer(503, '');
  FFake.Answer(412, '{"error":"changed","code":"precondition_failed"}');
  try
    FClient.SetStatus('a1', 1, STATUS_CONFIRMED);
    TAssert.Fail('no EApiError');
  except
    on E: EApiError do
      TAssert.AssertEquals(503, E.Status);
  end;
  TAssert.AssertEquals('{"status":"confirmed"}', FFake.Request(1).Body);
  // Never retried: the 503 went to the caller, the 412 is still queued.
  TAssert.AssertEquals(2, FFake.RequestCount);
  TAssert.AssertEquals(1, FFake.Pending);
end;

procedure TClientTests.Cancel_IfMatch_NoBody;
var
  LSent: TTransportRequest;
begin
  LoginAsStaff;
  FFake.Answer(200, StringReplace(StringReplace(APPOINTMENT_1, '"version":1', '"version":2', []),
    '"booked"', '"cancelled"', []));
  TAssert.AssertEquals(STATUS_CANCELLED, FClient.Cancel('a1', 1).Status);
  LSent := FFake.Request(1);
  TAssert.AssertEquals('POST', LSent.Method);
  TAssert.AssertEquals('http://agenda.test/appointments/a1/cancel', LSent.Url);
  TAssert.AssertEquals('"1"', LSent.Header('If-Match'));
  TAssert.AssertEquals('', LSent.Body);
end;

procedure TClientTests.Customers_PageRead;
var
  LInfo: TApiPageInfo;
  LCustomers: TCustomerArray;
begin
  LoginAsStaff;
  FFake.Answer(200, '{"page":2,"limit":2,"total":5,"totalPages":3,"hasNext":true,' +
    '"hasPrev":true,"items":[{"id":"c3","name":"Ana","phone":null,"email":"ana@x.test"},' +
    '{"id":"c4","name":"Bia","phone":"11999990000","email":null}]}');
  LCustomers := FClient.FindCustomers('a b', 2, 2, LInfo);
  TAssert.AssertEquals(2, Length(LCustomers));
  TAssert.AssertEquals('Ana', LCustomers[0].Name);
  TAssert.AssertTrue(LCustomers[0].Phone.IsNull);
  TAssert.AssertEquals('ana@x.test', LCustomers[0].Email.Value);
  TAssert.AssertEquals('11999990000', LCustomers[1].Phone.Value);
  TAssert.AssertEquals(2, LInfo.Page);
  TAssert.AssertEquals(Int64(5), LInfo.Total);
  TAssert.AssertTrue(LInfo.HasNext);
  TAssert.AssertEquals('http://agenda.test/customers?search=a%20b&page=2&limit=2&orderBy=name',
    FFake.Request(1).Url);
end;

procedure TClientTests.Customer_CreateChecked_PatchThreeStates;
var
  LChange: TCustomerPatch;
  LKeep: ICustomerPatch;
begin
  LoginAsStaff;
  TAssert.AssertException(EPcValidationError, CreateNamelessCustomer);
  TAssert.AssertEquals(1, FFake.RequestCount);
  // The email cleared, the phone untouched, the name changed.
  LChange := TCustomerPatch.Create;
  LKeep := LChange;
  LChange.Name := TOptNullString.From('Ana Maria');
  LChange.Email := TOptNullString.Null;
  FFake.Answer(200, '{"id":"c3","name":"Ana Maria","phone":"11999990000","email":null}');
  TAssert.AssertTrue(FClient.UpdateCustomer('c3', LKeep).Email.IsNull);
  TAssert.AssertEquals('{"name":"Ana Maria","email":null}', FFake.Request(1).Body);
  TAssert.AssertEquals('', FFake.Request(1).Header('If-Match'));
end;

procedure TClientTests.Expired_RefreshedOnce_ThenAgain;
var
  LSent: TTransportRequest;
begin
  LoginAsStaff;
  FFake.Answer(401, '{"error":"Token expired.","code":"invalid_token"}');
  FFake.Answer(200, TOKENS_1);
  FFake.Answer(200, '{"id":"u1","email":"staff@demo.test","role":"staff","tenant":"demo"}');
  TAssert.AssertEquals('u1', FClient.Me.Id);
  LSent := FFake.Request(2);
  TAssert.AssertEquals('http://agenda.test/auth/refresh', LSent.Url);
  TAssert.AssertEquals('{"refreshToken":"ref0"}', LSent.Body);
  TAssert.AssertEquals('', LSent.Header('Authorization'));
  TAssert.AssertEquals('Bearer acc1', FFake.Request(3).Header('Authorization'));
  TAssert.AssertEquals(1, FClient.Session.Refreshes);

  // The refresh refused: the session is over, the 401 reaches the caller.
  FFake.Answer(401, '');
  FFake.Answer(401, '{"error":"Invalid refresh token.","code":"invalid_refresh_token"}');
  try
    FClient.Me;
    TAssert.Fail('no EApiError');
  except
    on E: EApiError do
      TAssert.AssertEquals(401, E.Status);
  end;
  TAssert.AssertTrue(FClient.SessionLost);
  TAssert.AssertFalse(FClient.LoggedIn);
end;

procedure TClientTests.Logout_SendsTheRefreshToken_Forgets;
begin
  LoginAsStaff;
  FFake.Answer(204);
  TAssert.AssertTrue(FClient.Logout);
  TAssert.AssertEquals('http://agenda.test/auth/logout', FFake.Request(1).Url);
  TAssert.AssertEquals('{"refreshToken":"ref0"}', FFake.Request(1).Body);
  TAssert.AssertFalse(FClient.LoggedIn);
  // Again: nothing to send. With no server: False, no exception.
  TAssert.AssertFalse(FClient.Logout);
  TAssert.AssertEquals(2, FFake.RequestCount);
  LoginAsStaff;
  FFake.Fail;
  TAssert.AssertFalse(FClient.Logout);
  TAssert.AssertFalse(FClient.LoggedIn);
end;

initialization
  TDUnitX.RegisterTestFixture(TClientTests);

end.
