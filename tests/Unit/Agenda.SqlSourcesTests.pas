unit Agenda.SqlSourcesTests;

{ Tests for Agenda.SqlSources (TFallbackSqlSource: the database's own
  directory first, then the common one) and for the schema's use of it
  (every migration found from both engines' directories).

  DUnitX master. The FPCUnit mirror (tests/Unit/fpc) is generated by
  tools/gen_fpc_mirror.py; never edit the mirror by hand. }

interface

uses
  DUnitX.TestFramework,
  Agenda.DUnitXCompat,
  SysUtils,
  PascalDb.SqlSources,
  PascalDb.SqlLoader,
  PascalDb.Migrations,
  Agenda.SqlSources,
  Agenda.Schema;

type
  [TestFixture]
  TSqlSourcesTests = class
  private
    function NewSource: ISqlSource;
  public
    [Test] procedure OwnDirectory_OverridesTheCommonOne;
    [Test] procedure Missing_FallsBackToTheCommonOne;
    [Test] procedure Absent_Everywhere_IsFalse;
    [Test] procedure CommonDirectory_LooksOnce;
    [Test] procedure DirectoryNames_IgnoreCase;
    [Test] procedure Loader_NotFound_NamesBothPlaces;
    [Test] procedure Create_RefusesNilAndEmpty;
    [Test] procedure Schema_EveryMigration_FromBothEngines;
  end;

implementation

function TSqlSourcesTests.NewSource: ISqlSource;
begin
  Result := TFallbackSqlSource.Create(TMemorySqlSource.Create
    .Add('COMMON', 'X', 'SELECT 1')
    .Add('COMMON', 'Y', 'SELECT 2')
    .Add('PG', 'Y', 'SELECT 2 /* PG */'), 'COMMON');
end;

procedure TSqlSourcesTests.OwnDirectory_OverridesTheCommonOne;
var
  LSql: string;
begin
  TAssert.AssertTrue(NewSource.TryGetSql('PG', 'Y', LSql));
  TAssert.AssertEquals('SELECT 2 /* PG */', LSql);
end;

procedure TSqlSourcesTests.Missing_FallsBackToTheCommonOne;
var
  LSql: string;
begin
  TAssert.AssertTrue(NewSource.TryGetSql('PG', 'X', LSql));
  TAssert.AssertEquals('SELECT 1', LSql);
  TAssert.AssertTrue('another engine: the common Y', NewSource.TryGetSql('SQLITE', 'Y', LSql));
  TAssert.AssertEquals('SELECT 2', LSql);
end;

procedure TSqlSourcesTests.Absent_Everywhere_IsFalse;
var
  LSql: string;
begin
  TAssert.AssertFalse(NewSource.TryGetSql('PG', 'Z', LSql));
end;

procedure TSqlSourcesTests.CommonDirectory_LooksOnce;
var
  LSql: string;
begin
  TAssert.AssertTrue(NewSource.TryGetSql('COMMON', 'X', LSql));
  TAssert.AssertEquals('memory COMMON/Z', NewSource.Describe('COMMON', 'Z'));
end;

procedure TSqlSourcesTests.DirectoryNames_IgnoreCase;
begin
  // The memory source writes its keys in upper case; one place named, so
  // 'common' was taken for the common directory.
  TAssert.AssertEquals('the common directory in another case is still it',
    'memory COMMON/Z', NewSource.Describe('common', 'Z'));
end;

procedure TSqlSourcesTests.Loader_NotFound_NamesBothPlaces;
var
  LLoader: TSQLLoader;
  LMessage: string;
begin
  LMessage := '';
  LLoader := TSQLLoader.Create('PG', NewSource);
  try
    try
      LMessage := LLoader['Z'].SQL;
    except
      on E: ESQLLoaderException do
        LMessage := E.Message;
    end;
  finally
    LLoader.Free;
  end;
  TAssert.AssertEquals('SQL not found: PG/Z. Looked in: memory PG/Z, then memory COMMON/Z',
    LMessage);
end;

procedure TSqlSourcesTests.Create_RefusesNilAndEmpty;
var
  LSource, LInner: ISqlSource;
  LRaised: Integer;
begin
  // The inner source in a variable: a new object passed straight to a const
  // interface parameter of a constructor that raises is never released.
  LInner := TMemorySqlSource.Create;
  LRaised := 0;
  try
    LSource := TFallbackSqlSource.Create(nil, 'COMMON');
  except
    on E: EArgumentException do
      Inc(LRaised);
  end;
  try
    LSource := TFallbackSqlSource.Create(LInner, '');
  except
    on E: EArgumentException do
      Inc(LRaised);
  end;
  TAssert.AssertEquals(2, LRaised);
end;

procedure TSqlSourcesTests.Schema_EveryMigration_FromBothEngines;
var
  LSource: ISqlSource;
  LMigrations: TArray<TMigrationItem>;
  LSql: string;
  I: Integer;
begin
  LSource := AgendaSqlSource;
  LMigrations := AgendaMigrations;
  for I := 0 to High(LMigrations) do
  begin
    TAssert.AssertTrue('SQLITE/' + LMigrations[I].ScriptName,
      LSource.TryGetSql(SQLITE_SQL_DIR, LMigrations[I].ScriptName, LSql));
    TAssert.AssertTrue('PG/' + LMigrations[I].ScriptName,
      LSource.TryGetSql(PG_SQL_DIR, LMigrations[I].ScriptName, LSql));
  end;
  TAssert.AssertTrue('a statement too', LSource.TryGetSql(PG_SQL_DIR, 'HEALTH.PING', LSql));
end;

initialization
  TDUnitX.RegisterTestFixture(TSqlSourcesTests);

end.
