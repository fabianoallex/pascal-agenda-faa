unit Agenda.MoneyTests;

{ Tests for Agenda.Money: Currency to whole cents and back, exact, and the
  refusal of a fraction of a cent.

  DUnitX master. The FPCUnit mirror (tests/Unit/fpc) is generated by
  tools/gen_fpc_mirror.py; never edit the mirror by hand. }

interface

uses
  DUnitX.TestFramework,
  Agenda.DUnitXCompat,
  SysUtils,
  Agenda.Money;

type
  [TestFixture]
  TMoneyTests = class
  public
    [Test] procedure ToCents_Exact;
    [Test] procedure ToCents_RefusesFractionsOfACent;
    [Test] procedure FromCents_Exact;
  end;

implementation

const
  // A typed constant, never Currency(92233720368547): a Currency typecast of
  // an integer reinterprets its bits on FPC 3.2.2 for Linux x86_64 (the
  // value came out 9223372036.8547) and converts on FPC for Windows
  // (measured 2026-10-18; pascal-db-faa's gotcha 18 is the other direction).
  BIG: Currency = 92233720368547;

function Cents(APrice: Currency): Int64;
begin
  if not TryCurrencyToCents(APrice, Result) then
    Result := -999999;
end;

procedure TMoneyTests.ToCents_Exact;
begin
  TAssert.AssertEquals(Int64(0), Cents(0));
  TAssert.AssertEquals(Int64(12550), Cents(125.5));
  TAssert.AssertEquals(Int64(1), Cents(0.01));
  TAssert.AssertEquals(Int64(-250), Cents(-2.5));
  // Large: beyond Double's exact integers in 1/10000 units.
  TAssert.AssertEquals(Int64(9223372036854700), Cents(BIG));
end;

procedure TMoneyTests.ToCents_RefusesFractionsOfACent;
var
  LCents: Int64;
begin
  TAssert.AssertFalse(TryCurrencyToCents(12.345, LCents));
  TAssert.AssertFalse(TryCurrencyToCents(0.0001, LCents));
  TAssert.AssertEquals(Int64(0), LCents);
end;

procedure TMoneyTests.FromCents_Exact;
begin
  TAssert.AssertEquals(Currency(125.5), CentsToCurrency(12550));
  TAssert.AssertEquals(Currency(0.01), CentsToCurrency(1));
  TAssert.AssertEquals(Currency(-2.5), CentsToCurrency(-250));
  TAssert.AssertEquals(BIG, CentsToCurrency(9223372036854700));
end;

initialization
  TDUnitX.RegisterTestFixture(TMoneyTests);

end.
