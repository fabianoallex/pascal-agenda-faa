unit Agenda.TextTests;

{ Tests for Agenda.Text: the search key (case, Latin accents, spaces; the
  same result on both compilers, whose strings differ: UTF-16 on Delphi,
  UTF-8 on FPC) and the LIKE pattern's escapes.

  DUnitX master. The FPCUnit mirror (tests/Unit/fpc) is generated by
  tools/gen_fpc_mirror.py; never edit the mirror by hand. }

interface

uses
  DUnitX.TestFramework,
  Agenda.DUnitXCompat,
  SysUtils,
  Agenda.Text;

type
  [TestFixture]
  TTextTests = class
  public
    [Test] procedure Fold_AsciiCase;
    [Test] procedure Fold_PortugueseAccents;
    [Test] procedure Fold_OtherLatinLetters;
    [Test] procedure Fold_Spaces;
    [Test] procedure Fold_KeepsWhatItDoesntKnow;
    [Test] procedure Like_EscapesWildcards;
    [Test] procedure Phone_DigitsAsTyped;
    [Test] procedure Phone_NotAPhone;
    [Test] procedure Phone_Normalized;
    [Test] procedure Phone_Length;
  end;

implementation

const
  // Typed constants: FPC warns (4104/4105) on a non-ASCII literal in an
  // expression.
  SAO_CONCEICAO: string = 'São Conceição';
  ACCENTS_UPPER: string = 'ÁÀÂÃÄ ÉÊË ÍÏ ÓÔÕÖ ÚÜ Ç Ñ';
  ACCENTS_LOWER: string = 'áàâãä éêë íï óôõö úü ç ñ';
  OTHER_LATIN: string = 'Łódź Šťastný Ørsted Ÿves';
  KEPT: string = 'café ☕ 東京 1-2/3';
  KEPT_FOLDED: string = 'cafe ☕ 東京 1-2/3';

procedure TTextTests.Fold_AsciiCase;
begin
  TAssert.AssertEquals('corte de cabelo', FoldForSearch('Corte DE Cabelo'));
end;

procedure TTextTests.Fold_PortugueseAccents;
begin
  TAssert.AssertEquals('sao conceicao', FoldForSearch(SAO_CONCEICAO));
  TAssert.AssertEquals('aaaaa eee ii oooo uu c n', FoldForSearch(ACCENTS_UPPER));
  TAssert.AssertEquals('aaaaa eee ii oooo uu c n', FoldForSearch(ACCENTS_LOWER));
end;

procedure TTextTests.Fold_OtherLatinLetters;
begin
  TAssert.AssertEquals('lodz stastny orsted yves', FoldForSearch(OTHER_LATIN));
end;

procedure TTextTests.Fold_Spaces;
begin
  TAssert.AssertEquals('a b c', FoldForSearch('  a   b'#9'c  '));
  TAssert.AssertEquals('', FoldForSearch('   '));
  TAssert.AssertEquals('', FoldForSearch(''));
end;

procedure TTextTests.Fold_KeepsWhatItDoesntKnow;
begin
  TAssert.AssertEquals(KEPT_FOLDED, FoldForSearch(KEPT));
end;

procedure TTextTests.Like_EscapesWildcards;
begin
  TAssert.AssertEquals('%corte%', LikeContains('corte'));
  TAssert.AssertEquals('%50\% off%', LikeContains('50% off'));
  TAssert.AssertEquals('%a\_b%', LikeContains('a_b'));
  TAssert.AssertEquals('%c:\\x%', LikeContains('c:\x'));
  TAssert.AssertEquals('%%', LikeContains(''));
end;

procedure TTextTests.Phone_DigitsAsTyped;
var
  LDigits: string;
begin
  TAssert.AssertTrue(TryPhoneDigits(' +55 (11) 9999-0000 ', LDigits));
  TAssert.AssertEquals('551199990000', LDigits);
  TAssert.AssertTrue(TryPhoneDigits('11.9999', LDigits));
  TAssert.AssertEquals('119999', LDigits);
  TAssert.AssertTrue(TryPhoneDigits('7', LDigits));
  TAssert.AssertEquals('7', LDigits);
end;

procedure TTextTests.Phone_NotAPhone;
var
  LDigits: string;
begin
  TAssert.AssertFalse(TryPhoneDigits('ana 99', LDigits));
  TAssert.AssertFalse(TryPhoneDigits('11+99', LDigits));
  TAssert.AssertFalse(TryPhoneDigits('( - )', LDigits));
  TAssert.AssertFalse(TryPhoneDigits('', LDigits));
  TAssert.AssertEquals('', LDigits);
end;

procedure TTextTests.Phone_Normalized;
begin
  TAssert.AssertEquals('+5511999990000', NormalizePhone('+55 (11) 99999-0000'));
  TAssert.AssertEquals('11999990000', NormalizePhone('(11) 99999.0000'));
  TAssert.AssertEquals('', NormalizePhone('call me'));
end;

procedure TTextTests.Phone_Length;
begin
  TAssert.AssertEquals('12345678', NormalizePhone('1234-5678'));
  TAssert.AssertEquals('', NormalizePhone('123-4567'));
  TAssert.AssertEquals('+123456789012345', NormalizePhone('+123456789012345'));
  TAssert.AssertEquals('', NormalizePhone('+1234567890123456'));
end;

initialization
  TDUnitX.RegisterTestFixture(TTextTests);

end.
