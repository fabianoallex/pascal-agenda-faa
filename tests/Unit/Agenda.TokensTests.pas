unit Agenda.TokensTests;

{ Tests for Agenda.Tokens: ids, tenant ids, and refresh tokens (their shape,
  what parsing refuses, the stored hash).

  The hash vector was computed with Python's hashlib.sha256 (2026-10-18).

  DUnitX master. The FPCUnit mirror (tests/Unit/fpc) is generated by
  tools/gen_fpc_mirror.py; never edit the mirror by hand. }

interface

uses
  DUnitX.TestFramework,
  Agenda.DUnitXCompat,
  SysUtils,
  Agenda.Tokens;

type
  [TestFixture]
  TTokensTests = class
  public
    [Test] procedure NewId_32HexDigits;
    [Test] procedure IsTenantId_Rules;
    [Test] procedure NewRefreshToken_ParsesBack;
    [Test] procedure NewRefreshToken_RefusesABadTenant;
    [Test] procedure TryParse_RefusesMalformed;
    [Test] procedure Hash_Sha256Hex;
  end;

implementation

const
  // 43 characters that decode to 32 bytes.
  SECRET = 'AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA';

function IsHex(const AText: string): Boolean;
var
  I: Integer;
begin
  Result := AText <> '';
  for I := 1 to Length(AText) do
    if not CharInSet(AText[I], ['0'..'9', 'a'..'f']) then
      Exit(False);
end;

function Parses(const AToken: string): Boolean;
var
  LTenant: string;
begin
  Result := TryParseRefreshToken(AToken, LTenant);
end;

function NewTokenRaises(const ATenant: string): string;
begin
  Result := '';
  try
    NewRefreshToken(ATenant);
  except
    on E: Exception do
      Result := E.ClassName;
  end;
end;

procedure TTokensTests.NewId_32HexDigits;
var
  LId: string;
begin
  LId := NewId;
  TAssert.AssertEquals(32, Length(LId));
  TAssert.AssertTrue(LId, IsHex(LId));
  TAssert.AssertFalse(NewId = NewId);
end;

procedure TTokensTests.IsTenantId_Rules;
begin
  TAssert.AssertTrue(IsTenantId('demo'));
  TAssert.AssertTrue(IsTenantId('clinic-42'));
  TAssert.AssertTrue(IsTenantId(StringOfChar('a', 40)));
  TAssert.AssertFalse('empty', IsTenantId(''));
  TAssert.AssertFalse('41 chars', IsTenantId(StringOfChar('a', 41)));
  TAssert.AssertFalse('upper case', IsTenantId('Demo'));
  TAssert.AssertFalse('dot', IsTenantId('de.mo'));
  TAssert.AssertFalse('space', IsTenantId('de mo'));
  TAssert.AssertFalse('underscore', IsTenantId('de_mo'));
end;

procedure TTokensTests.NewRefreshToken_ParsesBack;
var
  LToken, LTenant: string;
begin
  LToken := NewRefreshToken('clinic-42');
  TAssert.AssertEquals('clinic-42.', Copy(LToken, 1, 10));
  TAssert.AssertEquals(10 + REFRESH_SECRET_CHARS, Length(LToken));
  TAssert.AssertTrue(TryParseRefreshToken(LToken, LTenant));
  TAssert.AssertEquals('clinic-42', LTenant);
  TAssert.AssertFalse(NewRefreshToken('demo') = NewRefreshToken('demo'));
end;

procedure TTokensTests.NewRefreshToken_RefusesABadTenant;
begin
  TAssert.AssertEquals('EArgumentException', NewTokenRaises(''));
  TAssert.AssertEquals('EArgumentException', NewTokenRaises('a.b'));
end;

procedure TTokensTests.TryParse_RefusesMalformed;
var
  LTenant: string;
begin
  TAssert.AssertTrue('the shape', Parses('demo.' + SECRET));
  TAssert.AssertFalse('empty', Parses(''));
  TAssert.AssertFalse('no dot', Parses('demo' + SECRET));
  TAssert.AssertFalse('no tenant', Parses('.' + SECRET));
  TAssert.AssertFalse('bad tenant', Parses('Demo.' + SECRET));
  TAssert.AssertFalse('short secret', Parses('demo.' + Copy(SECRET, 1, 42)));
  TAssert.AssertFalse('long secret', Parses('demo.' + SECRET + 'A'));
  TAssert.AssertFalse('not Base64url', Parses('demo.' + Copy(SECRET, 1, 42) + '*'));
  TAssert.AssertFalse('a second dot', Parses('demo.' + Copy(SECRET, 1, 42) + '.'));
  TAssert.AssertFalse('a JWT', Parses('eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxIn0.sig'));
  LTenant := 'x';
  TryParseRefreshToken('nothing', LTenant);
  TAssert.AssertEquals('cleared on failure', '', LTenant);
end;

procedure TTokensTests.Hash_Sha256Hex;
begin
  TAssert.AssertEquals('418ea882521fd2883275289f00382e3607af9381118981c1fa0ef0528d564d9f',
    RefreshTokenHash('demo.' + SECRET));
end;

initialization
  TDUnitX.RegisterTestFixture(TTokensTests);

end.
