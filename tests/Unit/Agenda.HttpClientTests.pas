unit Agenda.HttpClientTests;

{ Tests for Agenda.HttpClient on the fake transport: what each request
  carries (Accept, the body's type, If-Match, Idempotency-Key, traceparent,
  the bearer token), the error body read into EApiError, the retries and
  their waits (recorded, not slept), the requests never sent twice, a 401
  answered by renewing the token once, and the client span of each try
  (TSpanRecorder keeps the spans exported; the desktop's tests use it
  too).

  DUnitX master. The FPCUnit mirror (tests/Unit/fpc) is generated by
  tools/gen_fpc_mirror.py; never edit the mirror by hand. }

interface

uses
  DUnitX.TestFramework,
  Agenda.DUnitXCompat,
  SysUtils,
  SyncObjs,
  PascalCommon.Tracing,
  Agenda.HttpTransport,
  Agenda.HttpTransport.Fake,
  Agenda.HttpClient;

type
  /// Credentials for the tests: the token they hold, and what Renew gives.
  TTestCredentials = class(TInterfacedObject, IApiCredentials)
  private
    FToken: string;
    FNext: string;
    FRenewals: Integer;
  public
    constructor Create(const AToken, ANext: string);
    function AccessToken: string;
    function Renew(const AStaleToken: string): Boolean;
    property Renewals: Integer read FRenewals;
  end;

  /// An exporter that keeps the spans (tracing started with AAutoFlush
  /// False: FlushNow hands them over on the caller's thread).
  TSpanRecorder = class(TInterfacedObject, IPcSpanExporter)
  private
    FLock: TCriticalSection;
    FSpans: TPcSpanDataArray;
  public
    constructor Create;
    destructor Destroy; override;
    function ExportSpans(const ASpans: TPcSpanDataArray; out AError: string): Boolean;
    /// In the order they finished.
    function Spans: TPcSpanDataArray;
  end;

  [TestFixture]
  THttpClientTests = class
  private
    FFake: TFakeHttpTransport;
    FTransport: IHttpTransport;
    FClient: TApiHttpClient;
    FRequest: TApiCall;
    FSleeps: string;
    procedure RecordSleep(AMilliseconds: Integer);
    procedure ExecuteRequest;
    function TraceIdOf(const ARequest: TTransportRequest): string;
    function SpanIdOf(const ARequest: TTransportRequest): string;
  public
    [Setup] procedure Setup;
    [TearDown] procedure TearDown;
    [Test] procedure Get_WhatItSends;
    [Test] procedure Post_WhatItSends;
    [Test] procedure Error_BodyRead;
    [Test] procedure Error_NotJson_TheStatusAlone;
    [Test] procedure Get_Retried_SameTrace_BackoffDoubled;
    [Test] procedure Get_GivesUp_AfterTheTries;
    [Test] procedure Get_LastTryLost_IsNoAnswer;
    [Test] procedure RetryAfter_Waited_OrTooLong;
    [Test] procedure Patch_NeverSentTwice;
    [Test] procedure Get_NoRetry_SentOnce;
    [Test] procedure KeyedPost_Retried_SameKey;
    [Test] procedure KeyedPost_OtherConflict_NotRetried;
    [Test] procedure Unauthorized_RenewedOnce;
    [Test] procedure Unauthorized_NotRenewable;
    [Test] procedure Anonymous_NoToken_NoRenewal;
    [Test] procedure RetryAfter_Parsed;
    [Test] procedure Query_Escaped_EmptyLeftOut;
    [Test] procedure Page_Read;
    [Test] procedure Page_NotAPage;
    [Test] procedure Spans_PerTry_UnderTheCurrentSpan;
  end;

/// AKey's value in ASpan, as text ('' when it has none).
function SpanAttribute(const ASpan: TPcSpanData; const AKey: string): string;

/// Tracing started for a test, recording into the result (Shutdown after).
function StartTestTracing: TSpanRecorder;

implementation

{ TSpanRecorder }

constructor TSpanRecorder.Create;
begin
  inherited Create;
  FLock := TCriticalSection.Create;
end;

destructor TSpanRecorder.Destroy;
begin
  FLock.Free;
  inherited;
end;

function TSpanRecorder.ExportSpans(const ASpans: TPcSpanDataArray; out AError: string): Boolean;
var
  I, LCount: Integer;
begin
  AError := '';
  FLock.Acquire;
  try
    LCount := Length(FSpans);
    SetLength(FSpans, LCount + Length(ASpans));
    for I := 0 to High(ASpans) do
      FSpans[LCount + I] := ASpans[I];
  finally
    FLock.Release;
  end;
  Result := True;
end;

function TSpanRecorder.Spans: TPcSpanDataArray;
begin
  FLock.Acquire;
  try
    Result := Copy(FSpans, 0, Length(FSpans));
  finally
    FLock.Release;
  end;
end;

function SpanAttribute(const ASpan: TPcSpanData; const AKey: string): string;
var
  I: Integer;
begin
  Result := '';
  for I := 0 to High(ASpan.Attributes) do
    if ASpan.Attributes[I].Key = AKey then
    begin
      case ASpan.Attributes[I].ValueType of
        satString: Result := ASpan.Attributes[I].StringValue;
        satInt: Result := IntToStr(ASpan.Attributes[I].IntValue);
        satBool: Result := BoolToStr(ASpan.Attributes[I].BoolValue, True);
      else
        Result := FloatToStr(ASpan.Attributes[I].DoubleValue);
      end;
      Exit;
    end;
end;

function StartTestTracing: TSpanRecorder;
var
  LExporter: IPcSpanExporter;
begin
  Result := TSpanRecorder.Create;
  LExporter := Result;
  // The tracing holds the exporter (released at Shutdown); the caller only
  // reads it before that.
  TPcTracing.Start(TPcTracingOptions.Default('agenda-tests', '0'), LExporter, False);
end;

{ TTestCredentials }

constructor TTestCredentials.Create(const AToken, ANext: string);
begin
  inherited Create;
  FToken := AToken;
  FNext := ANext;
end;

function TTestCredentials.AccessToken: string;
begin
  Result := FToken;
end;

function TTestCredentials.Renew(const AStaleToken: string): Boolean;
begin
  Inc(FRenewals);
  Result := FNext <> '';
  if Result then
    FToken := FNext;
end;

{ THttpClientTests }

procedure THttpClientTests.Setup;
begin
  FFake := TFakeHttpTransport.Create;
  FTransport := FFake;
  FClient := TApiHttpClient.Create('http://agenda.test:9400/', FTransport);
  FClient.Sleep := RecordSleep;
  FSleeps := '';
end;

procedure THttpClientTests.TearDown;
begin
  FClient.Free;
  FClient := nil;
  FTransport := nil;
  FFake := nil;
end;

procedure THttpClientTests.RecordSleep(AMilliseconds: Integer);
begin
  if FSleeps <> '' then
    FSleeps := FSleeps + ',';
  FSleeps := FSleeps + IntToStr(AMilliseconds);
end;

procedure THttpClientTests.ExecuteRequest;
begin
  FClient.Execute(FRequest);
end;

// '00-<trace id>-<span id>-01'
function THttpClientTests.TraceIdOf(const ARequest: TTransportRequest): string;
begin
  Result := Copy(ARequest.Header('traceparent'), 4, 32);
end;

function THttpClientTests.SpanIdOf(const ARequest: TTransportRequest): string;
begin
  Result := Copy(ARequest.Header('traceparent'), 37, 16);
end;

procedure THttpClientTests.Get_WhatItSends;
var
  LResponse: TApiReply;
  LSent: TTransportRequest;
begin
  FFake.Answer(200, '{"date":"2026-11-02"}', ['ETag: "5"']);
  LResponse := FClient.Execute(TApiCall.Create('GET', '/agenda/day?date=2026-11-02'));
  TAssert.AssertEquals(200, LResponse.Status);
  TAssert.AssertEquals('{"date":"2026-11-02"}', LResponse.Body);
  TAssert.AssertEquals('"5"', LResponse.ETag);
  LSent := FFake.Request(0);
  TAssert.AssertEquals('GET', LSent.Method);
  TAssert.AssertEquals('http://agenda.test:9400/agenda/day?date=2026-11-02', LSent.Url);
  TAssert.AssertEquals('application/json', LSent.Header('Accept'));
  TAssert.AssertEquals('', LSent.Header('Content-Type'));
  TAssert.AssertEquals('', LSent.Header('Authorization'));
  TAssert.AssertEquals('', LSent.Header('If-Match'));
  TAssert.AssertEquals('', LSent.Header('Idempotency-Key'));
  TAssert.AssertEquals('', LSent.Body);
  TAssert.AssertEquals(55, Length(LSent.Header('traceparent')));
  TAssert.AssertEquals('00-', Copy(LSent.Header('traceparent'), 1, 3));
  TAssert.AssertEquals('-01', Copy(LSent.Header('traceparent'), 53, 3));
  TAssert.AssertEquals(0, LSent.TimeoutMs);
end;

procedure THttpClientTests.Post_WhatItSends;
var
  LSent: TTransportRequest;
  LTrace, LKey: string;
begin
  FClient.Credentials := TTestCredentials.Create('tok', '');
  FClient.TimeoutMs := 4000;
  LTrace := NewTraceId;
  LKey := NewIdempotencyKey;
  TAssert.AssertEquals(32, Length(LKey));
  TAssert.AssertFalse(LKey = NewIdempotencyKey);
  FFake.Answer(201, '{"id":"a1"}');
  FRequest := TApiCall.Create('POST', '/appointments');
  FRequest.Body := '{"serviceId":"s1"}';
  FRequest.IdempotencyKey := LKey;
  FRequest.IfMatch := '"3"';
  FRequest.TraceId := LTrace;
  TAssert.AssertEquals(201, FClient.Execute(FRequest).Status);
  LSent := FFake.Request(0);
  TAssert.AssertEquals('POST', LSent.Method);
  TAssert.AssertEquals('{"serviceId":"s1"}', LSent.Body);
  TAssert.AssertEquals('application/json; charset=utf-8', LSent.Header('Content-Type'));
  TAssert.AssertEquals('Bearer tok', LSent.Header('Authorization'));
  TAssert.AssertEquals('"3"', LSent.Header('If-Match'));
  TAssert.AssertEquals(LKey, LSent.Header('Idempotency-Key'));
  TAssert.AssertEquals(LTrace, TraceIdOf(LSent));
  TAssert.AssertEquals(4000, LSent.TimeoutMs);
end;

procedure THttpClientTests.Error_BodyRead;
begin
  FFake.Answer(400, '{"error":"\"name\" is required.","code":"invalid_fields","fields":[' +
    '{"field":"name","code":"required","message":"\"name\" is required."},' +
    '{"field":"phone","code":"invalid_phone","message":"Not a phone."}]}');
  FRequest := TApiCall.Create('POST', '/customers');
  FRequest.Body := '{"name":""}';
  try
    FClient.Execute(FRequest);
    TAssert.Fail('no EApiError');
  except
    on E: EApiError do
    begin
      TAssert.AssertEquals(400, E.Status);
      TAssert.AssertEquals('invalid_fields', E.Code);
      TAssert.AssertEquals('"name" is required.', E.Message);
      TAssert.AssertEquals(2, Length(E.Fields));
      TAssert.AssertEquals('name', E.Fields[0].Field);
      TAssert.AssertEquals('required', E.Fields[0].Code);
      TAssert.AssertEquals('phone', E.Fields[1].Field);
      TAssert.AssertEquals('Not a phone.', E.Fields[1].Message);
      TAssert.AssertEquals('POST', E.Method);
      TAssert.AssertEquals('/customers', E.Path);
    end;
  end;
  TAssert.AssertEquals(1, FFake.RequestCount);
end;

procedure THttpClientTests.Error_NotJson_TheStatusAlone;
begin
  FFake.Answer(404, '<html>Not Found</html>');
  try
    FClient.Execute(TApiCall.Create('GET', '/nowhere'));
    TAssert.Fail('no EApiError');
  except
    on E: EApiError do
    begin
      TAssert.AssertEquals(404, E.Status);
      TAssert.AssertEquals('', E.Code);
      TAssert.AssertEquals(0, Length(E.Fields));
      TAssert.AssertEquals('GET /nowhere answered 404', E.Message);
      TAssert.AssertEquals('<html>Not Found</html>', E.Body);
    end;
  end;
end;

procedure THttpClientTests.Get_Retried_SameTrace_BackoffDoubled;
var
  LRequests: TArray<TTransportRequest>;
begin
  FFake.Fail;
  FFake.Answer(502, '');
  FFake.Answer(200, '[]');
  TAssert.AssertEquals('[]', FClient.Execute(TApiCall.Create('GET', '/customers')).Body);
  TAssert.AssertEquals('300,600', FSleeps);
  LRequests := FFake.Requests;
  TAssert.AssertEquals(3, Length(LRequests));
  TAssert.AssertEquals(TraceIdOf(LRequests[0]), TraceIdOf(LRequests[1]));
  TAssert.AssertEquals(TraceIdOf(LRequests[0]), TraceIdOf(LRequests[2]));
  TAssert.AssertFalse(SpanIdOf(LRequests[0]) = SpanIdOf(LRequests[1]));
  TAssert.AssertFalse(SpanIdOf(LRequests[1]) = SpanIdOf(LRequests[2]));
end;

procedure THttpClientTests.Get_GivesUp_AfterTheTries;
begin
  FFake.Answer(503, '');
  FFake.Answer(504, '');
  FFake.Answer(503, '{"error":"busy","code":"busy"}');
  FFake.Answer(200, '');
  FRequest := TApiCall.Create('GET', '/customers');
  try
    FClient.Execute(FRequest);
    TAssert.Fail('no EApiError');
  except
    on E: EApiError do
    begin
      TAssert.AssertEquals(503, E.Status);
      TAssert.AssertEquals('busy', E.Code);
    end;
  end;
  TAssert.AssertEquals(3, FFake.RequestCount);
  TAssert.AssertEquals(1, FFake.Pending);
  TAssert.AssertEquals('300,600', FSleeps);
end;

procedure THttpClientTests.Get_LastTryLost_IsNoAnswer;
begin
  FFake.Fail;
  FFake.Fail;
  FFake.Fail;
  FRequest := TApiCall.Create('GET', '/customers');
  TAssert.AssertException(EHttpTransport, ExecuteRequest);
  TAssert.AssertEquals(3, FFake.RequestCount);
end;

procedure THttpClientTests.RetryAfter_Waited_OrTooLong;
begin
  FFake.Answer(429, '', ['Retry-After: 2']);
  FFake.Answer(200, '');
  FClient.Execute(TApiCall.Create('GET', '/customers'));
  TAssert.AssertEquals('2000', FSleeps);

  // Longer than MaxRetryAfterMs (10 s): the caller hears of it at once.
  FSleeps := '';
  FFake.Answer(503, '', ['Retry-After: 60']);
  FRequest := TApiCall.Create('GET', '/customers');
  TAssert.AssertException(EApiError, ExecuteRequest);
  TAssert.AssertEquals('', FSleeps);
  TAssert.AssertEquals(3, FFake.RequestCount);
end;

procedure THttpClientTests.Patch_NeverSentTwice;
begin
  FFake.Fail;
  FRequest := TApiCall.Create('PATCH', '/appointments/a1');
  FRequest.Body := '{"startsAt":"2026-11-02T13:00:00Z"}';
  FRequest.IfMatch := '"2"';
  TAssert.AssertException(EHttpTransport, ExecuteRequest);
  TAssert.AssertEquals(1, FFake.RequestCount);

  FFake.Answer(503, '');
  FRequest := TApiCall.Create('POST', '/appointments/a1/cancel');
  TAssert.AssertException(EApiError, ExecuteRequest);
  TAssert.AssertEquals(2, FFake.RequestCount);
  TAssert.AssertEquals('', FSleeps);
end;

procedure THttpClientTests.Get_NoRetry_SentOnce;
begin
  FFake.Answer(503, '');
  FRequest := TApiCall.Create('GET', '/health/ready');
  FRequest.NoRetry := True;
  TAssert.AssertException(EApiError, ExecuteRequest);
  TAssert.AssertEquals(1, FFake.RequestCount);
end;

procedure THttpClientTests.KeyedPost_Retried_SameKey;
var
  LRequests: TArray<TTransportRequest>;
begin
  FFake.Fail;
  FFake.Answer(409, '{"error":"running","code":"idempotency_key_in_flight"}');
  FFake.Answer(201, '{"id":"a1"}');
  FRequest := TApiCall.Create('POST', '/appointments');
  FRequest.Body := '{"serviceId":"s1"}';
  FRequest.IdempotencyKey := 'k-1';
  TAssert.AssertEquals(201, FClient.Execute(FRequest).Status);
  LRequests := FFake.Requests;
  TAssert.AssertEquals(3, Length(LRequests));
  TAssert.AssertEquals('k-1', LRequests[0].Header('Idempotency-Key'));
  TAssert.AssertEquals('k-1', LRequests[1].Header('Idempotency-Key'));
  TAssert.AssertEquals('k-1', LRequests[2].Header('Idempotency-Key'));
  TAssert.AssertEquals(LRequests[0].Body, LRequests[2].Body);
  TAssert.AssertEquals('300,600', FSleeps);
end;

procedure THttpClientTests.KeyedPost_OtherConflict_NotRetried;
begin
  FFake.Answer(409, '{"error":"taken","code":"slot_unavailable"}');
  FRequest := TApiCall.Create('POST', '/appointments');
  FRequest.IdempotencyKey := 'k-2';
  try
    FClient.Execute(FRequest);
    TAssert.Fail('no EApiError');
  except
    on E: EApiError do
      TAssert.AssertEquals('slot_unavailable', E.Code);
  end;
  TAssert.AssertEquals(1, FFake.RequestCount);
end;

procedure THttpClientTests.Unauthorized_RenewedOnce;
var
  LCredentials: TTestCredentials;
  LKeep: IApiCredentials;
  LRequests: TArray<TTransportRequest>;
begin
  LCredentials := TTestCredentials.Create('old', 'new');
  LKeep := LCredentials;
  FClient.Credentials := LKeep;
  FFake.Answer(401, '{"error":"expired","code":"invalid_token"}');
  FFake.Answer(200, '{}');
  TAssert.AssertEquals(200, FClient.Execute(TApiCall.Create('GET', '/me')).Status);
  LRequests := FFake.Requests;
  TAssert.AssertEquals(2, Length(LRequests));
  TAssert.AssertEquals('Bearer old', LRequests[0].Header('Authorization'));
  TAssert.AssertEquals('Bearer new', LRequests[1].Header('Authorization'));
  TAssert.AssertEquals(TraceIdOf(LRequests[0]), TraceIdOf(LRequests[1]));
  TAssert.AssertEquals(1, LCredentials.Renewals);
  TAssert.AssertEquals('', FSleeps);

  // A second 401 for the new token: given up, renewed only once.
  FFake.Answer(401, '');
  FFake.Answer(401, '');
  FRequest := TApiCall.Create('GET', '/me');
  TAssert.AssertException(EApiError, ExecuteRequest);
  TAssert.AssertEquals(4, FFake.RequestCount);
  TAssert.AssertEquals(2, LCredentials.Renewals);
  FClient.Credentials := nil;
end;

procedure THttpClientTests.Unauthorized_NotRenewable;
var
  LCredentials: TTestCredentials;
  LKeep: IApiCredentials;
begin
  LCredentials := TTestCredentials.Create('old', '');
  LKeep := LCredentials;
  FClient.Credentials := LKeep;
  FFake.Answer(401, '');
  FRequest := TApiCall.Create('GET', '/me');
  try
    FClient.Execute(FRequest);
    TAssert.Fail('no EApiError');
  except
    on E: EApiError do
      TAssert.AssertEquals(401, E.Status);
  end;
  TAssert.AssertEquals(1, FFake.RequestCount);
  TAssert.AssertEquals(1, LCredentials.Renewals);
  FClient.Credentials := nil;
end;

procedure THttpClientTests.Anonymous_NoToken_NoRenewal;
var
  LCredentials: TTestCredentials;
  LKeep: IApiCredentials;
begin
  LCredentials := TTestCredentials.Create('tok', 'new');
  LKeep := LCredentials;
  FClient.Credentials := LKeep;
  FFake.Answer(401, '{"error":"Invalid email or password.","code":"invalid_credentials"}');
  FRequest := TApiCall.Create('POST', '/auth/login');
  FRequest.Body := '{"email":"a@b.test"}';
  FRequest.Anonymous := True;
  try
    FClient.Execute(FRequest);
    TAssert.Fail('no EApiError');
  except
    on E: EApiError do
      TAssert.AssertEquals('invalid_credentials', E.Code);
  end;
  TAssert.AssertEquals('', FFake.Request(0).Header('Authorization'));
  TAssert.AssertEquals(0, LCredentials.Renewals);
  FClient.Credentials := nil;
end;

procedure THttpClientTests.RetryAfter_Parsed;
var
  LMs: Integer;
begin
  TAssert.AssertTrue(TryRetryAfterMs('5', LMs));
  TAssert.AssertEquals(5000, LMs);
  TAssert.AssertTrue(TryRetryAfterMs(' 0 ', LMs));
  TAssert.AssertEquals(0, LMs);
  TAssert.AssertTrue(TryRetryAfterMs('999999999', LMs));
  TAssert.AssertEquals(High(Integer), LMs);
  TAssert.AssertFalse(TryRetryAfterMs('Wed, 21 Oct 2026 07:28:00 GMT', LMs));
  TAssert.AssertFalse(TryRetryAfterMs('-1', LMs));
  TAssert.AssertFalse(TryRetryAfterMs('', LMs));
  TAssert.AssertFalse(TryRetryAfterMs('1.5', LMs));
end;

procedure THttpClientTests.Query_Escaped_EmptyLeftOut;
begin
  // Names and values percent-encoded (pascal-common-faa's PcPercentEncode).
  TAssert.AssertEquals('?search=Jo%C3%A3o%20b%26c', ApiQuery(['search', 'João b&c']));
  TAssert.AssertEquals('?date=2026-11-02&days=3', ApiQuery(['date', '2026-11-02',
    'professional', '', 'days', '3']));
  TAssert.AssertEquals('', ApiQuery(['search', '']));
  TAssert.AssertEquals('', ApiQuery([]));
end;

procedure THttpClientTests.Page_Read;
var
  LInfo: TApiPageInfo;
begin
  TAssert.AssertEquals('[{"id":"c1"},{"id":"c2"}]', ReadApiPage(
    '{"page":1,"limit":2,"total":3,"totalPages":2,"hasNext":true,"hasPrev":false,' +
    '"items":[{"id":"c1"},{"id":"c2"}]}', LInfo));
  TAssert.AssertEquals(1, LInfo.Page);
  TAssert.AssertEquals(2, LInfo.Limit);
  TAssert.AssertEquals(Int64(3), LInfo.Total);
  TAssert.AssertEquals(Int64(2), LInfo.TotalPages);
  TAssert.AssertTrue(LInfo.HasNext);
  TAssert.AssertFalse(LInfo.HasPrev);
  TAssert.AssertEquals('[]', ReadApiPage('{"page":1,"limit":20,"total":0,"totalPages":1,' +
    '"hasNext":false,"hasPrev":false,"items":[]}', LInfo));
end;

procedure THttpClientTests.Page_NotAPage;
var
  LInfo: TApiPageInfo;
  LBody: string;
  I: Integer;
begin
  for I := 0 to 3 do
  begin
    case I of
      0: LBody := '[]';
      1: LBody := '{"page":1,"limit":2,"total":3,"totalPages":2}';
      2: LBody := '{"page":"1","limit":2,"total":3,"totalPages":2,"items":[]}';
    else
      LBody := '<html>';
    end;
    try
      ReadApiPage(LBody, LInfo);
      TAssert.Fail('no EApiPageFormat for ' + LBody);
    except
      on EApiPageFormat do ;
    end;
  end;
end;



// A span current on the thread (a desktop task's run span): each try is a
// client span under it, and its traceparent is the one sent.
procedure THttpClientTests.Spans_PerTry_UnderTheCurrentSpan;
var
  LRecorder: TSpanRecorder;
  LAction: IPcSpan;
  LSpans: TPcSpanDataArray;
  LRequests: TArray<TTransportRequest>;
  I: Integer;
begin
  LRecorder := StartTestTracing;
  try
    FFake.Answer(503, '');
    FFake.Answer(200, '[]');
    LAction := TPcTracing.StartSpan('action');
    try
      FClient.Execute(TApiCall.Create('GET', '/customers?search=bia'));
    finally
      LAction.Finish;
    end;
    TAssert.AssertTrue(TPcTracing.Current = nil);
    TPcTracing.FlushNow;
    LSpans := LRecorder.Spans;
    LRequests := FFake.Requests;
    TAssert.AssertEquals(3, Length(LSpans));
    TAssert.AssertEquals(2, Length(LRequests));
    for I := 0 to 1 do
    begin
      TAssert.AssertEquals('GET', LSpans[I].Name);
      TAssert.AssertTrue(LSpans[I].Kind = skClient);
      TAssert.AssertEquals(LAction.TraceId, LSpans[I].TraceId);
      TAssert.AssertEquals(LAction.SpanId, LSpans[I].ParentSpanId);
      TAssert.AssertEquals(LAction.TraceId, TraceIdOf(LRequests[I]));
      TAssert.AssertEquals(LSpans[I].SpanId, SpanIdOf(LRequests[I]));
      TAssert.AssertEquals('GET', SpanAttribute(LSpans[I], 'http.request.method'));
      TAssert.AssertEquals('/customers', SpanAttribute(LSpans[I], 'url.path'));
    end;
    TAssert.AssertEquals('503', SpanAttribute(LSpans[0], 'http.response.status_code'));
    TAssert.AssertTrue(LSpans[0].Status = ssError);
    TAssert.AssertEquals('', SpanAttribute(LSpans[0], 'http.request.resend_count'));
    TAssert.AssertEquals('200', SpanAttribute(LSpans[1], 'http.response.status_code'));
    TAssert.AssertTrue(LSpans[1].Status = ssUnset);
    TAssert.AssertEquals('1', SpanAttribute(LSpans[1], 'http.request.resend_count'));
    TAssert.AssertEquals('action', LSpans[2].Name);
  finally
    LAction := nil;
    TPcTracing.Shutdown;
  end;
end;

initialization
  TDUnitX.RegisterTestFixture(THttpClientTests);
end.
