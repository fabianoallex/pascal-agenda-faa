unit Agenda.HttpSessionTests;

{ Tests for Agenda.HttpSession: renewed before the token runs out (on a
  clock the test moves), one refresh for several threads refused at once,
  a refused refresh ending the session, a lost connection keeping the old
  token when renewing early, and the session under TApiHttpClient (a 401,
  one refresh, the request again with the new token).

  DUnitX master. The FPCUnit mirror (tests/Unit/fpc) is generated by
  tools/gen_fpc_mirror.py; never edit the mirror by hand. }

interface

uses
  DUnitX.TestFramework,
  Agenda.DUnitXCompat,
  SysUtils,
  Classes,
  SyncObjs,
  Agenda.HttpTransport,
  Agenda.HttpTransport.Fake,
  Agenda.HttpClient,
  Agenda.HttpSession;

type
  TRefreshOutcome = (roOk, roRefused, roNoAnswer, roBusy);

  /// Gives 'acc<n>'/'ref<n>' on the n-th refresh, after DelayMs.
  TTestRefresher = class(TInterfacedObject, IApiTokenRefresher)
  private
    FLock: TCriticalSection;
    FCalls: Integer;
    FReceived: string;
    FOutcome: TRefreshOutcome;
    FDelayMs: Integer;
    FExpiresIn: Int64;
  public
    constructor Create;
    destructor Destroy; override;
    function Refresh(const ARefreshToken: string): TApiTokens;
    function Calls: Integer;
    /// The refresh tokens received, comma-separated.
    function Received: string;
    property Outcome: TRefreshOutcome read FOutcome write FOutcome;
    property DelayMs: Integer read FDelayMs write FDelayMs;
    property ExpiresIn: Int64 read FExpiresIn write FExpiresIn;
  end;

  TRenewThread = class(TThread)
  private
    FCredentials: IApiCredentials;
    FStale: string;
    FRenewed: Boolean;
    FToken: string;
  protected
    procedure Execute; override;
  public
    constructor Create(const ACredentials: IApiCredentials; const AStale: string);
    property Renewed: Boolean read FRenewed;
    property Token: string read FToken;
  end;

  [TestFixture]
  THttpSessionTests = class
  private
    FNow: Int64;
    FRefresher: TTestRefresher;
    FRefresherRef: IApiTokenRefresher;
    FSession: TApiSession;
    FSessionRef: IApiCredentials;
    function TestClock: Int64;
    procedure StartWith(AExpiresIn: Int64);
    procedure RenewAcc0;
  public
    [Setup] procedure Setup;
    [TearDown] procedure TearDown;
    [Test] procedure Early_RenewedAtTheMargin;
    [Test] procedure Early_ShortLife_QuarterMargin;
    [Test] procedure Renew_OnlyTheStaleToken;
    [Test] procedure Renew_ManyThreads_OneRefresh;
    [Test] procedure Refused_SessionLost;
    [Test] procedure Early_NoAnswer_KeepsTheOldToken;
    [Test] procedure Early_Busy_KeepsTheOldToken;
    [Test] procedure Cleared_NothingToRenew;
    [Test] procedure UnderTheClient_401_OneRefresh;
  end;

implementation

{ TTestRefresher }

constructor TTestRefresher.Create;
begin
  inherited Create;
  FLock := TCriticalSection.Create;
  FExpiresIn := 900;
end;

destructor TTestRefresher.Destroy;
begin
  FLock.Free;
  inherited;
end;

function TTestRefresher.Refresh(const ARefreshToken: string): TApiTokens;
var
  N: Integer;
  LResponse: TApiReply;
begin
  FLock.Acquire;
  try
    Inc(FCalls);
    N := FCalls;
    if FReceived <> '' then
      FReceived := FReceived + ',';
    FReceived := FReceived + ARefreshToken;
  finally
    FLock.Release;
  end;
  if FDelayMs > 0 then
    Sleep(FDelayMs);
  case FOutcome of
    roRefused, roBusy:
      begin
        if FOutcome = roRefused then
          LResponse.Status := 401
        else
          LResponse.Status := 429;
        LResponse.Body := '{"error":"no","code":"invalid_refresh_token"}';
        LResponse.Headers := nil;
        raise EApiError.CreateFromResponse(TApiCall.Create('POST', '/auth/refresh'), LResponse);
      end;
    roNoAnswer:
      raise EHttpTransport.Create('connection refused');
  end;
  Result.AccessToken := 'acc' + IntToStr(N);
  Result.RefreshToken := 'ref' + IntToStr(N);
  Result.ExpiresInSeconds := FExpiresIn;
end;

function TTestRefresher.Calls: Integer;
begin
  FLock.Acquire;
  try
    Result := FCalls;
  finally
    FLock.Release;
  end;
end;

function TTestRefresher.Received: string;
begin
  FLock.Acquire;
  try
    Result := FReceived;
  finally
    FLock.Release;
  end;
end;

{ TRenewThread }

constructor TRenewThread.Create(const ACredentials: IApiCredentials; const AStale: string);
begin
  FCredentials := ACredentials;
  FStale := AStale;
  inherited Create(False);
end;

procedure TRenewThread.Execute;
begin
  FRenewed := FCredentials.Renew(FStale);
  FToken := FCredentials.AccessToken;
end;

{ THttpSessionTests }

procedure THttpSessionTests.Setup;
begin
  FNow := 1000;
  FRefresher := TTestRefresher.Create;
  FRefresherRef := FRefresher;
  FSession := TApiSession.Create(FRefresherRef);
  FSessionRef := FSession;
  FSession.Clock := TestClock;
end;

procedure THttpSessionTests.TearDown;
begin
  FSessionRef := nil;
  FSession := nil;
  FRefresherRef := nil;
  FRefresher := nil;
end;

function THttpSessionTests.TestClock: Int64;
begin
  Result := FNow;
end;

procedure THttpSessionTests.StartWith(AExpiresIn: Int64);
var
  LTokens: TApiTokens;
begin
  LTokens.AccessToken := 'acc0';
  LTokens.RefreshToken := 'ref0';
  LTokens.ExpiresInSeconds := AExpiresIn;
  FSession.Start(LTokens);
end;

procedure THttpSessionTests.RenewAcc0;
begin
  FSession.Renew('acc0');
end;

procedure THttpSessionTests.Early_RenewedAtTheMargin;
begin
  StartWith(900);
  // 900 s of life, renewed when 60 s are left: at 840 s.
  FNow := 1000 + 840000 - 1;
  TAssert.AssertEquals('acc0', FSession.AccessToken);
  TAssert.AssertEquals(0, FRefresher.Calls);
  FNow := 1000 + 840000;
  TAssert.AssertEquals('acc1', FSession.AccessToken);
  TAssert.AssertEquals(1, FRefresher.Calls);
  TAssert.AssertEquals('ref0', FRefresher.Received);
  TAssert.AssertEquals('ref1', FSession.RefreshToken);
  // The new token's own 900 s count from now.
  FNow := FNow + 839999;
  TAssert.AssertEquals('acc1', FSession.AccessToken);
  TAssert.AssertEquals(1, FSession.Refreshes);
end;

procedure THttpSessionTests.Early_ShortLife_QuarterMargin;
begin
  // 8 s of life: a quarter (2 s) is shorter than the margin.
  StartWith(8);
  FNow := 1000 + 5999;
  TAssert.AssertEquals('acc0', FSession.AccessToken);
  FNow := 1000 + 6000;
  TAssert.AssertEquals('acc1', FSession.AccessToken);
  TAssert.AssertEquals(1, FRefresher.Calls);
end;

procedure THttpSessionTests.Renew_OnlyTheStaleToken;
begin
  StartWith(900);
  TAssert.AssertTrue(FSession.Renew('acc0'));
  TAssert.AssertEquals('acc1', FSession.AccessToken);
  // Refused with acc0 again (a request sent before): acc1 is already newer.
  TAssert.AssertTrue(FSession.Renew('acc0'));
  TAssert.AssertEquals(1, FRefresher.Calls);
  TAssert.AssertTrue(FSession.Renew('acc1'));
  TAssert.AssertEquals('acc2', FSession.AccessToken);
  TAssert.AssertEquals('ref0,ref1', FRefresher.Received);
end;

procedure THttpSessionTests.Renew_ManyThreads_OneRefresh;
var
  LThreads: array[0..3] of TRenewThread;
  I: Integer;
begin
  StartWith(900);
  FRefresher.DelayMs := 150;
  for I := 0 to High(LThreads) do
    LThreads[I] := TRenewThread.Create(FSessionRef, 'acc0');
  for I := 0 to High(LThreads) do
  begin
    LThreads[I].WaitFor;
    TAssert.AssertTrue(LThreads[I].Renewed);
    TAssert.AssertEquals('acc1', LThreads[I].Token);
    LThreads[I].Free;
  end;
  TAssert.AssertEquals(1, FRefresher.Calls);
  TAssert.AssertEquals('ref0', FRefresher.Received);
end;

procedure THttpSessionTests.Refused_SessionLost;
begin
  StartWith(900);
  FRefresher.Outcome := roRefused;
  TAssert.AssertFalse(FSession.Renew('acc0'));
  TAssert.AssertTrue(FSession.Lost);
  TAssert.AssertEquals('', FSession.AccessToken);
  TAssert.AssertEquals('', FSession.RefreshToken);
  // Nothing left to refresh with.
  TAssert.AssertFalse(FSession.Renew('acc0'));
  TAssert.AssertEquals(1, FRefresher.Calls);
  // A new login.
  StartWith(900);
  TAssert.AssertFalse(FSession.Lost);
  TAssert.AssertEquals('acc0', FSession.AccessToken);
end;

procedure THttpSessionTests.Early_NoAnswer_KeepsTheOldToken;
begin
  StartWith(900);
  FRefresher.Outcome := roNoAnswer;
  FNow := 1000 + 840000;
  TAssert.AssertEquals('acc0', FSession.AccessToken);
  TAssert.AssertEquals(1, FRefresher.Calls);
  TAssert.AssertFalse(FSession.Lost);
  // After a 401 the request would fail anyway: the caller hears of it.
  TAssert.AssertException(EHttpTransport, RenewAcc0);
  // The server back: the next call renews.
  FRefresher.Outcome := roOk;
  TAssert.AssertEquals('acc3', FSession.AccessToken);
end;

procedure THttpSessionTests.Early_Busy_KeepsTheOldToken;
begin
  StartWith(900);
  FRefresher.Outcome := roBusy;
  FNow := 1000 + 840000;
  TAssert.AssertEquals('acc0', FSession.AccessToken);
  TAssert.AssertFalse(FSession.Lost);
  TAssert.AssertException(EApiError, RenewAcc0);
  TAssert.AssertFalse(FSession.Lost);
end;

procedure THttpSessionTests.Cleared_NothingToRenew;
begin
  StartWith(900);
  FSession.Clear;
  TAssert.AssertEquals('', FSession.AccessToken);
  TAssert.AssertFalse(FSession.Renew('acc0'));
  TAssert.AssertEquals(0, FRefresher.Calls);
  TAssert.AssertFalse(FSession.Lost);
end;

procedure THttpSessionTests.UnderTheClient_401_OneRefresh;
var
  LFake: TFakeHttpTransport;
  LTransport: IHttpTransport;
  LClient: TApiHttpClient;
begin
  StartWith(900);
  LFake := TFakeHttpTransport.Create;
  LTransport := LFake;
  LClient := TApiHttpClient.Create('http://agenda.test', LTransport);
  try
    LClient.Credentials := FSessionRef;
    LFake.Answer(401, '{"error":"Token expired.","code":"invalid_token"}');
    LFake.Answer(200, '{"id":"u1"}');
    TAssert.AssertEquals('{"id":"u1"}', LClient.Execute(TApiCall.Create('GET', '/me')).Body);
    TAssert.AssertEquals('Bearer acc0', LFake.Request(0).Header('Authorization'));
    TAssert.AssertEquals('Bearer acc1', LFake.Request(1).Header('Authorization'));
    TAssert.AssertEquals(1, FRefresher.Calls);
  finally
    LClient.Free;
  end;
end;

initialization
  TDUnitX.RegisterTestFixture(THttpSessionTests);

end.
