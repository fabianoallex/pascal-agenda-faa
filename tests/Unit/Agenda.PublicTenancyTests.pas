unit Agenda.PublicTenancyTests;

{ Tests for Agenda.PublicTenancy: the slug of a public path, the prefix by
  whole segments, and one answer for every tenant that can't be used, on
  pascal-api-infra-faa's configuration catalog.

  DUnitX master. The FPCUnit mirror (tests/Unit/fpc) is generated by
  tools/gen_fpc_mirror.py; never edit the mirror by hand. }

interface

uses
  DUnitX.TestFramework,
  Agenda.DUnitXCompat,
  SysUtils,
  PascalApi.Tenancy,
  Agenda.PublicTenancy;

type
  [TestFixture]
  TPublicTenancyTests = class
  public
    [Test] procedure TryPathTenant_TheSegmentAfterThePrefix;
    [Test] procedure TryPathTenant_NotUnderThePrefix;
    [Test] procedure TryPathTenant_TextThatCannotBeAnId;
    [Test] procedure IsUnderPathPrefix_WholeSegments;
    [Test] procedure Resolve_AUsableTenant;
    [Test] procedure Resolve_OneAnswerForEveryOtherCase;
  end;

implementation

function Slug(const APath: string): string;
begin
  if not TryPathTenant(APath, PUBLIC_PATH_PREFIX, Result) then
    Result := '(none)';
end;

function NewCatalog: ITenantCatalog;
begin
  Result := TConfigTenantCatalog.Create('demo=shared;frozen=shared,suspended;big=dedicated,plan:gold');
end;

procedure TPublicTenancyTests.TryPathTenant_TheSegmentAfterThePrefix;
begin
  TAssert.AssertEquals('demo', Slug('/public/demo/services'));
  TAssert.AssertEquals('demo', Slug('/public/demo'));
  TAssert.AssertEquals('demo', Slug('/public/demo/'));
  TAssert.AssertEquals('a-1', Slug('/public/a-1/appointments/x/cancel'));
  TAssert.AssertEquals('40 characters', StringOfChar('a', 40), Slug('/public/' + StringOfChar('a', 40)));
end;

procedure TPublicTenancyTests.TryPathTenant_NotUnderThePrefix;
begin
  TAssert.AssertEquals('(none)', Slug('/services'));
  TAssert.AssertEquals('(none)', Slug('/public'));
  TAssert.AssertEquals('(none)', Slug('/public/'));
  TAssert.AssertEquals('(none)', Slug('/publicity/demo'));
  TAssert.AssertEquals('(none)', Slug('/Public/demo'));
  TAssert.AssertEquals('(none)', Slug('/x/public/demo'));
  TAssert.AssertEquals('(none)', Slug(''));
end;

procedure TPublicTenancyTests.TryPathTenant_TextThatCannotBeAnId;
begin
  TAssert.AssertEquals('upper case', '(none)', Slug('/public/Demo/services'));
  TAssert.AssertEquals('41 characters', '(none)', Slug('/public/' + StringOfChar('a', 41)));
  TAssert.AssertEquals('a dot', '(none)', Slug('/public/de.mo'));
  TAssert.AssertEquals('percent', '(none)', Slug('/public/de%2Fmo'));
  TAssert.AssertEquals('empty segment', '(none)', Slug('/public//services'));
  TAssert.AssertEquals('a space', '(none)', Slug('/public/de mo'));
end;

procedure TPublicTenancyTests.IsUnderPathPrefix_WholeSegments;
begin
  TAssert.AssertTrue(IsUnderPathPrefix('/public', PUBLIC_PATH_PREFIX));
  TAssert.AssertTrue(IsUnderPathPrefix('/public/', PUBLIC_PATH_PREFIX));
  TAssert.AssertTrue(IsUnderPathPrefix('/public/demo/services', PUBLIC_PATH_PREFIX));
  TAssert.AssertFalse(IsUnderPathPrefix('/publicity', PUBLIC_PATH_PREFIX));
  TAssert.AssertFalse(IsUnderPathPrefix('/pub', PUBLIC_PATH_PREFIX));
  TAssert.AssertFalse(IsUnderPathPrefix('/services', PUBLIC_PATH_PREFIX));
  TAssert.AssertFalse(IsUnderPathPrefix('/public/x', ''));
end;

procedure TPublicTenancyTests.Resolve_AUsableTenant;
var
  LInfo: TTenantInfo;
begin
  TAssert.AssertTrue(ResolvePathTenant(NewCatalog, '/public/demo/services', PUBLIC_PATH_PREFIX, LInfo));
  TAssert.AssertEquals('demo', LInfo.Id);
  TAssert.AssertTrue(ResolvePathTenant(NewCatalog, '/public/big', PUBLIC_PATH_PREFIX, LInfo));
  TAssert.AssertEquals('big', LInfo.Id);
  TAssert.AssertEquals('gold', LInfo.Plan);
end;

procedure TPublicTenancyTests.Resolve_OneAnswerForEveryOtherCase;
var
  LInfo: TTenantInfo;
begin
  TAssert.AssertFalse('unknown', ResolvePathTenant(NewCatalog, '/public/nowhere/services',
    PUBLIC_PATH_PREFIX, LInfo));
  TAssert.AssertEquals('unknown: no tenant', '', LInfo.Id);
  TAssert.AssertFalse('suspended', ResolvePathTenant(NewCatalog, '/public/frozen/services',
    PUBLIC_PATH_PREFIX, LInfo));
  TAssert.AssertEquals('suspended: no tenant', '', LInfo.Id);
  TAssert.AssertFalse('suspended: not marked', LInfo.Suspended);
  TAssert.AssertFalse('not an id', ResolvePathTenant(NewCatalog, '/public/DEMO/services',
    PUBLIC_PATH_PREFIX, LInfo));
  TAssert.AssertFalse('not public', ResolvePathTenant(NewCatalog, '/services',
    PUBLIC_PATH_PREFIX, LInfo));
  TAssert.AssertFalse('no catalog', ResolvePathTenant(nil, '/public/demo', PUBLIC_PATH_PREFIX, LInfo));
end;

initialization
  TDUnitX.RegisterTestFixture(TPublicTenancyTests);

end.
