{ Tests for Agenda.SignedLinks: the signature against vectors computed with
  Python's hmac and hashlib (2026-10-21), the keys' setting, rotation, and
  every way a client's link can be wrong.

  DUnitX master. The FPCUnit mirror (tests/Unit/fpc) is generated by
  tools/gen_fpc_mirror.py; never edit the mirror by hand. }

interface

uses
  fpcunit, testregistry,
  SysUtils,
  Agenda.SignedLinks;

type
  TSignedLinksTests = class(TTestCase)
  published
    procedure Sign_MatchesTheReferenceVectors;
    procedure Sign_NonAsciiScopeIsUtf8;
    procedure Keys_StandardBase64AndBase64Url;
    procedure Keys_RefusedSettings;
    procedure Verify_Ok;
    procedure Verify_EveryPartIsSigned;
    procedure Verify_ExpiredOnlyWithAGoodSignature;
    procedure Verify_MalformedSignatures;
    procedure Verify_RotatedKeys;
    procedure Verify_TenantsKeysDiffer;
    procedure Sign_RefusesWhatCannotBeSigned;
    procedure Query_ExpAndSig;
    procedure TryParseLinkExpiry_DigitsOnly;
  end;

implementation

const
  // Bytes 0..31 and 32..63, in standard Base64.
  K1 = 'k1:AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=';
  K2 = 'k2:ICEiIyQlJicoKSorLC0uLzAxMjM0NTY3ODk6Ozw9Pj8=';
  // HMAC(HMAC(key, "agenda-link-key|demo"),
  //   "agenda-link|v1|demo|appointment|0123abc|1800000000"), Base64url.
  SIG_K1 = 'k1.TUXdgfsaVcEBEqd5y9gtxFIfVZxwPDBs13U3RR2WJyg';
  SIG_K2 = 'k2.Bzum_G8irTFY4ADtLhMubwXRsmZ6sOpXz1EgJeYVwbY';
  EXP = 1800000000;
  // Typed constant: FPC warns (4104/4105) on a non-ASCII literal in an
  // expression.
  SAO: string = 'são';

function CheckName(ACheck: TSignedLinkCheck): string;
begin
  case ACheck of
    lsOk: Result := 'ok';
    lsMalformed: Result := 'malformed';
    lsUnknownKey: Result := 'unknown key';
    lsBadSignature: Result := 'bad signature';
    lsExpired: Result := 'expired';
  else
    Result := '?';
  end;
end;

// The exception class name, or '' when nothing was raised (no closures on FPC).
function CreateRaises(const AKeys: string): string;
var
  LLinks: TSignedLinks;
begin
  Result := '';
  try
    LLinks := TSignedLinks.Create(AKeys);
    LLinks.Free;
  except
    on E: Exception do
      Result := E.ClassName;
  end;
end;

function SignRaises(ALinks: TSignedLinks; const AScope, APurpose, AResource: string;
  AExpires: Int64): string;
begin
  Result := '';
  try
    ALinks.Sign(AScope, APurpose, AResource, AExpires);
  except
    on E: Exception do
      Result := E.ClassName;
  end;
end;

function VerifyDemo(ALinks: TSignedLinks; const ASignature: string; ANow: Int64): string;
begin
  Result := CheckName(ALinks.Verify('demo', 'appointment', '0123abc', EXP, ASignature, ANow));
end;

procedure TSignedLinksTests.Sign_MatchesTheReferenceVectors;
var
  LLinks: TSignedLinks;
begin
  LLinks := TSignedLinks.Create(K1);
  try
    TAssert.AssertEquals(SIG_K1, LLinks.Sign('demo', 'appointment', '0123abc', EXP));
    TAssert.AssertEquals('k1', LLinks.SigningKeyId);
  finally
    LLinks.Free;
  end;
  LLinks := TSignedLinks.Create(K2);
  try
    TAssert.AssertEquals(SIG_K2, LLinks.Sign('demo', 'appointment', '0123abc', EXP));
  finally
    LLinks.Free;
  end;
end;

procedure TSignedLinksTests.Sign_NonAsciiScopeIsUtf8;
var
  LLinks: TSignedLinks;
begin
  LLinks := TSignedLinks.Create(K1);
  try
    TAssert.AssertEquals('k1.F8eNzTch1zNImLQnehHnSfyHh3io4oeZq4qGZwUqFbU',
      LLinks.Sign(SAO, 'appointment', 'x', 5));
  finally
    LLinks.Free;
  end;
end;

procedure TSignedLinksTests.Keys_StandardBase64AndBase64Url;
const
  SIG = 'k.zt1DiYLTgCtC_VhbE_mmwZY9PlYOvUbtZRZMGejbRvk';
var
  LLinks: TSignedLinks;
begin
  // The same 32 bytes written both ways ("+" and "/", or "-" and "_").
  LLinks := TSignedLinks.Create('k:+/+/+/+/+/+/+/+/+/+/+/+/+/+/+/+/+/+/+/+/+/8=');
  try
    TAssert.AssertEquals('standard', SIG, LLinks.Sign('demo', 'appointment', 'r', 10));
  finally
    LLinks.Free;
  end;
  LLinks := TSignedLinks.Create(' k : -_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_8 ');
  try
    TAssert.AssertEquals('url, unpadded, spaces', SIG, LLinks.Sign('demo', 'appointment', 'r', 10));
  finally
    LLinks.Free;
  end;
end;

procedure TSignedLinksTests.Keys_RefusedSettings;
begin
  TAssert.AssertEquals('empty', 'ESignedLinkError', CreateRaises(''));
  TAssert.AssertEquals('no id', 'ESignedLinkError', CreateRaises('AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8='));
  TAssert.AssertEquals('dot in id', 'ESignedLinkError',
    CreateRaises('k.1:AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8='));
  TAssert.AssertEquals('id too long', 'ESignedLinkError',
    CreateRaises('abcdefghijklmnopq:AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8='));
  TAssert.AssertEquals('31 bytes', 'ESignedLinkError',
    CreateRaises('k:AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHg=='));
  TAssert.AssertEquals('not Base64', 'ESignedLinkError', CreateRaises('k:not*base64'));
  TAssert.AssertEquals('repeated id', 'ESignedLinkError', CreateRaises(K1 + ',' + K1));
  TAssert.AssertEquals('trailing comma', 'ESignedLinkError', CreateRaises(K1 + ','));
  TAssert.AssertEquals('two keys', '', CreateRaises(K1 + ', ' + K2));
end;

procedure TSignedLinksTests.Verify_Ok;
var
  LLinks: TSignedLinks;
begin
  LLinks := TSignedLinks.Create(K1);
  try
    TAssert.AssertEquals('ok', VerifyDemo(LLinks, SIG_K1, EXP - 1));
    TAssert.AssertEquals('ok', VerifyDemo(LLinks, SIG_K1, 0));
  finally
    LLinks.Free;
  end;
end;

procedure TSignedLinksTests.Verify_EveryPartIsSigned;
var
  LLinks: TSignedLinks;
begin
  LLinks := TSignedLinks.Create(K1);
  try
    TAssert.AssertEquals('scope', 'bad signature',
      CheckName(LLinks.Verify('other', 'appointment', '0123abc', EXP, SIG_K1, 0)));
    TAssert.AssertEquals('purpose', 'bad signature',
      CheckName(LLinks.Verify('demo', 'invite', '0123abc', EXP, SIG_K1, 0)));
    TAssert.AssertEquals('resource', 'bad signature',
      CheckName(LLinks.Verify('demo', 'appointment', '0123abd', EXP, SIG_K1, 0)));
    TAssert.AssertEquals('expiry pushed later', 'bad signature',
      CheckName(LLinks.Verify('demo', 'appointment', '0123abc', EXP + 86400, SIG_K1, 0)));
    // A signature from another key named as k1's.
    TAssert.AssertEquals('k2''s signature under k1''s id', 'bad signature',
      VerifyDemo(LLinks, 'k1.' + Copy(SIG_K2, 4, MaxInt), 0));
  finally
    LLinks.Free;
  end;
end;

procedure TSignedLinksTests.Verify_ExpiredOnlyWithAGoodSignature;
var
  LLinks: TSignedLinks;
begin
  LLinks := TSignedLinks.Create(K1);
  try
    TAssert.AssertEquals('at the expiry', 'expired', VerifyDemo(LLinks, SIG_K1, EXP));
    TAssert.AssertEquals('after', 'expired', VerifyDemo(LLinks, SIG_K1, EXP + 1));
    TAssert.AssertEquals('a wrong signature, expired', 'bad signature',
      VerifyDemo(LLinks, 'k1.' + Copy(SIG_K2, 4, MaxInt), EXP + 1));
    TAssert.AssertEquals('an unknown key, expired', 'unknown key',
      VerifyDemo(LLinks, SIG_K2, EXP + 1));
  finally
    LLinks.Free;
  end;
end;

procedure TSignedLinksTests.Verify_MalformedSignatures;
var
  LLinks: TSignedLinks;
begin
  LLinks := TSignedLinks.Create(K1);
  try
    TAssert.AssertEquals('empty', 'malformed', VerifyDemo(LLinks, '', 0));
    TAssert.AssertEquals('no key id', 'malformed', VerifyDemo(LLinks, Copy(SIG_K1, 3, MaxInt), 0));
    TAssert.AssertEquals('no dot', 'malformed', VerifyDemo(LLinks, 'k1' + Copy(SIG_K1, 4, MaxInt), 0));
    TAssert.AssertEquals('cut', 'malformed', VerifyDemo(LLinks, Copy(SIG_K1, 1, 20), 0));
    TAssert.AssertEquals('not Base64url', 'malformed',
      VerifyDemo(LLinks, 'k1.TUXdgfsaVcEBEqd5y9gtxFIfVZxwPDBs13U3RR2WJy+', 0));
    TAssert.AssertEquals('too long', 'malformed', VerifyDemo(LLinks, SIG_K1 + 'AAAA', 0));
    // SIG_K1 ends in "g" (32 = 100000); "h" differs only in the 2 bits the
    // decoder drops: the same bytes, another spelling.
    TAssert.AssertEquals('a non-canonical last character', 'malformed',
      VerifyDemo(LLinks, Copy(SIG_K1, 1, Length(SIG_K1) - 1) + 'h', 0));
    TAssert.AssertEquals('padding', 'malformed', VerifyDemo(LLinks, SIG_K1 + '=', 0));
    TAssert.AssertEquals('a bad key id', 'malformed',
      VerifyDemo(LLinks, 'k 1' + Copy(SIG_K1, 3, MaxInt), 0));
    TAssert.AssertEquals('a resource with "|"', 'malformed',
      CheckName(LLinks.Verify('demo', 'appointment', 'a|b', EXP, SIG_K1, 0)));
    TAssert.AssertEquals('a negative expiry', 'malformed',
      CheckName(LLinks.Verify('demo', 'appointment', '0123abc', -1, SIG_K1, 0)));
  finally
    LLinks.Free;
  end;
end;

procedure TSignedLinksTests.Verify_RotatedKeys;
var
  LLinks: TSignedLinks;
begin
  // k2 is new and signs; k1's links still verify until it is dropped.
  LLinks := TSignedLinks.Create(K2 + ',' + K1);
  try
    TAssert.AssertEquals(SIG_K2, LLinks.Sign('demo', 'appointment', '0123abc', EXP));
    TAssert.AssertEquals('the old key''s link', 'ok', VerifyDemo(LLinks, SIG_K1, 0));
    TAssert.AssertEquals('the new key''s link', 'ok', VerifyDemo(LLinks, SIG_K2, 0));
  finally
    LLinks.Free;
  end;
  LLinks := TSignedLinks.Create(K2);
  try
    TAssert.AssertEquals('k1 dropped', 'unknown key', VerifyDemo(LLinks, SIG_K1, 0));
  finally
    LLinks.Free;
  end;
end;

procedure TSignedLinksTests.Verify_TenantsKeysDiffer;
var
  LLinks: TSignedLinks;
  LDemo, LOther: string;
begin
  LLinks := TSignedLinks.Create(K1);
  try
    LDemo := LLinks.Sign('demo', 'appointment', 'same-id', EXP);
    LOther := LLinks.Sign('other', 'appointment', 'same-id', EXP);
    TAssert.AssertTrue('a signature per tenant', LDemo <> LOther);
    TAssert.AssertEquals('demo''s link for other', 'bad signature',
      CheckName(LLinks.Verify('other', 'appointment', 'same-id', EXP, LDemo, 0)));
  finally
    LLinks.Free;
  end;
end;

procedure TSignedLinksTests.Sign_RefusesWhatCannotBeSigned;
var
  LLinks: TSignedLinks;
begin
  LLinks := TSignedLinks.Create(K1);
  try
    TAssert.AssertEquals('empty scope', 'ESignedLinkError', SignRaises(LLinks, '', 'p', 'r', 1));
    TAssert.AssertEquals('empty purpose', 'ESignedLinkError', SignRaises(LLinks, 's', '', 'r', 1));
    TAssert.AssertEquals('"|" in the scope', 'ESignedLinkError', SignRaises(LLinks, 'a|b', 'p', 'r', 1));
    TAssert.AssertEquals('"|" in the resource', 'ESignedLinkError', SignRaises(LLinks, 's', 'p', 'a|b', 1));
    TAssert.AssertEquals('negative expiry', 'ESignedLinkError', SignRaises(LLinks, 's', 'p', 'r', -1));
    TAssert.AssertEquals('an empty resource is fine', '', SignRaises(LLinks, 's', 'p', '', 0));
  finally
    LLinks.Free;
  end;
end;

procedure TSignedLinksTests.Query_ExpAndSig;
var
  LLinks: TSignedLinks;
begin
  LLinks := TSignedLinks.Create(K1);
  try
    TAssert.AssertEquals('exp=1800000000&sig=' + SIG_K1,
      LLinks.Query('demo', 'appointment', '0123abc', EXP));
  finally
    LLinks.Free;
  end;
end;

procedure TSignedLinksTests.TryParseLinkExpiry_DigitsOnly;
var
  LValue: Int64;
begin
  TAssert.AssertTrue(TryParseLinkExpiry('1800000000', LValue));
  TAssert.AssertEquals(Int64(1800000000), LValue);
  TAssert.AssertTrue(TryParseLinkExpiry('0', LValue));
  TAssert.AssertEquals(Int64(0), LValue);
  TAssert.AssertTrue('18 digits', TryParseLinkExpiry('999999999999999999', LValue));
  TAssert.AssertFalse('19 digits', TryParseLinkExpiry('1000000000000000000', LValue));
  TAssert.AssertFalse('empty', TryParseLinkExpiry('', LValue));
  TAssert.AssertFalse('sign', TryParseLinkExpiry('+5', LValue));
  TAssert.AssertFalse('negative', TryParseLinkExpiry('-5', LValue));
  TAssert.AssertFalse('space', TryParseLinkExpiry(' 5', LValue));
  TAssert.AssertFalse('hex', TryParseLinkExpiry('$10', LValue));
end;

initialization
  RegisterTest(TSignedLinksTests);

end.
