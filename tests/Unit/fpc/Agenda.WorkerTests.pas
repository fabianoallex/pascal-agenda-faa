// The temporary directory, with its delimiter: GetTempDir is FPC's RTL only
// (Delphi: E2003), TPath.GetTempPath Delphi's.
function TempDir: string;
begin
  {$IFDEF FPC}
  Result := GetTempDir;
  {$ELSE}
  Result := TPath.GetTempPath;
  {$ENDIF}
  Result := IncludeTrailingPathDelimiter(Result);
end;

const
  TENANT = 'demo';
  // The 32 bytes "development-link-signing-key-123".
  LINK_KEYS = 'dev:ZGV2ZWxvcG1lbnQtbGluay1zaWduaW5nLWtleS0xMjM=';
  HOUR = 3600;

type
  /// Keeps the messages it was given.
  TRecordingMail = class(TInterfacedObject, IMailSender)
  public
    Sent: array of TMailMessage;
    procedure Send(const AMessage: TMailMessage);
  end;

procedure TRecordingMail.Send(const AMessage: TMailMessage);
begin
  SetLength(Sent, Length(Sent) + 1);
  Sent[High(Sent)] := AMessage;
end;

// The value of AName in the query of the first link in AText after AMarker.
function LinkParam(const AText, AMarker, AName: string): string;
var
  LAt: Integer;
  LRest: string;
begin
  LAt := Pos(AMarker, AText);
  LRest := Copy(AText, LAt + Length(AMarker), MaxInt);
  LRest := Copy(LRest, 1, Pos(#13, LRest + #13) - 1);
  LAt := Pos(AName + '=', LRest);
  Result := Copy(LRest, LAt + Length(AName) + 1, MaxInt);
  LAt := Pos('&', Result);
  if LAt > 0 then
    Result := Copy(Result, 1, LAt - 1);
end;

{ TWorkerTests }

procedure TWorkerTests.SetUp;
begin
  FSkips := 0;
  FLastSkip := '';
  FNow := TJwt.UnixNow;
  FLinks := TSignedLinks.Create(LINK_KEYS, LINK_CONTEXT);
  FFile := TempDir + 'agenda-worker-' +
    LowerCase(PcBytesToHex(PcRandomBytes(6))) + '.sqlite';
  FDb := TAgendaDatabase.CreateSQLite(FFile);
  FDb.Migrate(nil);
  AddTenant(TENANT, 24);
  Exec('INSERT INTO PROFESSIONALS (TENANT_ID, ID, NAME, NAME_KEY, CREATED_AT, UPDATED_AT) ' +
    'VALUES (''demo'', ''p1'', ''Elisa Prado'', ''elisa prado'', 0, 0)');
  Exec('INSERT INTO SERVICES (TENANT_ID, ID, NAME, NAME_KEY, DURATION_MINUTES, PRICE_CENTS, ' +
    'CREATED_AT, UPDATED_AT) VALUES (''demo'', ''s1'', ''Corte'', ''corte'', 30, 5000, 0, 0)');
  Exec('INSERT INTO CUSTOMERS (TENANT_ID, ID, NAME, NAME_KEY, EMAIL, SEARCH_KEY, CREATED_AT, ' +
    'UPDATED_AT) VALUES (''demo'', ''c1'', ''João Silva'', ''joao silva'', ''joao@example.com'', ' +
    '''joao silva'', 0, 0)');
  Exec('INSERT INTO CUSTOMERS (TENANT_ID, ID, NAME, NAME_KEY, PHONE, SEARCH_KEY, CREATED_AT, ' +
    'UPDATED_AT) VALUES (''demo'', ''c2'', ''Ana'', ''ana'', ''+5511999990000'', ''ana'', 0, 0)');
end;

procedure TWorkerTests.TearDown;
begin
  FreeAndNil(FDb);
  FreeAndNil(FLinks);
  DeleteFile(FFile);
end;

procedure TWorkerTests.Exec(const ASql: string);
var
  LQuery: IQuery;
  LTx: IScopeTransaction;
begin
  LTx := FDb.Factory.GetPool.AcquireQuery(LQuery);
  LTx.StartTransaction;
  try
    LQuery.Sql := ASql;
    LQuery.ExecSql;
    LTx.Commit;
  except
    LTx.Rollback;
    raise;
  end;
end;

function TWorkerTests.Count(const ASql: string): Integer;
var
  LQuery: IQuery;
  LTx: IScopeTransaction;
begin
  LTx := FDb.Factory.GetPool.AcquireQuery(LQuery);
  LQuery.Sql := 'SELECT COUNT(*) AS N FROM ' + ASql;
  Result := LQuery.Open.Integers['N'];
end;

procedure TWorkerTests.AddTenant(const AId: string; AReminderHours: Integer);
begin
  Exec(Format('INSERT INTO TENANTS (ID, NAME, TIME_ZONE, REMINDER_HOURS) VALUES ' +
    '(''%s'', ''Clínica %s'', ''America/Sao_Paulo'', %d)', [AId, AId, AReminderHours]));
end;

procedure TWorkerTests.AddAppointment(const ATenant, AId, ACustomer: string; AStart: Int64;
  const AStatus: string);
begin
  Exec(Format('INSERT INTO APPOINTMENTS (TENANT_ID, ID, PROFESSIONAL_ID, SERVICE_ID, ' +
    'CUSTOMER_ID, START_UTC, END_UTC, BUSY_UNTIL_UTC, STATUS, VERSION, CREATED_AT, UPDATED_AT) ' +
    'VALUES (''%s'', ''%s'', ''p1'', ''s1'', ''%s'', %d, %d, %d, ''%s'', 1, 0, 0)',
    [ATenant, AId, ACustomer, AStart, AStart + 1800, AStart + 1800, AStatus]));
end;

function TWorkerTests.EventFor(const AKind, AId: string; AVersion: Integer): TOutboxEvent;
begin
  Result.TenantId := TENANT;
  Result.Id := 'e-' + AId + '-' + AKind;
  Result.Kind := AKind;
  Result.Payload := AppointmentEventPayload(AId, AVersion);
  Result.TraceParent := '';
  Result.CreatedAt := FNow;
  Result.Attempts := 0;
end;

procedure TWorkerTests.Skipped(const AEvent: TOutboxEvent; const AReason: string);
begin
  Inc(FSkips);
  FLastSkip := AReason;
end;

procedure TWorkerTests.Lease_TakenThenRefusedThenRenewedThenTakenOver;
var
  LA, LB: ISchedulerLease;
begin
  LA := TDbSchedulerLease.Create(FDb.Factory, 'worker-a');
  LB := TDbSchedulerLease.Create(FDb.Factory, 'worker-b');
  TAssert.AssertTrue('free: taken', LA.TryAcquire('job', 60, 1000));
  TAssert.AssertFalse('held by a', LB.TryAcquire('job', 60, 1010));
  TAssert.AssertTrue('renewed by its owner', LA.TryAcquire('job', 60, 1050));
  TAssert.AssertFalse('the renewal counts', LB.TryAcquire('job', 60, 1100));
  TAssert.AssertTrue('ran out: taken over', LB.TryAcquire('job', 60, 1110));
  TAssert.AssertFalse('a lost it', LA.TryAcquire('job', 60, 1120));
  TAssert.AssertTrue('another job is apart', LA.TryAcquire('other', 60, 1120));
end;

procedure TWorkerTests.Lease_Release_LetsAnotherTake;
var
  LA, LB: ISchedulerLease;
begin
  LA := TDbSchedulerLease.Create(FDb.Factory, 'worker-a');
  LB := TDbSchedulerLease.Create(FDb.Factory, 'worker-b');
  TAssert.AssertTrue(LA.TryAcquire('job', 60, 1000));
  LB.Release('job');
  TAssert.AssertFalse('not b''s to release', LB.TryAcquire('job', 60, 1001));
  LA.Release('job');
  TAssert.AssertTrue('released', LB.TryAcquire('job', 60, 1002));
end;

procedure TWorkerTests.Reminders_QueuedOnce_WithTheEvent;
var
  LScheduler: TReminderScheduler;
begin
  AddAppointment(TENANT, 'a1', 'c1', FNow + 2 * HOUR);
  LScheduler := TReminderScheduler.Create(FDb.Factory);
  try
    TAssert.AssertEquals('queued', 1, LScheduler.RunOnce(FNow));
    TAssert.AssertEquals('a second pass', 0, LScheduler.RunOnce(FNow + 60));
  finally
    LScheduler.Free;
  end;
  TAssert.AssertEquals('one event', 1, Count('OUTBOX WHERE KIND = ''' +
    EVENT_APPOINTMENT_REMINDER + ''' AND TENANT_ID = ''demo'' AND PAYLOAD = ''' +
    AppointmentEventPayload('a1', 1) + ''''));
  TAssert.AssertEquals('claimed', 1, Count('APPOINTMENTS WHERE ID = ''a1'' AND ' +
    'REMINDER_QUEUED_AT IS NOT NULL AND VERSION = 1'));
end;

procedure TWorkerTests.Reminders_OnlyTheDueOnes;
var
  LScheduler: TReminderScheduler;
begin
  AddTenant('zero', 0);
  AddTenant('away', 24);
  Exec('UPDATE TENANTS SET SUSPENDED = 1 WHERE ID = ''away''');
  Exec('INSERT INTO PROFESSIONALS (TENANT_ID, ID, NAME, NAME_KEY, CREATED_AT, UPDATED_AT) ' +
    'SELECT T.ID, ''p1'', ''P'', ''p'', 0, 0 FROM TENANTS T WHERE T.ID <> ''demo''');
  Exec('INSERT INTO SERVICES (TENANT_ID, ID, NAME, NAME_KEY, DURATION_MINUTES, PRICE_CENTS, ' +
    'CREATED_AT, UPDATED_AT) SELECT T.ID, ''s1'', ''S'', ''s'', 30, 0, 0, 0 FROM TENANTS T ' +
    'WHERE T.ID <> ''demo''');
  Exec('INSERT INTO CUSTOMERS (TENANT_ID, ID, NAME, NAME_KEY, SEARCH_KEY, CREATED_AT, ' +
    'UPDATED_AT) SELECT T.ID, ''c1'', ''C'', ''c'', ''c'', 0, 0 FROM TENANTS T ' +
    'WHERE T.ID <> ''demo''');
  AddAppointment(TENANT, 'due', 'c1', FNow + 23 * HOUR);
  AddAppointment(TENANT, 'later', 'c1', FNow + 25 * HOUR);
  AddAppointment(TENANT, 'past', 'c1', FNow - HOUR);
  AddAppointment(TENANT, 'cancelled', 'c1', FNow + HOUR, 'cancelled');
  AddAppointment(TENANT, 'confirmed', 'c2', FNow + HOUR, 'confirmed');
  AddAppointment('zero', 'none', 'c1', FNow + HOUR);
  AddAppointment('away', 'suspended', 'c1', FNow + HOUR);
  LScheduler := TReminderScheduler.Create(FDb.Factory);
  try
    TAssert.AssertEquals(2, LScheduler.RunOnce(FNow));
  finally
    LScheduler.Free;
  end;
  TAssert.AssertEquals('due and confirmed', 2, Count('APPOINTMENTS WHERE ' +
    'REMINDER_QUEUED_AT IS NOT NULL AND ID IN (''due'', ''confirmed'')'));
end;

procedure TWorkerTests.Reminders_ClaimNeedsTheVersionRead;
var
  LQuery: IQuery;
  LTx: IScopeTransaction;
begin
  AddAppointment(TENANT, 'a1', 'c1', FNow + HOUR);
  LTx := FDb.Factory.GetPool.AcquireQuery(LQuery);
  LTx.StartTransaction;
  try
    LQuery.Sql := FDb.Factory.SqlLoader[REMINDER_SQL_CLAIM].SQL;
    LQuery.Params.Int64s['NOW'] := FNow;
    LQuery.Params.Strings['TENANT_ID'] := TENANT;
    LQuery.Params.Strings['ID'] := 'a1';
    LQuery.Params.Integers['VERSION'] := 2;
    LQuery.Params.Strings['BOOKED'] := 'booked';
    LQuery.Params.Strings['CONFIRMED'] := 'confirmed';
    TAssert.AssertEquals('another version: no row', 0, Integer(LQuery.ExecSql));
    LTx.Commit;
  except
    LTx.Rollback;
    raise;
  end;
end;

procedure TWorkerTests.Reminders_MoveClearsTheClaim;
var
  LScheduler: TReminderScheduler;
  LScope: TTenantDataScope;
  LQuery: IQuery;
  LTx: IScopeTransaction;
begin
  AddAppointment(TENANT, 'a1', 'c1', FNow + 2 * HOUR);
  LScheduler := TReminderScheduler.Create(FDb.Factory);
  try
    TAssert.AssertEquals(1, LScheduler.RunOnce(FNow));
    // The repository's move (Agenda.Appointments), its statement as it is.
    LScope.Factory := FDb.Factory;
    LScope.Discriminator := TENANT;
    LTx := FDb.Factory.GetPool.AcquireQuery(LQuery);
    LTx.StartTransaction;
    try
      TTenantFilter.Prepare(LQuery, LScope, FDb.Factory.SqlLoader['APPOINTMENT.UPDATE']
        .ProcessTag('MOVE', True).ProcessTag('STATUS', False));
      LQuery.Params.Int64s['UPDATED_AT'] := FNow;
      LQuery.Params.Int64s['START_UTC'] := FNow + 3 * HOUR;
      LQuery.Params.Int64s['END_UTC'] := FNow + 3 * HOUR + 1800;
      LQuery.Params.Int64s['BUSY_UNTIL_UTC'] := FNow + 3 * HOUR + 1800;
      LQuery.Params.Strings['ID'] := 'a1';
      LQuery.Params.Integers['VERSION'] := 1;
      TAssert.AssertEquals(1, Integer(LQuery.ExecSql));
      LTx.Commit;
    except
      LTx.Rollback;
      raise;
    end;
    LQuery := nil;
    LTx := nil;
    TAssert.AssertEquals('the new start gets one', 1, LScheduler.RunOnce(FNow + 60));
  finally
    LScheduler.Free;
  end;
  TAssert.AssertEquals('for version 2', 1, Count('OUTBOX WHERE PAYLOAD = ''' +
    AppointmentEventPayload('a1', 2) + ''''));
end;

procedure TWorkerTests.Mailer_Booked_SignedLinksThatVerify;
var
  LMail: TRecordingMail;
  LKeep: IMailSender;
  LMailer: IOutboxHandler;
  LBody, LExp, LSig: string;
  LStart: Int64;
begin
  LStart := FNow + 48 * HOUR;
  AddAppointment(TENANT, 'a1', 'c1', LStart);
  LMail := TRecordingMail.Create;
  LKeep := LMail;
  LMailer := TAppointmentMailer.Create(FDb.Factory, LMail, FLinks,
    'Agenda <agenda@example.com>', 'https://agenda.example/');
  TAssert.AssertTrue(LMailer.Accepts(EVENT_APPOINTMENT_BOOKED));
  TAssert.AssertFalse(LMailer.Accepts('appointment.confirmed'));
  LMailer.Handle(EventFor(EVENT_APPOINTMENT_BOOKED, 'a1'));
  TAssert.AssertEquals('one email', 1, Length(LMail.Sent));
  TAssert.AssertEquals('joao@example.com', LMail.Sent[0].ToAddress);
  TAssert.AssertEquals('Agenda <agenda@example.com>', LMail.Sent[0].From);
  TAssert.AssertEquals('Booked: Corte, ' + NoticeTime(LStart, 'America/Sao_Paulo'),
    LMail.Sent[0].Subject);
  TAssert.AssertEquals('e-a1-appointment.booked@example.com', LMail.Sent[0].MessageId);
  LBody := LMail.Sent[0].TextBody;
  TAssert.AssertTrue('the name', Pos('Hello, João Silva.', LBody) > 0);
  TAssert.AssertTrue('the link, one "/" after the base',
    Pos('See it: https://agenda.example/public/demo/appointments/a1?exp=', LBody) > 0);
  TAssert.AssertTrue('the cancel link',
    Pos('Cancel it: https://agenda.example/public/demo/appointments/a1/cancel?exp=', LBody) > 0);
  LExp := LinkParam(LBody, 'See it: ', 'exp');
  LSig := LinkParam(LBody, 'See it: ', 'sig');
  TAssert.AssertEquals('expires at the start', IntToStr(LStart), LExp);
  TAssert.AssertTrue('the signature verifies', FLinks.Verify(TENANT, NOTIFY_LINK_PURPOSE, 'a1',
    StrToInt64(LExp), LSig, FNow) = lsOk);
end;

procedure TWorkerTests.Mailer_NoEmail_Skipped;
var
  LMail: TRecordingMail;
  LKeep: IMailSender;
  LMailer: TAppointmentMailer;
  LKeepHandler: IOutboxHandler;
begin
  AddAppointment(TENANT, 'a2', 'c2', FNow + 48 * HOUR);
  LMail := TRecordingMail.Create;
  LKeep := LMail;
  LMailer := TAppointmentMailer.Create(FDb.Factory, LMail, FLinks, 'a@example.com', '');
  LKeepHandler := LMailer;
  LMailer.OnSkip := Skipped;
  LMailer.Handle(EventFor(EVENT_APPOINTMENT_BOOKED, 'a2'));
  LMailer.Handle(EventFor(EVENT_APPOINTMENT_BOOKED, 'nobody'));
  TAssert.AssertEquals('nothing sent', 0, Length(LMail.Sent));
  TAssert.AssertEquals('two skips', 2, FSkips);
  TAssert.AssertEquals('no such appointment', FLastSkip);
end;

procedure TWorkerTests.Mailer_Cancelled_NoLinks_AndBookedAfterCancelSkipped;
var
  LMail: TRecordingMail;
  LKeep: IMailSender;
  LMailer: TAppointmentMailer;
  LKeepHandler: IOutboxHandler;
begin
  AddAppointment(TENANT, 'a1', 'c1', FNow + 48 * HOUR, 'cancelled');
  LMail := TRecordingMail.Create;
  LKeep := LMail;
  LMailer := TAppointmentMailer.Create(FDb.Factory, LMail, FLinks, 'a@example.com', '');
  LKeepHandler := LMailer;
  LMailer.OnSkip := Skipped;
  LMailer.Handle(EventFor(EVENT_APPOINTMENT_BOOKED, 'a1'));
  TAssert.AssertEquals('a booking read after the cancel', 0, Length(LMail.Sent));
  TAssert.AssertEquals('no longer active (cancelled)', FLastSkip);
  LMailer.Handle(EventFor(EVENT_APPOINTMENT_CANCELLED, 'a1', 2));
  TAssert.AssertEquals(1, Length(LMail.Sent));
  TAssert.AssertEquals('Cancelled: ', Copy(LMail.Sent[0].Subject, 1, 11));
  TAssert.AssertEquals('no link', 0, Pos('/public/', LMail.Sent[0].TextBody));
end;

procedure TWorkerTests.Mailer_ReminderForStartedAppointment_Skipped;
var
  LMail: TRecordingMail;
  LKeep: IMailSender;
  LMailer: TAppointmentMailer;
  LKeepHandler: IOutboxHandler;
begin
  AddAppointment(TENANT, 'a1', 'c1', FNow - 60);
  AddAppointment(TENANT, 'a2', 'c1', FNow + HOUR);
  LMail := TRecordingMail.Create;
  LKeep := LMail;
  LMailer := TAppointmentMailer.Create(FDb.Factory, LMail, FLinks, 'a@example.com', '');
  LKeepHandler := LMailer;
  LMailer.OnSkip := Skipped;
  LMailer.Handle(EventFor(EVENT_APPOINTMENT_REMINDER, 'a1'));
  TAssert.AssertEquals('already started', FLastSkip);
  LMailer.Handle(EventFor(EVENT_APPOINTMENT_REMINDER, 'a2'));
  TAssert.AssertEquals(1, Length(LMail.Sent));
  TAssert.AssertEquals('Reminder: ', Copy(LMail.Sent[0].Subject, 1, 10));
  TAssert.AssertTrue('a path alone without a base',
    Pos('See it: /public/demo/appointments/a2?exp=', LMail.Sent[0].TextBody) > 0);
end;

procedure TWorkerTests.NoticeTime_InTheTenantZone;
begin
  // 2026-11-03T17:30:00Z; São Paulo is UTC-3 all year since 2019.
  TAssert.AssertEquals('Tuesday, 3 November 2026, 14:30',
    NoticeTime(1793727000, 'America/Sao_Paulo'));
end;

