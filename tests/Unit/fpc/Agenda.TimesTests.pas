implementation

procedure TTimesTests.Clock_Parses;
var
  M: Integer;
begin
  TAssert.AssertTrue(TryParseClock('00:00', M));
  TAssert.AssertEquals(0, M);
  TAssert.AssertTrue(TryParseClock('09:30', M));
  TAssert.AssertEquals(570, M);
  TAssert.AssertTrue(TryParseClock('23:59', M));
  TAssert.AssertEquals(1439, M);
  TAssert.AssertTrue(TryParseClock('24:00', M));
  TAssert.AssertEquals(1440, M);
end;

procedure TTimesTests.Clock_Refuses;
var
  M: Integer;
begin
  TAssert.AssertFalse(TryParseClock('9:30', M));
  TAssert.AssertFalse(TryParseClock('09:60', M));
  TAssert.AssertFalse(TryParseClock('24:01', M));
  TAssert.AssertFalse(TryParseClock('25:00', M));
  TAssert.AssertFalse(TryParseClock('09h30', M));
  TAssert.AssertFalse(TryParseClock('09:30:00', M));
  TAssert.AssertFalse(TryParseClock('', M));
end;

procedure TTimesTests.Clock_Writes;
begin
  TAssert.AssertEquals('00:00', ClockToStr(0));
  TAssert.AssertEquals('09:05', ClockToStr(545));
  TAssert.AssertEquals('24:00', ClockToStr(1440));
end;

procedure TTimesTests.Instant_Utc;
var
  U: Int64;
begin
  TAssert.AssertTrue(TryParseInstant('1970-01-01T00:00:00Z', U));
  TAssert.AssertEquals(Int64(0), U);
  // date -u -d 2026-12-24T13:00:00Z +%s
  TAssert.AssertTrue(TryParseInstant('2026-12-24T13:00:00Z', U));
  TAssert.AssertEquals(Int64(1798117200), U);
  TAssert.AssertTrue(TryParseInstant(' 2026-12-24T13:00Z ', U));
  TAssert.AssertEquals(Int64(1798117200), U);
end;

procedure TTimesTests.Instant_Offset;
var
  U: Int64;
begin
  TAssert.AssertTrue(TryParseInstant('2026-12-24T10:00:00-03:00', U));
  TAssert.AssertEquals(Int64(1798117200), U);
  TAssert.AssertTrue(TryParseInstant('2026-12-24T18:30:00+05:30', U));
  TAssert.AssertEquals(Int64(1798117200), U);
end;

procedure TTimesTests.Instant_NeedsAZone;
var
  U: Int64;
begin
  TAssert.AssertFalse(TryParseInstant('2026-12-24T13:00:00', U));
  TAssert.AssertFalse(TryParseInstant('2026-12-24', U));
end;

procedure TTimesTests.Instant_Refuses;
var
  U: Int64;
begin
  TAssert.AssertFalse(TryParseInstant('2026-02-30T10:00:00Z', U));
  TAssert.AssertFalse(TryParseInstant('2026-12-24T25:00:00Z', U));
  TAssert.AssertFalse(TryParseInstant('tomorrow at noon Z', U));
  TAssert.AssertFalse(TryParseInstant('1969-12-31T23:59:59Z', U));
  TAssert.AssertFalse(TryParseInstant('', U));
end;

procedure TTimesTests.OptInstant_AbsentPresentRefused;
var
  LText: IOptString;
  LMessage: string;
begin
  LText := TOptNullString.Undefined;
  TAssert.AssertFalse('absent stays absent', OptInstant(LText, 'from').HasValue);
  LText := TOptNullString.From('2026-11-10T11:00:00-03:00');
  TAssert.AssertEquals('present: Unix seconds', Int64(1794319200), OptInstant(LText, 'from').Value);
  LText := TOptNullString.From('yesterday');
  LMessage := '';
  try
    OptInstant(LText, 'from');
  except
    on E: EValidationException do
      LMessage := E.Code + ': ' + E.Message;
  end;
  TAssert.AssertEquals('invalid_instant: "from" must be an ISO 8601 date and time with its ' +
    'zone ("Z" or an offset), such as 2026-12-24T13:00:00Z.', LMessage);
end;

// What a time off answers: Unix seconds from the database, through
// UnixToUtc, written by the mapper's TUtcDateTime writer.
procedure TTimesTests.Instant_Writes;
begin
  TAssert.AssertEquals('1970-01-01T00:00:00Z', JsonUtcDateTimeToStr(UnixToUtc(0)));
  TAssert.AssertEquals('2026-12-24T13:00:00Z', JsonUtcDateTimeToStr(UnixToUtc(1798117200)));
  TAssert.AssertEquals('2026-12-24T23:59:59Z', JsonUtcDateTimeToStr(UnixToUtc(1798156799)));
end;

procedure TTimesTests.Instant_RoundTrip;
var
  U, I: Int64;
begin
  // Every second of a day near 2038 comes back exact (no fraction-of-a-day
  // rounding), stepping by a prime so the hours, minutes and seconds vary.
  I := 2145830400;
  while I < 2145830400 + 86400 do
  begin
    TAssert.AssertTrue(TryParseInstant(JsonUtcDateTimeToStr(UnixToUtc(I)), U));
    TAssert.AssertEquals(I, U);
    TAssert.AssertEquals(I, UtcToUnix(UnixToUtc(I)));
    Inc(I, 997);
  end;
end;

function Interval(AWeekday, AStart, AEnd: Integer): TClockInterval;
begin
  Result.Weekday := AWeekday;
  Result.StartMinute := AStart;
  Result.EndMinute := AEnd;
end;

procedure TTimesTests.Week_SortsAndAccepts;
var
  W: TClockIntervalArray;
begin
  SetLength(W, 4);
  W[0] := Interval(2, 840, 1080);  // Tuesday 14:00-18:00
  W[1] := Interval(1, 540, 720);   // Monday 09:00-12:00
  W[2] := Interval(2, 480, 720);   // Tuesday 08:00-12:00
  W[3] := Interval(1, 720, 1440);  // Monday 12:00-24:00: touching is fine
  TAssert.AssertEquals('', WeekProblem(W));
  TAssert.AssertEquals(1, W[0].Weekday);
  TAssert.AssertEquals(540, W[0].StartMinute);
  TAssert.AssertEquals(720, W[1].StartMinute);
  TAssert.AssertEquals(480, W[2].StartMinute);
  TAssert.AssertEquals(840, W[3].StartMinute);
  W := nil;
  TAssert.AssertEquals('', WeekProblem(W));
end;

procedure TTimesTests.Week_Overlap;
var
  W: TClockIntervalArray;
begin
  SetLength(W, 3);
  W[0] := Interval(3, 540, 720);
  W[1] := Interval(4, 600, 660);  // another day: fine
  W[2] := Interval(3, 700, 800);
  TAssert.AssertEquals('Weekday 3: 09:00-12:00 overlaps 11:40-13:20.', WeekProblem(W));
end;

procedure TTimesTests.Week_Refuses;
var
  W: TClockIntervalArray;
begin
  SetLength(W, 1);
  W[0] := Interval(0, 540, 720);
  TAssert.AssertTrue(Pos('"weekday"', WeekProblem(W)) > 0);
  W[0] := Interval(8, 540, 720);
  TAssert.AssertTrue(Pos('"weekday"', WeekProblem(W)) > 0);
  W[0] := Interval(1, 541, 720);
  TAssert.AssertTrue(Pos('multiples of 5', WeekProblem(W)) > 0);
  W[0] := Interval(1, 720, 720);
  TAssert.AssertTrue(Pos('before "to"', WeekProblem(W)) > 0);
  W[0] := Interval(1, 1000, 900);
  TAssert.AssertTrue(Pos('before "to"', WeekProblem(W)) > 0);
end;

procedure TTimesTests.Week_TooMany;
var
  W: TClockIntervalArray;
  I: Integer;
begin
  SetLength(W, MAX_WEEK_INTERVALS + 1);
  for I := 0 to High(W) do
    W[I] := Interval(I mod 7 + 1, (I div 7) * 60, (I div 7) * 60 + 30);
  TAssert.AssertTrue(Pos('at most', WeekProblem(W)) > 0);
  SetLength(W, MAX_WEEK_INTERVALS);
  TAssert.AssertEquals('', WeekProblem(W));
end;

initialization
  RegisterTest(TTimesTests);

end.
