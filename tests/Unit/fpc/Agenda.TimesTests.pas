interface

uses
  fpcunit, testregistry,
  SysUtils,
  PascalCommon.Optionals,
  PascalJsonMapper.Json,
  PascalApi.Http,
  Agenda.Times;

type
  TTimesTests = class(TTestCase)
  published
    procedure Clock_Parses;
    procedure Clock_Refuses;
    procedure Clock_Writes;
    procedure Instant_Utc;
    procedure Instant_Offset;
    procedure Instant_NeedsAZone;
