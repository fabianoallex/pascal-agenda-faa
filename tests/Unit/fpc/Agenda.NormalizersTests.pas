// The 400's message, or '' when AProc raised nothing.
function NameError(const AText: string): string;
begin
  Result := '';
  try
    ValidateName(AText);
  except
    on E: EValidationException do
      Result := E.Message;
  end;
end;

function EmailError(const AText: string): string;
begin
  Result := '';
  try
    ValidateEmail(AText);
  except
    on E: EValidationException do
      Result := E.Message;
  end;
end;

function PhoneError(const AText: string): string;
begin
  Result := '';
  try
    ValidatePhone(AText);
  except
    on E: EValidationException do
      Result := E.Message;
  end;
end;

procedure TNormalizersTests.DisplayName_TrimsAndCollapses;
begin
  TAssert.AssertEquals('Corte de Cabelo', TNorm.DisplayName.Apply('  Corte   de'#9'Cabelo '));
  TAssert.AssertEquals('', TNorm.DisplayName.Apply('   '));
end;

procedure TNormalizersTests.Email_TrimsAndLowers;
begin
  TAssert.AssertEquals('ana@demo.test', TNorm.Email.Apply('  Ana@Demo.Test '));
end;

procedure TNormalizersTests.Phone_KeepsPlusAndDigits;
begin
  TAssert.AssertEquals('+5511999990000', TNorm.Phone.Apply('+55 (11) 99999-0000'));
  TAssert.AssertEquals('1133334444', TNorm.Phone.Apply(' 11 3333.4444 '));
  TAssert.AssertEquals('too short: kept for the check', '123456', TNorm.Phone.Apply('123-456'));
end;

procedure TNormalizersTests.Phone_LeavesWhatIsNoPhone;
begin
  TAssert.AssertEquals('call me', TNorm.Phone.Apply('call me'));
  TAssert.AssertEquals('11+99', TNorm.Phone.Apply('11+99'));
end;

procedure TNormalizersTests.Normalize_KeepsAbsentAndNull;
var
  LOpt: IOptString;
  LOptNull: IOptNullString;
begin
  // Through typed variables: TOptNullString.Undefined/Null/From answer the
  // class, which fits every overload of Normalize.
  LOpt := TOptNullString.Undefined;
  LOpt := TOptionals.Normalize(LOpt, TNorm.Email);
  TAssert.AssertFalse('absent stays absent', LOpt.HasValue);
  LOptNull := TOptNullString.Null;
  LOptNull := TOptionals.Normalize(LOptNull, TNorm.Email);
  TAssert.AssertTrue('null stays null', LOptNull.HasValue and LOptNull.IsNull);
  LOptNull := TOptNullString.From(' X@Y.Z ');
  LOptNull := TOptionals.Normalize(LOptNull, TNorm.Email);
  TAssert.AssertEquals('x@y.z', LOptNull.Value);
end;

procedure TNormalizersTests.ValidateName_Rules;
begin
  TAssert.AssertEquals('', NameError('Ana'));
  TAssert.AssertEquals('"name" is required.', NameError(''));
  TAssert.AssertEquals('"name" is required.', NameError('   '));
  TAssert.AssertEquals('', NameError(StringOfChar('a', MAX_NAME_CHARS)));
  TAssert.AssertEquals('"name" must have at most 100 characters.',
    NameError(StringOfChar('a', MAX_NAME_CHARS + 1)));
end;

procedure TNormalizersTests.ValidateEmail_Rules;
begin
  TAssert.AssertEquals('', EmailError('ana@demo.test'));
  TAssert.AssertEquals('"email" is not an email address.', EmailError('nope'));
  TAssert.AssertEquals('"email" is not an email address.', EmailError('@demo.test'));
  TAssert.AssertEquals('"email" is not an email address.', EmailError('a@b@c'));
end;

procedure TNormalizersTests.ValidatePhone_Rules;
begin
  TAssert.AssertEquals('', PhoneError('+5511999990000'));
  TAssert.AssertEquals('', PhoneError('12345678'));
  TAssert.AssertTrue('letters', PhoneError('call me') <> '');
  TAssert.AssertTrue('7 digits', PhoneError('1234567') <> '');
  TAssert.AssertTrue('16 digits', PhoneError('+1234567890123456') <> '');
  TAssert.AssertTrue('not normalized first', PhoneError('11 3333-4444') <> '');
end;

procedure TNormalizersTests.Validate_Optionals_OnlyWhatCame;
var
  LAbsent: IOptString;
  LNull: IOptNullString;
  LBad: IOptString;
  LRaised: Boolean;
begin
  LAbsent := TOptNullString.Undefined;
  LNull := TOptNullString.Null;
  // Absent and null are not checked: no exception.
  ValidateName(LAbsent);
  ValidateEmail(LAbsent);
  ValidateEmail(LNull);
  ValidatePhone(LNull);
  LBad := TOptNullString.From('nope');
  LRaised := False;
  try
    ValidateEmail(LBad);
  except
    on E: EValidationException do
      LRaised := True;
  end;
  TAssert.AssertTrue('a value that came is checked', LRaised);
end;

initialization
  RegisterTest(TNormalizersTests);

end.
