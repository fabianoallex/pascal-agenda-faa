interface

uses
  fpcunit, testregistry,
  SysUtils,
  PascalCommon.Optionals,
  PascalCommon.Validators,
  Agenda.Normalizers,
  Agenda.Validators;

type
  TNormalizersTests = class(TTestCase)
  published
    procedure DisplayName_TrimsAndCollapses;
    procedure Email_TrimsAndLowers;
    procedure Phone_KeepsPlusAndDigits;
    procedure Phone_LeavesWhatIsNoPhone;
    procedure Normalize_KeepsAbsentAndNull;
    procedure DisplayName_Rule;
    procedure Email_Rule;
    procedure Phone_Rule;
    procedure Validation_EveryFieldThatCame;
  end;

implementation

// The validator's message, or '' when AValue passes.
function MessageOf(const AValidator: IPcStringValidator; const AField, AValue: string): string;
begin
  if AValidator.Check(AField, AValue, Result) = '' then
    Result := '';
end;

procedure TNormalizersTests.DisplayName_TrimsAndCollapses;
begin
  TAssert.AssertEquals('Corte de Cabelo', TNorm.DisplayName.Apply('  Corte   de'#9'Cabelo '));
  TAssert.AssertEquals('', TNorm.DisplayName.Apply('   '));
end;

procedure TNormalizersTests.Email_TrimsAndLowers;
begin
  TAssert.AssertEquals('ana@demo.test', TNorm.Email.Apply('  Ana@Demo.Test '));
end;

procedure TNormalizersTests.Phone_KeepsPlusAndDigits;
begin
  TAssert.AssertEquals('+5511999990000', TNorm.Phone.Apply('+55 (11) 99999-0000'));
  TAssert.AssertEquals('1133334444', TNorm.Phone.Apply(' 11 3333.4444 '));
  TAssert.AssertEquals('too short: kept for the check', '123456', TNorm.Phone.Apply('123-456'));
end;

procedure TNormalizersTests.Phone_LeavesWhatIsNoPhone;
begin
  TAssert.AssertEquals('call me', TNorm.Phone.Apply('call me'));
  TAssert.AssertEquals('11+99', TNorm.Phone.Apply('11+99'));
end;

procedure TNormalizersTests.Normalize_KeepsAbsentAndNull;
var
  LOpt: IOptString;
  LOptNull: IOptNullString;
begin
  // Through typed variables: TOptNullString.Undefined/Null/From answer the
  // class, which fits every overload of Normalize.
  LOpt := TOptNullString.Undefined;
  LOpt := TOptionals.Normalize(LOpt, TNorm.Email);
  TAssert.AssertFalse('absent stays absent', LOpt.HasValue);
  LOptNull := TOptNullString.Null;
  LOptNull := TOptionals.Normalize(LOptNull, TNorm.Email);
  TAssert.AssertTrue('null stays null', LOptNull.HasValue and LOptNull.IsNull);
  LOptNull := TOptNullString.From(' X@Y.Z ');
  LOptNull := TOptionals.Normalize(LOptNull, TNorm.Email);
  TAssert.AssertEquals('x@y.z', LOptNull.Value);
end;

procedure TNormalizersTests.DisplayName_Rule;
begin
  // Its length is the document's (MaxLength, at the edge): only blanks here.
  TAssert.AssertEquals('', MessageOf(TValid.DisplayName, 'name', 'Ana'));
  TAssert.AssertEquals('"name" is required.', MessageOf(TValid.DisplayName, 'name', ''));
  TAssert.AssertEquals('"name" is required.', MessageOf(TValid.DisplayName, 'name', '   '));
end;

procedure TNormalizersTests.Email_Rule;
begin
  TAssert.AssertEquals('', MessageOf(TValid.Email, 'email', 'ana@demo.test'));
  TAssert.AssertEquals('"email" is not an email address.', MessageOf(TValid.Email, 'email', 'nope'));
  TAssert.AssertEquals('"email" is not an email address.',
    MessageOf(TValid.Email, 'email', '@demo.test'));
  TAssert.AssertEquals('"email" is not an email address.', MessageOf(TValid.Email, 'email', 'a@b@c'));
end;

procedure TNormalizersTests.Phone_Rule;
begin
  TAssert.AssertEquals('', MessageOf(TValid.Phone, 'phone', '+5511999990000'));
  TAssert.AssertEquals('', MessageOf(TValid.Phone, 'phone', '12345678'));
  TAssert.AssertTrue('letters', MessageOf(TValid.Phone, 'phone', 'call me') <> '');
  TAssert.AssertTrue('7 digits', MessageOf(TValid.Phone, 'phone', '1234567') <> '');
  TAssert.AssertTrue('16 digits', MessageOf(TValid.Phone, 'phone', '+1234567890123456') <> '');
  TAssert.AssertTrue('not normalized first', MessageOf(TValid.Phone, 'phone', '11 3333-4444') <> '');
end;

procedure TNormalizersTests.Validation_EveryFieldThatCame;
var
  LAbsent, LBadEmail: IOptString;
  LNull, LBadPhone: IOptNullString;
  LCheck: TPcValidation;
  LErrors: TPcFieldErrors;
  LRaised: Boolean;
begin
  // Through typed variables: TOptNullString.Undefined/Null/From answer the
  // class, which fits every overload of Check.
  LAbsent := TOptNullString.Undefined;
  LNull := TOptNullString.Null;
  LBadEmail := TOptNullString.From('nope');
  LBadPhone := TOptNullString.From('123');
  LCheck := TPcValidation.Create;
  LCheck.Check('name', LAbsent, TValid.DisplayName);     // absent: not checked
  LCheck.Check('phone', LNull, TValid.Phone);            // null: not checked
  LCheck.Check('email', LBadEmail, TValid.Email);
  LCheck.Check('phone2', LBadPhone, TValid.Phone);
  LRaised := False;
  try
    LCheck.RaiseIfAny;
  except
    on E: EPcValidationError do
    begin
      LRaised := True;
      LErrors := E.Errors;
    end;
  end;
  TAssert.AssertTrue('the values that came are checked', LRaised);
  TAssert.AssertEquals(2, Length(LErrors));
  TAssert.AssertEquals('email', LErrors[0].Field);
  TAssert.AssertEquals('invalid_email', LErrors[0].Code);
  TAssert.AssertEquals('phone2', LErrors[1].Field);
  TAssert.AssertEquals('invalid_phone', LErrors[1].Code);
end;

initialization
  RegisterTest(TNormalizersTests);

end.
