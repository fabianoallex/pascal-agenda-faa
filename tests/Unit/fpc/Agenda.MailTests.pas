// The temporary directory, with its delimiter: GetTempDir is FPC's RTL only
// (Delphi: E2003), TPath.GetTempPath Delphi's.
function TempDir: string;
begin
  {$IFDEF FPC}
  Result := GetTempDir;
  {$ELSE}
  Result := TPath.GetTempPath;
  {$ENDIF}
  Result := IncludeTrailingPathDelimiter(Result);
end;

// The text of one encoded word, decoded ('' when it isn't one).
function DecodeWord(const AWord: string): string;
var
  LText: string;
  LBytes: TBytes;
  I: Integer;
begin
  Result := '';
  if (Copy(AWord, 1, 10) <> '=?UTF-8?B?') or (Copy(AWord, Length(AWord) - 1, 2) <> '?=') then
    Exit;
  LText := Copy(AWord, 11, Length(AWord) - 12);
  while (LText <> '') and (LText[Length(LText)] = '=') do
    Delete(LText, Length(LText), 1);
  for I := 1 to Length(LText) do
    if LText[I] = '+' then
      LText[I] := '-'
    else if LText[I] = '/' then
      LText[I] := '_';
  if PcBase64UrlDecode(LText, LBytes) then
    Result := string(TEncoding.UTF8.GetString(LBytes));
end;

function Sample: TMailMessage;
begin
  Result.From := 'Clínica São João <agenda@example.com>';
  Result.ToAddress := 'maria@example.com';
  Result.Subject := 'Confirmação: terça, 14:30';
  Result.TextBody := 'Olá, Maria.' + #10 + 'Até já.' + #10 +
    'See it: http://127.0.0.1:9400/public/demo/appointments/49d1f9898650265e763fdfea09125904' +
    '?exp=1799064000&sig=dev.3eAVR3zFXlV175biTxpXkyb3ZmJWlGwnMzfrFaaWTzY';
  Result.MessageId := 'e1@example.com';
  SetLength(Result.Headers, 1);
  Result.Headers[0] := 'X-Agenda-Event: e1';
end;

function Lines(const AText: string): TStringList;
begin
  Result := TStringList.Create;
  Result.Text := AText;
end;

procedure TMailTests.EncodeWords_Ascii_AsIs;
begin
  TAssert.AssertEquals('Booked: Haircut, Monday', MailEncodeWords('Booked: Haircut, Monday'));
end;

procedure TMailTests.EncodeWords_Accents_Utf8Base64;
begin
  // "Confirmação" in UTF-8, in Base64 (checked with Python's base64).
  TAssert.AssertEquals('=?UTF-8?B?Q29uZmlybWHDp8Ojbw==?=', MailEncodeWords('Confirmação'));
end;

procedure TMailTests.EncodeWords_Long_SplitBetweenCharacters;
var
  LText, LEncoded, LDecoded: string;
  LWords: TStringList;
  I: Integer;
begin
  LText := '';
  for I := 1 to 12 do
    LText := LText + 'ação ç ';
  LEncoded := MailEncodeWords(LText);
  LWords := TStringList.Create;
  try
    LWords.Delimiter := ' ';
    LWords.StrictDelimiter := True;
    LWords.DelimitedText := LEncoded;
    TAssert.AssertTrue('more than one word', LWords.Count > 1);
    LDecoded := '';
    for I := 0 to LWords.Count - 1 do
    begin
      TAssert.AssertTrue('a word within 75: ' + LWords[I], Length(LWords[I]) <= 75);
      // Each word decodes alone: no character was split between two.
      TAssert.AssertTrue('decodes: ' + LWords[I], DecodeWord(LWords[I]) <> '');
      LDecoded := LDecoded + DecodeWord(LWords[I]);
    end;
    TAssert.AssertEquals(LText, LDecoded);
  finally
    LWords.Free;
  end;
end;

procedure TMailTests.Address_FromEitherForm;
begin
  TAssert.AssertEquals('a@b.example', MailAddress('A B <a@b.example>'));
  TAssert.AssertEquals('a@b.example', MailAddress(' a@b.example '));
end;

procedure TMailTests.Mime_HeadersAndBody;
var
  LText: TStringList;
  LMime: string;
  I: Integer;
begin
  LMime := MailToMime(Sample, EncodeDate(2026, 10, 26));
  LText := Lines(LMime);
  try
    TAssert.AssertTrue('From', LText.IndexOf('From: ' + MailEncodeWords('Clínica São João') +
      ' <agenda@example.com>') >= 0);
    TAssert.AssertTrue('Subject', LText.IndexOf('Subject: ' +
      MailEncodeWords('Confirmação: terça, 14:30')) >= 0);
    TAssert.AssertTrue('To', LText.IndexOf('To: maria@example.com') >= 0);
    TAssert.AssertTrue('Message-ID', LText.IndexOf('Message-ID: <e1@example.com>') >= 0);
    TAssert.AssertTrue('a custom header', LText.IndexOf('X-Agenda-Event: e1') >= 0);
    TAssert.AssertTrue('UTF-8', Pos('charset=UTF-8', LMime) > 0);
    TAssert.AssertTrue('quoted-printable', LText.IndexOf('Content-Transfer-Encoding: ' +
      'quoted-printable') >= 0);
    // "Olá" and "Até" as their UTF-8 bytes.
    TAssert.AssertTrue('the body', LText.IndexOf('Ol=C3=A1, Maria.') >= 0);
    TAssert.AssertTrue('the second line', LText.IndexOf('At=C3=A9 j=C3=A1.') >= 0);
    // The link: "=" encoded, a soft break ("=" last) where it passes 76.
    TAssert.AssertTrue('the link', Pos('?exp=3D1799064000&sig=', StringReplace(LMime,
      '=' + #13#10, '', [rfReplaceAll])) > 0);
    for I := 0 to LText.Count - 1 do
    begin
      // RFC 2045's 76 for quoted-printable; the headers are folded to it too.
      TAssert.AssertTrue('a line within 76: ' + LText[I], Length(LText[I]) <= 76);
      // MailEncodeWords leaves printable ASCII alone, and only that.
      TAssert.AssertEquals('ASCII only', LText[I], MailEncodeWords(LText[I]));
    end;
  finally
    LText.Free;
  end;
end;

procedure TMailTests.Mime_LongAsciiSubject_Folded;
var
  LMessage: TMailMessage;
  LText: TStringList;
  LAt: Integer;
  LSubject: string;
begin
  LMessage := Sample;
  LMessage.Subject := 'Reminder: Coloring and cut with Elisa Prado, Wednesday, 30 December 2026, 09:00';
  LText := Lines(MailToMime(LMessage, EncodeDate(2026, 10, 26)));
  try
    LAt := 0;
    while (LAt < LText.Count) and (Copy(LText[LAt], 1, 9) <> 'Subject: ') do
      Inc(LAt);
    TAssert.AssertTrue('a Subject', LAt < LText.Count);
    // Unfolded (RFC 5322: a line break before a space or tab is removed),
    // the subject as it was; folded, short lines.
    LSubject := Copy(LText[LAt], 10, MaxInt);
    TAssert.AssertTrue('folded', Length(LText[LAt]) < 78);
    Inc(LAt);
    while (LAt < LText.Count) and (Copy(LText[LAt], 1, 1) = ' ') do
    begin
      LSubject := LSubject + LText[LAt];
      Inc(LAt);
    end;
    TAssert.AssertEquals(LMessage.Subject, LSubject);
    // One From (Synapse's MIME classes wrote an empty one of their own).
    LSubject := '';
    for LAt := 0 to LText.Count - 1 do
      if Copy(LText[LAt], 1, 5) = 'From:' then
        LSubject := LSubject + LText[LAt];
    TAssert.AssertEquals('one From line', 'From: ' + MailEncodeWords('Clínica São João') +
      ' <agenda@example.com>', LSubject);
  finally
    LText.Free;
  end;
end;

procedure TMailTests.SendWithoutRecipient;
var
  LMessage: TMailMessage;
begin
  LMessage := Sample;
  LMessage.ToAddress := '';
  MailToMime(LMessage, Now);
end;

procedure TMailTests.Mime_NoRecipient_Raises;
begin
  TAssert.AssertException(EMailError, SendWithoutRecipient);
end;

procedure TMailTests.Eml_OneFilePerMessage;
var
  LDir: string;
  LSender: IMailSender;
  LFound: TSearchRec;
  LCount: Integer;
  LText: TStringList;
begin
  LDir := TempDir + 'agenda-mail-' +
    LowerCase(PcBytesToHex(PcRandomBytes(6)));
  LSender := TEmlMailSender.Create(LDir);
  LSender.Send(Sample);
  LSender.Send(Sample);
  LCount := 0;
  LText := TStringList.Create;
  try
    if FindFirst(IncludeTrailingPathDelimiter(LDir) + '*', faAnyFile, LFound) = 0 then
    try
      repeat
        if (LFound.Attr and faDirectory) = 0 then
        begin
          TAssert.AssertEquals('an .eml, no temporary left', '.eml',
            ExtractFileExt(LFound.Name));
          LText.LoadFromFile(IncludeTrailingPathDelimiter(LDir) + LFound.Name);
          TAssert.AssertTrue('the message', LText.IndexOf('To: maria@example.com') >= 0);
          DeleteFile(IncludeTrailingPathDelimiter(LDir) + LFound.Name);
          Inc(LCount);
        end;
      until FindNext(LFound) <> 0;
    finally
      FindClose(LFound);
    end;
  finally
    LText.Free;
    RemoveDir(LDir);
  end;
  TAssert.AssertEquals(2, LCount);
end;

initialization
  RegisterTest(TMailTests);

end.
