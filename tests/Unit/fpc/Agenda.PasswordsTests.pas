unit Agenda.PasswordsTests;

{$mode delphi}{$H+}

{ GENERATED FILE — produced by tools/gen_fpc_mirror.py from
  tests/Unit/Agenda.PasswordsTests.pas (DUnitX). Do not edit by hand: edit the DUnitX
  master and run the script again. }

{ Tests for Agenda.Passwords: PBKDF2-HMAC-SHA256 against published vectors,
  the stored form, Verify on anything a database could hold, NeedsRehash.

  Vectors: RFC 7914 section 11 (PBKDF2-HMAC-SHA256, 64 bytes) and the
  widely used "password"/"salt" set; each one, and the stored forms below,
  recomputed with Python's hashlib.pbkdf2_hmac (2026-10-18). The password of
  100 bytes checks the key longer than HMAC's block (hashed once first).

  DUnitX master. The FPCUnit mirror (tests/Unit/fpc) is generated by
  tools/gen_fpc_mirror.py; never edit the mirror by hand. }

interface

uses
  fpcunit, testregistry,
  SysUtils,
  PascalCommon.Crypto,
  PascalApi.Text,
  Agenda.Passwords;

type
  TPasswordsTests = class(TTestCase)
  published
    procedure Pbkdf2_Rfc7914;
    procedure Pbkdf2_PasswordSaltVectors;
    procedure Pbkdf2_LengthNotAMultipleOfTheDigest;
    procedure Pbkdf2_KeyLongerThanTheBlock;
    procedure Pbkdf2_RejectsBadArguments;
    procedure HashWithSalt_StoredForm;
    procedure HashWithSalt_NonAsciiIsUtf8;
    procedure Hash_VerifiesItsPassword;
    procedure Hash_NewSaltEachTime;
    procedure Hash_RejectsEmptyAndTooLong;
    procedure Hash_RejectsIterationsOutOfRange;
    procedure Verify_WrongPassword;
    procedure Verify_FalseForWhatItCannotRead;
    procedure NeedsRehash_FollowsIterations;
  end;

implementation

const
  // Typed constants: FPC warns (4104/4105) on a non-ASCII literal in an
  // expression.
  SAO_PAULO: string = 'São Paulo → ok';
  SAO_PAULO_STORED = '$pbkdf2-sha256$i=3$c2FsdA$PuV9Tx2FEsKy52wl3cJ619vagJ52I9Gn1oyOYBs_0AE';
  SECRET_STORED = '$pbkdf2-sha256$i=1000$AAAAAAAAAAAAAAAAAAAAAA$AkYsQLg1WVW2sQ8m-tSg6vMnKdmKRLxP8_X30HK_IPU';
  // Few iterations: these tests check behavior, not cost.
  FAST = 1000;

function Bytes(const AText: string): TBytes;
begin
  Result := PaStringToUtf8Bytes(AText);
end;

function ZeroBytes(ACount: Integer): TBytes;
begin
  Result := nil;
  SetLength(Result, ACount);
  FillChar(Result[0], ACount, 0);
end;

function Hex(const ABytes: TBytes): string;
begin
  Result := LowerCase(PcBytesToHex(ABytes));
end;

function Pbkdf2Hex(const APassword, ASalt: string; AIterations, ALength: Integer): string;
begin
  Result := Hex(TPasswords.Pbkdf2Sha256(Bytes(APassword), Bytes(ASalt), AIterations, ALength));
end;

// The exception class name, or '' when nothing was raised (no closures on FPC).
function Pbkdf2Raises(AIterations, ALength: Integer): string;
begin
  Result := '';
  try
    TPasswords.Pbkdf2Sha256(Bytes('p'), Bytes('s'), AIterations, ALength);
  except
    on E: Exception do
      Result := E.ClassName;
  end;
end;

function HashRaises(const APassword: string; AIterations: Integer): string;
begin
  Result := '';
  try
    TPasswords.Hash(APassword, AIterations);
  except
    on E: Exception do
      Result := E.ClassName;
  end;
end;

procedure TPasswordsTests.Pbkdf2_Rfc7914;
begin
  TAssert.AssertEquals('55ac046e56e3089fec1691c22544b605f94185216dde0465e68b9d57c20dacbc' +
    '49ca9cccf179b645991664b39d77ef317c71b845b1e30bd509112041d3a19783',
    Pbkdf2Hex('passwd', 'salt', 1, 64));
  TAssert.AssertEquals('4ddcd8f60b98be21830cee5ef22701f9641a4418d04c0414aeff08876b34ab56' +
    'a1d425a1225833549adb841b51c9b3176a272bdebba1d078478f62b397f33c8d',
    Pbkdf2Hex('Password', 'NaCl', 80000, 64));
end;

procedure TPasswordsTests.Pbkdf2_PasswordSaltVectors;
begin
  TAssert.AssertEquals('120fb6cffcf8b32c43e7225256c4f837a86548c92ccc35480805987cb70be17b',
    Pbkdf2Hex('password', 'salt', 1, 32));
  TAssert.AssertEquals('ae4d0c95af6b46d32d0adff928f06dd02a303f8ef3c251dfd6e2d85a95474c43',
    Pbkdf2Hex('password', 'salt', 2, 32));
  TAssert.AssertEquals('c5e478d59288c841aa530db6845c4c8d962893a001ce4e11a4963873aa98134a',
    Pbkdf2Hex('password', 'salt', 4096, 32));
end;

procedure TPasswordsTests.Pbkdf2_LengthNotAMultipleOfTheDigest;
begin
  TAssert.AssertEquals('348c89dbcbd32b2f32d814b8116e84cf2b17347ebc1800181c4e2a1fb8dd53e1' +
    'c635518c7dac47e9',
    Pbkdf2Hex('passwordPASSWORDpassword', 'saltSALTsaltSALTsaltSALTsaltSALTsalt', 4096, 40));
end;

procedure TPasswordsTests.Pbkdf2_KeyLongerThanTheBlock;
begin
  TAssert.AssertEquals('d43a18cd77bafc1a4b0c6025dbbf29c7e6d67acce6ad02a736d4a3003b6a3c26',
    Pbkdf2Hex(StringOfChar('x', 100), 'salt', 2, 32));
end;

procedure TPasswordsTests.Pbkdf2_RejectsBadArguments;
begin
  TAssert.AssertEquals('EArgumentException', Pbkdf2Raises(0, 32));
  TAssert.AssertEquals('EArgumentException', Pbkdf2Raises(1, 0));
  TAssert.AssertEquals('', Pbkdf2Raises(1, 1));
end;

procedure TPasswordsTests.HashWithSalt_StoredForm;
begin
  TAssert.AssertEquals(SECRET_STORED,
    TPasswords.HashWithSalt('secret', ZeroBytes(16), 1000));
end;

procedure TPasswordsTests.HashWithSalt_NonAsciiIsUtf8;
begin
  TAssert.AssertEquals(SAO_PAULO_STORED, TPasswords.HashWithSalt(SAO_PAULO, Bytes('salt'), 3));
  TAssert.AssertTrue(TPasswords.Verify(SAO_PAULO, SAO_PAULO_STORED));
end;

procedure TPasswordsTests.Hash_VerifiesItsPassword;
var
  LStored: string;
begin
  LStored := TPasswords.Hash('correct horse', FAST);
  TAssert.AssertEquals('$pbkdf2-sha256$i=1000$', Copy(LStored, 1, 22));
  TAssert.AssertTrue(TPasswords.Verify('correct horse', LStored));
  TAssert.AssertTrue(TPasswords.Verify('secret', SECRET_STORED));
end;

procedure TPasswordsTests.Hash_NewSaltEachTime;
begin
  TAssert.AssertFalse(TPasswords.Hash('same', FAST) = TPasswords.Hash('same', FAST));
end;

procedure TPasswordsTests.Hash_RejectsEmptyAndTooLong;
begin
  TAssert.AssertEquals('EPasswordError', HashRaises('', FAST));
  TAssert.AssertEquals('EPasswordError', HashRaises(StringOfChar('a', MAX_PASSWORD_BYTES + 1), FAST));
  TAssert.AssertEquals('', HashRaises(StringOfChar('a', MAX_PASSWORD_BYTES), FAST));
end;

procedure TPasswordsTests.Hash_RejectsIterationsOutOfRange;
begin
  TAssert.AssertEquals('EArgumentException', HashRaises('p', 0));
  TAssert.AssertEquals('EArgumentException', HashRaises('p', MAX_PASSWORD_ITERATIONS + 1));
end;

procedure TPasswordsTests.Verify_WrongPassword;
begin
  TAssert.AssertFalse(TPasswords.Verify('Secret', SECRET_STORED));
  TAssert.AssertFalse(TPasswords.Verify('secret ', SECRET_STORED));
  TAssert.AssertFalse(TPasswords.Verify('', SECRET_STORED));
  TAssert.AssertFalse(TPasswords.Verify(StringOfChar('a', MAX_PASSWORD_BYTES + 1), SECRET_STORED));
end;

procedure TPasswordsTests.Verify_FalseForWhatItCannotRead;
const
  SALT = '$AAAAAAAAAAAAAAAAAAAAAA';
  HASH = '$AkYsQLg1WVW2sQ8m-tSg6vMnKdmKRLxP8_X30HK_IPU';
begin
  TAssert.AssertFalse('empty', TPasswords.Verify('secret', ''));
  TAssert.AssertFalse('plain text', TPasswords.Verify('secret', 'secret'));
  TAssert.AssertFalse('another scheme',
    TPasswords.Verify('secret', '$2b$12$abcdefghijklmnopqrstuuJ0J5bq3XK3V0ZQ5rR1h8m1Q3Q5Q5Q5Q'));
  TAssert.AssertFalse('scheme case', TPasswords.Verify('secret', '$PBKDF2-SHA256$i=1000' + SALT + HASH));
  TAssert.AssertFalse('no hash', TPasswords.Verify('secret', '$pbkdf2-sha256$i=1000' + SALT));
  TAssert.AssertFalse('empty hash', TPasswords.Verify('secret', '$pbkdf2-sha256$i=1000' + SALT + '$'));
  TAssert.AssertFalse('extra field', TPasswords.Verify('secret', SECRET_STORED + '$x'));
  TAssert.AssertFalse('no i=', TPasswords.Verify('secret', '$pbkdf2-sha256$1000' + SALT + HASH));
  TAssert.AssertFalse('zero iterations', TPasswords.Verify('secret', '$pbkdf2-sha256$i=0' + SALT + HASH));
  TAssert.AssertFalse('negative', TPasswords.Verify('secret', '$pbkdf2-sha256$i=-1' + SALT + HASH));
  TAssert.AssertFalse('hex iterations', TPasswords.Verify('secret', '$pbkdf2-sha256$i=0x3E8' + SALT + HASH));
  TAssert.AssertFalse('too many', TPasswords.Verify('secret', '$pbkdf2-sha256$i=10000001' + SALT + HASH));
  TAssert.AssertFalse('huge', TPasswords.Verify('secret', '$pbkdf2-sha256$i=99999999999' + SALT + HASH));
  TAssert.AssertFalse('empty salt', TPasswords.Verify('secret', '$pbkdf2-sha256$i=1000$' + HASH));
  TAssert.AssertFalse('bad Base64', TPasswords.Verify('secret', '$pbkdf2-sha256$i=1000' + SALT + '$Ak*sQ'));
  TAssert.AssertFalse('short hash',
    TPasswords.Verify('secret', '$pbkdf2-sha256$i=1000' + SALT + '$AkYsQLg1WVW2sQ8m'));
end;

procedure TPasswordsTests.NeedsRehash_FollowsIterations;
begin
  TAssert.AssertFalse(TPasswords.NeedsRehash(SECRET_STORED, 1000));
  TAssert.AssertFalse(TPasswords.NeedsRehash(SECRET_STORED, 999));
  TAssert.AssertTrue(TPasswords.NeedsRehash(SECRET_STORED, 1001));
  TAssert.AssertTrue(TPasswords.NeedsRehash(SECRET_STORED));
  TAssert.AssertTrue('unreadable', TPasswords.NeedsRehash('secret', 1));
end;

initialization
  RegisterTest(TPasswordsTests);

end.
