function DayJson(const ARows: array of string): string;
var
  I: Integer;
begin
  Result := '{"date":"2026-11-02","timeZone":"America/Sao_Paulo","appointments":[';
  for I := 0 to High(ARows) do
  begin
    if I > 0 then
      Result := Result + ',';
    Result := Result + ARows[I];
  end;
  Result := Result + ']}';
end;

function Row(const AId, AStatus: string; AVersion: Integer; const AStartsAt: string): string;
begin
  Result := Format('{"id":"%s","startsAt":"%s","endsAt":"%s","localStart":"x","localEnd":"y",' +
    '"status":"%s","version":%d,"professionalId":"p1","professionalName":"Ana",' +
    '"serviceId":"s1","serviceName":"Corte","customerId":"c1","customerName":"Bia"}',
    [AId, AStartsAt, AStartsAt, AStatus, AVersion]);
end;

{ TProbeTask }

procedure TProbeTask.Run;
begin
  RunThread := TThread.CurrentThread.ThreadID;
  if RaiseInRun then
    raise EHttpTransport.Create('gone');
end;

procedure TProbeTask.Done;
begin
  if DoneOnMain <> nil then
    DoneOnMain^ := TThread.CurrentThread.ThreadID = MainThreadID;
  Inc(DoneCalls^);
end;

