procedure TDesktopTests.Runner_Manual_RunThenDone_Failure_Forget;
var
  LTask: TProbeTask;
  LDone: Integer;
  LOwner: TObject;
begin
  LDone := 0;
  LOwner := TObject.Create;
  try
    LTask := TProbeTask.Create(LOwner);
    LTask.DoneCalls := @LDone;
    FRunner.Start(LTask);
    TAssert.AssertEquals(1, FRunner.Pending);
    TAssert.AssertEquals(0, LDone);
    TAssert.AssertEquals(1, FManual.RunPending);
    TAssert.AssertEquals(1, LDone);
    TAssert.AssertEquals(0, FRunner.Pending);

    // A Run that raises: Done still runs, with the failure.
    LTask := TProbeTask.Create(LOwner);
    LTask.DoneCalls := @LDone;
    LTask.RaiseInRun := True;
    FRunner.Start(LTask);
    TAssert.AssertTrue(FManual.RunOne);
    TAssert.AssertEquals(2, LDone);

    // Forgotten: Run, no Done.
    LTask := TProbeTask.Create(LOwner);
    LTask.DoneCalls := @LDone;
    FRunner.Start(LTask);
    FRunner.Forget(LOwner);
    TAssert.AssertTrue(FManual.RunOne);
    TAssert.AssertEquals(2, LDone);
    TAssert.AssertFalse(FManual.RunOne);
  finally
    LOwner.Free;
  end;
end;

procedure TDesktopTests.Runner_Pool_DoneOnTheMainThread;
var
  LPool: TPoolTaskRunner;
  LKeep: IUiTaskRunner;
  LTask: TProbeTask;
  LDone: Integer;
  LOnMain: Boolean;
  LRun: TThreadID;
begin
  LDone := 0;
  LOnMain := False;
  LPool := TPoolTaskRunner.Create;
  LKeep := LPool;
  LTask := TProbeTask.Create(Self);
  LTask.DoneCalls := @LDone;
  LTask.DoneOnMain := @LOnMain;
  LPool.Start(LTask);
  // Done waits for this thread (WaitIdle pumps CheckSynchronize), so the
  // task is alive until then.
  while LTask.RunThread = 0 do
    Sleep(1);
  LRun := LTask.RunThread;
  TAssert.AssertTrue(LRun <> MainThreadID);
  TAssert.AssertEquals(0, LDone);
  TAssert.AssertEquals(1, LKeep.Pending);
  TAssert.AssertTrue(LPool.WaitIdle(10000));
  TAssert.AssertEquals(1, LDone);
  TAssert.AssertTrue(LOnMain);
  TAssert.AssertEquals(0, LKeep.Pending);
  // Forgotten while running: no Done.
  LTask := TProbeTask.Create(Self);
  LTask.DoneCalls := @LDone;
  LPool.Start(LTask);
  LPool.Forget(Self);
  TAssert.AssertTrue(LPool.WaitIdle(10000));
  TAssert.AssertEquals(1, LDone);
end;

procedure TDesktopTests.Errors_Kinds;
var
  LFields: TPcFieldErrors;
  LReply: TApiReply;
  E: Exception;
  LError: TUiError;

  function Api(AStatus: Integer; const ABody: string): TUiError;
  var
    LApi: EApiError;
  begin
    LReply.Status := AStatus;
    LReply.Body := ABody;
    LReply.Headers := nil;
    LApi := EApiError.CreateFromResponse(TApiCall.Create('GET', '/x'), LReply);
    try
      Result := UiErrorOf(LApi);
    finally
      LApi.Free;
    end;
  end;

begin
  SetLength(LFields, 1);
  LFields[0].Field := 'name';
  LFields[0].Code := 'too_long';
  LFields[0].Message := 'Too long.';
  E := EPcValidationError.Create(LFields);
  try
    LError := UiErrorOf(E);
  finally
    E.Free;
  end;
  TAssert.AssertTrue(LError.Kind = ekInvalid);
  TAssert.AssertEquals('Too long.', LError.FieldText('name'));
  TAssert.AssertEquals('', LError.FieldText('phone'));

  LError := Api(400, '{"error":"bad","code":"invalid_fields","fields":[' +
    '{"field":"a","code":"x","message":"A."},{"field":"b","code":"y","message":"B."}]}');
  TAssert.AssertTrue(LError.Kind = ekInvalid);
  TAssert.AssertEquals(TEXT_CHECK_FIELDS, LError.Text);
  TAssert.AssertEquals('B.', LError.FieldText('b'));
  TAssert.AssertTrue(Api(401, '').Kind = ekSession);
  TAssert.AssertEquals(TEXT_SESSION, Api(401, '').Text);
  TAssert.AssertTrue(Api(409, '{"error":"taken","code":"slot_unavailable"}').Kind = ekConflict);
  TAssert.AssertEquals('slot_unavailable', Api(409, '{"error":"taken","code":"slot_unavailable"}').Code);
  TAssert.AssertTrue(Api(412, '').Kind = ekConflict);
  LError := Api(403, '{"error":"Only the owner.","code":"owner_only"}');
  TAssert.AssertTrue(LError.Kind = ekRefused);
  TAssert.AssertEquals('Only the owner.', LError.Text);
  LError := Api(503, '');
  TAssert.AssertTrue(LError.Kind = ekServer);
  TAssert.AssertEquals(Format(TEXT_SERVER, [503]), LError.Text);
  E := EHttpTransport.Create('refused');
  try
    TAssert.AssertTrue(UiErrorOf(E).Kind = ekOffline);
  finally
    E.Free;
  end;
  E := Exception.Create('odd');
  try
    TAssert.AssertTrue(UiErrorOf(E).Kind = ekOther);
    TAssert.AssertEquals('odd', UiErrorOf(E).Text);
  finally
    E.Free;
  end;
end;

procedure TDesktopTests.Login_Submit_HandsTheClient;
var
  LModel: TLoginModel;
  LClient: TAgendaClient;
begin
  LModel := TLoginModel.Create(FRunner, FTransport, 'agenda.test:9400');
  try
    LModel.OnChange := Note;
    LModel.OnLoggedIn := NoteLoggedIn;
    TAssert.AssertEquals('http://agenda.test:9400', LModel.ServerUrl);
    TAssert.AssertFalse(LModel.CanSubmit);
    LModel.Tenant := 'demo';
    LModel.Email := ' staff@demo.test ';
    TAssert.AssertFalse(LModel.CanSubmit);
    LModel.Password := 'secret';
    TAssert.AssertTrue(LModel.CanSubmit);
    FFake.Answer(200, TOKENS);
    FFake.Answer(200, ME_STAFF);
    LModel.Submit;
    TAssert.AssertTrue(LModel.Busy);
    TAssert.AssertFalse(LModel.CanSubmit);
    TAssert.AssertEquals(0, FFake.RequestCount);
    FManual.RunPending;
    TAssert.AssertFalse(LModel.Busy);
    TAssert.AssertTrue(LModel.Error.IsNone);
    TAssert.AssertEquals('staff', LModel.Role);
    TAssert.AssertEquals('', LModel.Password);
    TAssert.AssertEquals('http://agenda.test:9400/auth/login', FFake.Request(0).Url);
    TAssert.AssertEquals('{"tenant":"demo","email":"staff@demo.test","password":"secret"}',
      FFake.Request(0).Body);
    TAssert.AssertTrue(Pos('L', FEvents) > 0);
    LClient := LModel.TakeClient;
    try
      TAssert.AssertTrue(LClient <> nil);
      TAssert.AssertTrue(LClient.LoggedIn);
      TAssert.AssertTrue(LModel.TakeClient = nil);
    finally
      LClient.Free;
    end;
  finally
    LModel.Free;
  end;
end;

procedure TDesktopTests.Login_Wrong_Offline;
var
  LModel: TLoginModel;
begin
  LModel := TLoginModel.Create(FRunner, FTransport, 'http://agenda.test');
  try
    LModel.Tenant := 'demo';
    LModel.Email := 'staff@demo.test';
    LModel.Password := 'wrong';
    FFake.Answer(401, '{"error":"Invalid email or password.","code":"invalid_credentials"}');
    LModel.Submit;
    FManual.RunPending;
    TAssert.AssertTrue(LModel.Error.Kind = ekRefused);
    TAssert.AssertEquals(TEXT_WRONG_LOGIN, LModel.Error.Text);
    TAssert.AssertEquals('wrong', LModel.Password);
    TAssert.AssertTrue(LModel.TakeClient = nil);

    FFake.Fail;
    LModel.Submit;
    FManual.RunPending;
    TAssert.AssertTrue(LModel.Error.Kind = ekOffline);
    TAssert.AssertTrue(LModel.TakeClient = nil);
  finally
    LModel.Free;
  end;
end;

procedure TDesktopTests.Login_Again_SameClient;
var
  LModel: TLoginModel;
begin
  LogIn;
  // The session lost: the refresh refused.
  FFake.Answer(401, '');
  FFake.Answer(401, '');
  try
    FClient.Me;
  except
    on EApiError do ;
  end;
  TAssert.AssertTrue(FClient.SessionLost);
  LModel := TLoginModel.CreateAgain(FRunner, FClient, 'demo', 'staff@demo.test');
  try
    LModel.OnLoggedIn := NoteLoggedIn;
    TAssert.AssertTrue(LModel.Again);
    TAssert.AssertEquals('http://agenda.test', LModel.Server);
    TAssert.AssertEquals('demo', LModel.Tenant);
    TAssert.AssertFalse(LModel.CanSubmit);
    LModel.Password := 'secret';
    FFake.Answer(200, '{"accessToken":"acc9","tokenType":"Bearer","expiresIn":900,"refreshToken":"ref9"}');
    FFake.Answer(200, ME_STAFF);
    LModel.Submit;
    FManual.RunPending;
    TAssert.AssertEquals('L', FEvents);
    TAssert.AssertTrue(LModel.TakeClient = nil);
  finally
    LModel.Free;
  end;
  // The screens' client, logged in again.
  TAssert.AssertFalse(FClient.SessionLost);
  TAssert.AssertEquals('ref9', FClient.Session.RefreshToken);
end;

procedure TDesktopTests.Day_Open_Select_FollowsTheId;
var
  LModel: TDayModel;
begin
  LogIn;
  LModel := TDayModel.Create(FRunner, FClient, JsonStrToDateTime('2026-11-02T10:00:00'));
  try
    LModel.OnChange := Note;
    FFake.Answer(200, PROFESSIONALS);
    FFake.Answer(200, DayJson([Row('a1', 'booked', 1, '2026-11-02T12:00:00Z'),
      Row('a2', 'confirmed', 2, '2026-11-02T13:00:00Z')]));
    LModel.Open;
    TAssert.AssertTrue(LModel.Busy);
    TAssert.AssertTrue(LModel.Loading);
    FManual.RunPending;
    TAssert.AssertFalse(LModel.Busy);
    TAssert.AssertEquals(1, Length(LModel.Professionals));
    TAssert.AssertEquals(2, Length(LModel.Rows));
    TAssert.AssertEquals('America/Sao_Paulo', LModel.TimeZone);
    TAssert.AssertEquals('http://agenda.test/agenda/day?date=2026-11-02', FFake.Request(2).Url);
    LModel.Select(1);
    TAssert.AssertEquals('a2', LModel.Selected.Id);
    // Read again: a1 gone, a2 now first; the selection stays on a2.
    FFake.Answer(200, DayJson([Row('a2', 'confirmed', 2, '2026-11-02T13:00:00Z'),
      Row('a3', 'booked', 1, '2026-11-02T14:00:00Z')]));
    LModel.Reload;
    FManual.RunPending;
    TAssert.AssertEquals(0, LModel.SelectedIndex);
    TAssert.AssertEquals('a2', LModel.Selected.Id);
    // The selected one gone: nothing selected.
    FFake.Answer(200, DayJson([Row('a3', 'booked', 1, '2026-11-02T14:00:00Z')]));
    LModel.Reload;
    FManual.RunPending;
    TAssert.AssertTrue(LModel.Selected = nil);
    // Another professional, the next day.
    FFake.Answer(200, DayJson([]));
    LModel.SetProfessional('p1');
    FFake.Answer(200, DayJson([]));
    LModel.NextDay;
    FManual.RunPending;
    TAssert.AssertEquals('2026-11-03', LModel.DateText);
    TAssert.AssertEquals('http://agenda.test/agenda/day?date=2026-11-03&professional=p1',
      FFake.Request(FFake.RequestCount - 1).Url);
  finally
    LModel.Free;
  end;
end;

procedure TDesktopTests.Day_OldReadDropped_TickSkippedWhileBusy;
var
  LModel: TDayModel;
begin
  LogIn;
  LModel := TDayModel.Create(FRunner, FClient, JsonStrToDateTime('2026-11-02T10:00:00'));
  try
    FFake.Answer(200, DayJson([Row('old', 'booked', 1, '2026-11-02T12:00:00Z')]));
    FFake.Answer(200, DayJson([Row('new', 'booked', 1, '2026-11-02T12:00:00Z')]));
    LModel.Reload;
    LModel.Reload;
    // A tick while reads run: nothing more.
    LModel.Tick;
    TAssert.AssertEquals(2, FRunner.Pending);
    TAssert.AssertTrue(FManual.RunOne);
    // The first answer is old: dropped, still loading.
    TAssert.AssertEquals(0, Length(LModel.Rows));
    TAssert.AssertTrue(LModel.Loading);
    TAssert.AssertTrue(FManual.RunOne);
    TAssert.AssertEquals('new', LModel.Rows[0].Id);
    TAssert.AssertFalse(LModel.Loading);
    TAssert.AssertFalse(LModel.Busy);
    // Idle: a tick reads again.
    FFake.Answer(200, DayJson([]));
    LModel.Tick;
    TAssert.AssertEquals(1, FRunner.Pending);
    FManual.RunPending;
    TAssert.AssertEquals(0, Length(LModel.Rows));
  finally
    LModel.Free;
  end;
end;

procedure TDesktopTests.Day_Confirm_IfMatch_ThenReadAgain;
var
  LModel: TDayModel;
  LSent: TTransportRequest;
begin
  LogIn;
  LModel := TDayModel.Create(FRunner, FClient, JsonStrToDateTime('2026-11-02T10:00:00'));
  try
    FFake.Answer(200, DayJson([Row('a1', 'booked', 4, '2026-11-02T15:00:00Z')]));
    LModel.Reload;
    FManual.RunPending;
    LModel.Select(0);
    TAssert.AssertTrue(LModel.CanConfirm);
    FFake.Answer(200, StringReplace(APPOINTMENT, '"booked","version":1', '"confirmed","version":5', []));
    FFake.Answer(200, DayJson([Row('a1', 'confirmed', 5, '2026-11-02T15:00:00Z')]));
    LModel.Confirm;
    TAssert.AssertFalse(LModel.CanConfirm);
    TAssert.AssertFalse(LModel.CanCancel);
    FManual.RunPending;
    LSent := FFake.Request(2);
    TAssert.AssertEquals('PATCH', LSent.Method);
    TAssert.AssertEquals('http://agenda.test/appointments/a1', LSent.Url);
    TAssert.AssertEquals('"4"', LSent.Header('If-Match'));
    TAssert.AssertEquals('{"status":"confirmed"}', LSent.Body);
    TAssert.AssertEquals(STATUS_CONFIRMED, LModel.Selected.Status);
    TAssert.AssertEquals(5, LModel.Selected.Version);
    TAssert.AssertTrue(LModel.CanCancel);
    TAssert.AssertFalse(LModel.CanConfirm);
  finally
    LModel.Free;
  end;
end;

procedure TDesktopTests.Day_ChangedFirst_Notice_ReadAgain;
var
  LModel: TDayModel;
begin
  LogIn;
  LModel := TDayModel.Create(FRunner, FClient, JsonStrToDateTime('2026-11-02T10:00:00'));
  try
    FFake.Answer(200, DayJson([Row('a1', 'booked', 1, '2026-11-02T15:00:00Z')]));
    LModel.Reload;
    FManual.RunPending;
    LModel.Select(0);
    FFake.Answer(412, '{"error":"changed","code":"precondition_failed"}');
    FFake.Answer(200, DayJson([Row('a1', 'cancelled', 2, '2026-11-02T15:00:00Z')]));
    LModel.Cancel;
    FManual.RunPending;
    TAssert.AssertEquals('POST', FFake.Request(2).Method);
    TAssert.AssertEquals(TEXT_CHANGED_FIRST, LModel.Notice);
    TAssert.AssertTrue(LModel.Error.IsNone);
    TAssert.AssertEquals(STATUS_CANCELLED, LModel.Selected.Status);
    TAssert.AssertFalse(LModel.CanCancel);
    // A server failure on a change: shown, the day not read again.
    FFake.Answer(200, DayJson([Row('a2', 'booked', 1, '2026-11-02T15:00:00Z')]));
    LModel.Reload;
    FManual.RunPending;
    TAssert.AssertEquals('', LModel.Notice);
    LModel.Select(0);
    FFake.Answer(500, '');
    LModel.Confirm;
    FManual.RunPending;
    TAssert.AssertTrue(LModel.Error.Kind = ekServer);
    TAssert.AssertEquals(0, FFake.Pending);
    TAssert.AssertTrue(LModel.CanConfirm);
  finally
    LModel.Free;
  end;
end;

procedure TDesktopTests.Day_WhatTheSelectionAllows;
var
  LModel: TDayModel;
begin
  LogIn;
  LModel := TDayModel.Create(FRunner, FClient, JsonStrToDateTime('2026-11-02T10:00:00'));
  try
    LModel.Clock := TestClock;
    FFake.Answer(200, DayJson([Row('a1', 'booked', 1, '2026-11-02T12:00:00Z'),
      Row('a2', 'confirmed', 1, '2026-11-02T12:00:01Z'), Row('a3', 'done', 1, '2026-11-02T11:00:00Z')]));
    LModel.Reload;
    FManual.RunPending;
    TAssert.AssertFalse(LModel.CanConfirm);
    TAssert.AssertFalse(LModel.CanCancel);
    // Booked, starting now (12:00:00 UTC): everything.
    LModel.Select(0);
    TAssert.AssertTrue(LModel.CanConfirm);
    TAssert.AssertTrue(LModel.CanCancel);
    TAssert.AssertTrue(LModel.CanMarkDone);
    TAssert.AssertTrue(LModel.CanMarkNoShow);
    // Confirmed, a second from now: not started.
    LModel.Select(1);
    TAssert.AssertFalse(LModel.CanConfirm);
    TAssert.AssertTrue(LModel.CanCancel);
    TAssert.AssertFalse(LModel.CanMarkDone);
    FNow := FNow + 2 / SecsPerDay;
    TAssert.AssertTrue(LModel.CanMarkDone);
    TAssert.AssertTrue(LModel.CanMove);
    // Done: nothing.
    LModel.Select(2);
    TAssert.AssertFalse(LModel.CanMove);
    TAssert.AssertFalse(LModel.CanConfirm);
    TAssert.AssertFalse(LModel.CanCancel);
    TAssert.AssertFalse(LModel.CanMarkNoShow);
    // Nothing allowed means nothing sent.
    LModel.Confirm;
    TAssert.AssertEquals(0, FRunner.Pending);
  finally
    LModel.Free;
  end;
end;

