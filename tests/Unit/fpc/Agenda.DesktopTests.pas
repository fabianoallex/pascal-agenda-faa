// A user action's spans: day.load (from the click to the screen updated),
// its run on the pool, the GET inside; a failure marks the three.
procedure TDesktopTests.Spans_Action_Run_Call;
var
  LRecorder: TSpanRecorder;
  LModel: TDayModel;
  LSpans: TPcSpanDataArray;
  LRequests: TArray<TTransportRequest>;
begin
  LogIn;
  LRecorder := StartTestTracing;
  try
    LModel := TDayModel.Create(FRunner, FClient, JsonStrToDateTime('2026-11-02T10:00:00'));
    try
      FFake.Answer(200, DayJson([Row('a1', 'booked', 4, '2026-11-02T15:00:00Z')]));
      LModel.Reload;
      FManual.RunPending;
      FFake.Answer(500, '{"error":"boom"}');
      LModel.Reload;
      FManual.RunPending;
      TAssert.AssertFalse(LModel.Error.IsNone);
    finally
      LModel.Free;
    end;
    TPcTracing.FlushNow;
    LSpans := LRecorder.Spans;
    LRequests := FFake.Requests;
    TAssert.AssertEquals(6, Length(LSpans));
    TAssert.AssertEquals('GET', LSpans[0].Name);
    TAssert.AssertEquals('run', LSpans[1].Name);
    TAssert.AssertEquals('day.load', LSpans[2].Name);
    TAssert.AssertEquals('', LSpans[2].ParentSpanId);
    TAssert.AssertEquals(LSpans[2].SpanId, LSpans[1].ParentSpanId);
    TAssert.AssertEquals(LSpans[1].SpanId, LSpans[0].ParentSpanId);
    TAssert.AssertEquals(LSpans[2].TraceId, LSpans[0].TraceId);
    TAssert.AssertEquals(LSpans[2].TraceId, LSpans[1].TraceId);
    TAssert.AssertEquals('00-' + LSpans[0].TraceId + '-' + LSpans[0].SpanId + '-01',
      LRequests[1].Header('traceparent'));
    TAssert.AssertTrue(LSpans[2].Status = ssUnset);
    // The second action: a trace of its own, failed.
    TAssert.AssertEquals('day.load', LSpans[5].Name);
    TAssert.AssertFalse(LSpans[5].TraceId = LSpans[2].TraceId);
    TAssert.AssertTrue(LSpans[3].Status = ssError);
    TAssert.AssertTrue(LSpans[4].Status = ssError);
    TAssert.AssertTrue(LSpans[5].Status = ssError);
    TAssert.AssertTrue(TPcTracing.Current = nil);
  finally
    TPcTracing.Shutdown;
  end;
end;

