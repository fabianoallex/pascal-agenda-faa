procedure TDesktopTests.Booking_NoAnswer_SameKeyAgain;
var
  LModel: TBookingModel;
  LKey: string;
begin
  LogIn;
  LModel := TBookingModel.Create(FRunner, FClient, JsonStrToDateTime('2026-11-02T00:00:00'));
  try
    LModel.SetService('s1');
    FFake.Answer(200, SLOTS);
    LModel.SetProfessional('p1');
    FManual.RunPending;
    LModel.SelectSlot(0);
    LModel.SelectCustomer('c1');
    LKey := LModel.Key;
    // Three lost tries (the client's retries with the key): no answer.
    FFake.Fail;
    FFake.Fail;
    FFake.Fail;
    LModel.Book;
    FManual.RunPending;
    TAssert.AssertTrue(LModel.Error.Kind = ekOffline);
    TAssert.AssertEquals(LKey, LModel.Key);
    TAssert.AssertTrue(LModel.CanBook);
    // Pressed again: the same key (the server replays if one try got there).
    FFake.Answer(201, APPOINTMENT);
    LModel.Book;
    FManual.RunPending;
    TAssert.AssertEquals(LKey, FFake.Request(FFake.RequestCount - 1).Header('Idempotency-Key'));
    TAssert.AssertEquals(LKey, FFake.Request(FFake.RequestCount - 2).Header('Idempotency-Key'));
    TAssert.AssertTrue(LModel.Error.IsNone);
    TAssert.AssertEquals('a9', LModel.Booked.Id);
  finally
    LModel.Free;
  end;
end;

