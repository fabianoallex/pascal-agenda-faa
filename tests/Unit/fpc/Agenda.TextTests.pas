{ Tests for Agenda.Text: phone numbers as typed, and their stored form; a
  list's search as its LIKE pattern, absent when nothing is left. The search
  key and the LIKE escaping moved to the libraries (PcFoldForSearch,
  PdbLikeContains), with their tests.

  DUnitX master. The FPCUnit mirror (tests/Unit/fpc) is generated by
  tools/gen_fpc_mirror.py; never edit the mirror by hand. }

interface

uses
  fpcunit, testregistry,
  SysUtils,
  PascalCommon.Optionals,
  Agenda.Text;

type
  TTextTests = class(TTestCase)
  published
    procedure Phone_DigitsAsTyped;
    procedure Phone_NotAPhone;
    procedure Phone_Normalized;
    procedure Phone_Length;
    procedure SearchPattern_Contains;
    procedure SearchPattern_AbsentOrEmpty_IsAbsent;
  end;

implementation

procedure TTextTests.Phone_DigitsAsTyped;
var
  LDigits: string;
begin
  TAssert.AssertTrue(TryPhoneDigits(' +55 (11) 9999-0000 ', LDigits));
  TAssert.AssertEquals('551199990000', LDigits);
  TAssert.AssertTrue(TryPhoneDigits('11.9999', LDigits));
  TAssert.AssertEquals('119999', LDigits);
  TAssert.AssertTrue(TryPhoneDigits('7', LDigits));
  TAssert.AssertEquals('7', LDigits);
end;

procedure TTextTests.Phone_NotAPhone;
var
  LDigits: string;
begin
  TAssert.AssertFalse(TryPhoneDigits('ana 99', LDigits));
  TAssert.AssertFalse(TryPhoneDigits('11+99', LDigits));
  TAssert.AssertFalse(TryPhoneDigits('( - )', LDigits));
  TAssert.AssertFalse(TryPhoneDigits('', LDigits));
  TAssert.AssertEquals('', LDigits);
end;

procedure TTextTests.Phone_Normalized;
begin
  TAssert.AssertEquals('+5511999990000', NormalizePhone('+55 (11) 99999-0000'));
  TAssert.AssertEquals('11999990000', NormalizePhone('(11) 99999.0000'));
  TAssert.AssertEquals('', NormalizePhone('call me'));
end;

procedure TTextTests.Phone_Length;
begin
  TAssert.AssertEquals('12345678', NormalizePhone('1234-5678'));
  TAssert.AssertEquals('', NormalizePhone('123-4567'));
  TAssert.AssertEquals('+123456789012345', NormalizePhone('+123456789012345'));
  TAssert.AssertEquals('', NormalizePhone('+1234567890123456'));
end;

procedure TTextTests.SearchPattern_Contains;
var
  LSearch, LPattern: IOptString;
begin
  LSearch := TOptNullString.From('ana');
  LPattern := SearchPattern(LSearch);
  TAssert.AssertTrue(LPattern.HasValue);
  TAssert.AssertEquals('%ana%', LPattern.Value);
  LSearch := TOptNullString.From('50%');
  TAssert.AssertEquals('the library escapes LIKE''s own characters', '%50!%%',
    SearchPattern(LSearch).Value);
end;

procedure TTextTests.SearchPattern_AbsentOrEmpty_IsAbsent;
var
  LSearch: IOptString;
begin
  LSearch := TOptNullString.Undefined;
  TAssert.AssertFalse('absent', SearchPattern(LSearch).HasValue);
  LSearch := TOptNullString.From('');
  TAssert.AssertFalse('nothing left (a search folded to empty)', SearchPattern(LSearch).HasValue);
end;

initialization
  RegisterTest(TTextTests);

end.
