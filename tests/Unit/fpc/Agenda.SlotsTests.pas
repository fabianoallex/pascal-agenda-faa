{ Tests for Agenda.Slots: working hours to instants in a tenant's zone
  (across New York's daylight-saving changes), joined spans, free starts
  around busy spans and a buffer, the local date and the local reading.

  Expected instants from Python's zoneinfo (tzdb 2026e), not from memory:
    2026-11-01 (Sunday): New York goes back, 02:00 EDT -> 01:00 EST (25 h);
    2027-03-14 (Sunday): New York goes forward, 02:00 EST -> 03:00 EDT (23 h).

  DUnitX master. The FPCUnit mirror (tests/Unit/fpc) is generated by
  tools/gen_fpc_mirror.py; never edit the mirror by hand. }

interface

uses
  fpcunit, testregistry,
  SysUtils,
  PascalCommon.TimeZones,
  Agenda.Times,
  Agenda.Slots;

type
  TSlotsTests = class(TTestCase)
  private
    function NewYork: IPcTimeZone;
  published
    procedure Date_Parses;
    procedure Date_Refuses;
    procedure Window_FallBackDay_Is25Hours;
    procedure Working_PlainDay;
    procedure Working_FallBack_FourHoursFromMidnightToThree;
    procedure Working_SpringForward_ThreeHoursFromMidnightToFour;
    procedure Working_StartInTheGap_IsTheJump;
    procedure Working_NightShift_JoinsAcrossMidnight;
    procedure Join_SortsAndMerges;
    procedure Slots_PlainDay;
    procedure Slots_FallBack_OneEveryRealHour;
    procedure Slots_NightShift_CrossMidnight_BelongToTheirDay;
    procedure Slots_Busy_WithBuffer;
    procedure Slots_NotBeforeNow;
    procedure Slots_NoWeek_NoSlots;
  end;

implementation

const
  // America/New_York, Unix seconds (Python zoneinfo).
  NY_2026_11_01_0000 = Int64(1793505600); // EDT
  NY_2026_11_01_0300 = Int64(1793520000); // EST: 4 h after midnight
  NY_2026_11_02_0000 = Int64(1793595600);
  NY_2026_11_02_0900 = Int64(1793628000);
  NY_2026_11_02_1000 = Int64(1793631600);
  NY_2026_11_02_1030 = Int64(1793633400);
  NY_2026_11_02_1040 = Int64(1793634000);
  NY_2026_11_02_2200 = Int64(1793674800);
  NY_2026_11_03_0000 = Int64(1793682000);
  NY_2026_11_03_0200 = Int64(1793689200);
  NY_2027_03_14_0000 = Int64(1805000400); // EST
  NY_2027_03_14_0300 = Int64(1805007600); // EDT, the jump
  NY_2027_03_14_0400 = Int64(1805011200); // 3 h after midnight
  NY_2027_03_14_0500 = Int64(1805014800);
  NY_2026_11_01_0130_EDT = Int64(1793511000);
  NY_2026_11_01_0130_EST = Int64(1793514600);
  HOUR = 3600;

function Interval(AWeekday, AFrom, ATo: Integer): TClockInterval;
begin
  Result.Weekday := AWeekday;
  Result.StartMinute := AFrom;
  Result.EndMinute := ATo;
end;

function Week(const AItems: array of TClockInterval): TClockIntervalArray;
var
  I: Integer;
begin
  Result := nil;
  SetLength(Result, Length(AItems));
  for I := 0 to High(AItems) do
    Result[I] := AItems[I];
end;

function Span(AStart, AEnd: Int64): TSpan;
begin
  Result.StartUtc := AStart;
  Result.EndUtc := AEnd;
end;

function Spans(const AItems: array of TSpan): TSpanArray;
var
  I: Integer;
begin
  Result := nil;
  SetLength(Result, Length(AItems));
  for I := 0 to High(AItems) do
    Result[I] := AItems[I];
end;

function TSlotsTests.NewYork: IPcTimeZone;
begin
  Result := PcTimeZones.Find('America/New_York');
end;

procedure TSlotsTests.Date_Parses;
var
  LDate: TPcLocalDateTime;
begin
  TAssert.AssertTrue(TryParseLocalDate('2026-11-01', LDate));
  TAssert.AssertEquals(2026, LDate.Year);
  TAssert.AssertEquals(11, LDate.Month);
  TAssert.AssertEquals(1, LDate.Day);
  TAssert.AssertEquals('Sunday', 7, LDate.IsoWeekday);
  TAssert.AssertTrue('a leap day', TryParseLocalDate('2028-02-29', LDate));
end;

procedure TSlotsTests.Date_Refuses;
var
  LDate: TPcLocalDateTime;
begin
  TAssert.AssertFalse('empty', TryParseLocalDate('', LDate));
  TAssert.AssertFalse('no such day', TryParseLocalDate('2026-02-29', LDate));
  TAssert.AssertFalse('month 13', TryParseLocalDate('2026-13-01', LDate));
  TAssert.AssertFalse('one digit', TryParseLocalDate('2026-1-01', LDate));
  TAssert.AssertFalse('with a time', TryParseLocalDate('2026-11-01T00:00', LDate));
  TAssert.AssertFalse('slashes', TryParseLocalDate('2026/11/01', LDate));
  TAssert.AssertFalse('a sign', TryParseLocalDate('+026-11-01', LDate));
end;

procedure TSlotsTests.Window_FallBackDay_Is25Hours;
var
  LFrom, LTo: Int64;
begin
  DaysWindow(NewYork, TPcLocalDateTime.Create(2026, 11, 1), 1, LFrom, LTo);
  TAssert.AssertEquals(NY_2026_11_01_0000, LFrom);
  TAssert.AssertEquals(NY_2026_11_02_0000, LTo);
  TAssert.AssertEquals('25 hours', Int64(25 * HOUR), LTo - LFrom);
  DaysWindow(NewYork, TPcLocalDateTime.Create(2026, 11, 1), 2, LFrom, LTo);
  TAssert.AssertEquals('two days', NY_2026_11_03_0000, LTo);
end;

procedure TSlotsTests.Working_PlainDay;
var
  LSpans: TSpanArray;
begin
  // Monday 09:00-12:00; the days around it have no hours.
  LSpans := WorkingSpans(NewYork, Week([Interval(1, 540, 720)]),
    TPcLocalDateTime.Create(2026, 11, 2), 1);
  TAssert.AssertEquals(1, Length(LSpans));
  TAssert.AssertEquals(NY_2026_11_02_0900, LSpans[0].StartUtc);
  TAssert.AssertEquals(NY_2026_11_02_0900 + 3 * HOUR, LSpans[0].EndUtc);
end;

procedure TSlotsTests.Working_FallBack_FourHoursFromMidnightToThree;
var
  LSpans: TSpanArray;
begin
  LSpans := WorkingSpans(NewYork, Week([Interval(7, 0, 180)]),
    TPcLocalDateTime.Create(2026, 11, 1), 1);
  TAssert.AssertEquals(1, Length(LSpans));
  TAssert.AssertEquals(NY_2026_11_01_0000, LSpans[0].StartUtc);
  TAssert.AssertEquals(NY_2026_11_01_0300, LSpans[0].EndUtc);
  TAssert.AssertEquals('01:00-02:00 happens twice', Int64(4 * HOUR),
    LSpans[0].EndUtc - LSpans[0].StartUtc);
end;

procedure TSlotsTests.Working_SpringForward_ThreeHoursFromMidnightToFour;
var
  LSpans: TSpanArray;
begin
  LSpans := WorkingSpans(NewYork, Week([Interval(7, 0, 240)]),
    TPcLocalDateTime.Create(2027, 3, 14), 1);
  TAssert.AssertEquals(1, Length(LSpans));
  TAssert.AssertEquals(NY_2027_03_14_0000, LSpans[0].StartUtc);
  TAssert.AssertEquals(NY_2027_03_14_0400, LSpans[0].EndUtc);
  TAssert.AssertEquals('02:00-03:00 never happens', Int64(3 * HOUR),
    LSpans[0].EndUtc - LSpans[0].StartUtc);
end;

procedure TSlotsTests.Working_StartInTheGap_IsTheJump;
var
  LSpans: TSpanArray;
begin
  // 02:00-05:00 on the day 02:00 doesn't exist: from 03:00 EDT.
  LSpans := WorkingSpans(NewYork, Week([Interval(7, 120, 300)]),
    TPcLocalDateTime.Create(2027, 3, 14), 1);
  TAssert.AssertEquals(1, Length(LSpans));
  TAssert.AssertEquals(NY_2027_03_14_0300, LSpans[0].StartUtc);
  TAssert.AssertEquals(NY_2027_03_14_0500, LSpans[0].EndUtc);
end;

procedure TSlotsTests.Working_NightShift_JoinsAcrossMidnight;
var
  LSpans: TSpanArray;
begin
  // Monday 22:00-24:00 and Tuesday 00:00-02:00: one span, though Tuesday is
  // outside the one day asked for.
  LSpans := WorkingSpans(NewYork, Week([Interval(2, 0, 120), Interval(1, 1320, 1440)]),
    TPcLocalDateTime.Create(2026, 11, 2), 1);
  TAssert.AssertEquals(1, Length(LSpans));
  TAssert.AssertEquals(NY_2026_11_02_2200, LSpans[0].StartUtc);
  TAssert.AssertEquals(NY_2026_11_03_0200, LSpans[0].EndUtc);
end;

procedure TSlotsTests.Join_SortsAndMerges;
var
  LSpans: TSpanArray;
begin
  LSpans := JoinSpans(Spans([Span(500, 600), Span(100, 200), Span(200, 300), Span(150, 250),
    Span(700, 700)]));
  TAssert.AssertEquals('touching and overlapping joined, the empty one dropped', 2,
    Length(LSpans));
  TAssert.AssertEquals(Int64(100), LSpans[0].StartUtc);
  TAssert.AssertEquals(Int64(300), LSpans[0].EndUtc);
  TAssert.AssertEquals(Int64(500), LSpans[1].StartUtc);
  TAssert.AssertEquals(Int64(600), LSpans[1].EndUtc);
end;

procedure TSlotsTests.Slots_PlainDay;
var
  LFrom, LTo: Int64;
  LStarts: TSlotStarts;
  LDay: TPcLocalDateTime;
begin
  LDay := TPcLocalDateTime.Create(2026, 11, 2);
  DaysWindow(NewYork, LDay, 1, LFrom, LTo);
  // 09:00-12:00, a 60-minute service every 15 minutes: 09:00 to 11:00.
  LStarts := FreeSlots(WorkingSpans(NewYork, Week([Interval(1, 540, 720)]), LDay, 1), nil,
    60, 0, 15, LFrom, LTo, 0);
  TAssert.AssertEquals(9, Length(LStarts));
  TAssert.AssertEquals(NY_2026_11_02_0900, LStarts[0]);
  TAssert.AssertEquals(NY_2026_11_02_0900 + 2 * HOUR, LStarts[8]);
end;

procedure TSlotsTests.Slots_FallBack_OneEveryRealHour;
var
  LFrom, LTo: Int64;
  LStarts: TSlotStarts;
  LDay: TPcLocalDateTime;
  LZone: IPcTimeZone;
begin
  LZone := NewYork;
  LDay := TPcLocalDateTime.Create(2026, 11, 1);
  DaysWindow(LZone, LDay, 1, LFrom, LTo);
  LStarts := FreeSlots(WorkingSpans(LZone, Week([Interval(7, 0, 180)]), LDay, 1), nil,
    60, 0, 60, LFrom, LTo, 0);
  TAssert.AssertEquals('00:00, 01:00 EDT, 01:00 EST, 02:00', 4, Length(LStarts));
  TAssert.AssertEquals('2026-11-01T00:00:00-04:00', PcLocalIsoString(LZone, LStarts[0]));
  TAssert.AssertEquals('2026-11-01T01:00:00-04:00', PcLocalIsoString(LZone, LStarts[1]));
  TAssert.AssertEquals('2026-11-01T01:00:00-05:00', PcLocalIsoString(LZone, LStarts[2]));
  TAssert.AssertEquals('2026-11-01T02:00:00-05:00', PcLocalIsoString(LZone, LStarts[3]));
end;

procedure TSlotsTests.Slots_NightShift_CrossMidnight_BelongToTheirDay;
var
  LFrom, LTo: Int64;
  LStarts: TSlotStarts;
  LDay: TPcLocalDateTime;
begin
  LDay := TPcLocalDateTime.Create(2026, 11, 2);
  DaysWindow(NewYork, LDay, 1, LFrom, LTo);
  // 90 minutes every 30 in 22:00-02:00: Monday's starts are 22:00 to 23:30
  // (the last ends at 01:00 Tuesday); 00:00 and 00:30 are Tuesday's.
  LStarts := FreeSlots(WorkingSpans(NewYork,
    Week([Interval(1, 1320, 1440), Interval(2, 0, 120)]), LDay, 1), nil,
    90, 0, 30, LFrom, LTo, 0);
  TAssert.AssertEquals(4, Length(LStarts));
  TAssert.AssertEquals(NY_2026_11_02_2200, LStarts[0]);
  TAssert.AssertEquals(NY_2026_11_02_2200 + 90 * 60, LStarts[3]);
end;

procedure TSlotsTests.Slots_Busy_WithBuffer;
var
  LFrom, LTo: Int64;
  LStarts: TSlotStarts;
  LDay: TPcLocalDateTime;
begin
  LDay := TPcLocalDateTime.Create(2026, 11, 2);
  DaysWindow(NewYork, LDay, 1, LFrom, LTo);
  // 60 minutes plus 15 of buffer, 09:00-12:00, busy 10:00-10:30: a start
  // before 10:30 would run into it with its buffer (09:00 + 75 > 10:00);
  // 11:00 is free, its buffer after closing.
  LStarts := FreeSlots(WorkingSpans(NewYork, Week([Interval(1, 540, 720)]), LDay, 1),
    Spans([Span(NY_2026_11_02_1000, NY_2026_11_02_1030)]), 60, 15, 15, LFrom, LTo, 0);
  TAssert.AssertEquals('10:30, 10:45, 11:00', 3, Length(LStarts));
  TAssert.AssertEquals(NY_2026_11_02_1030, LStarts[0]);
  TAssert.AssertEquals(NY_2026_11_02_1030 + 30 * 60, LStarts[2]);
  // A busy span over the whole day: nothing.
  LStarts := FreeSlots(WorkingSpans(NewYork, Week([Interval(1, 540, 720)]), LDay, 1),
    Spans([Span(LFrom - HOUR, LTo + HOUR)]), 60, 0, 15, LFrom, LTo, 0);
  TAssert.AssertEquals('time off all day', 0, Length(LStarts));
end;

procedure TSlotsTests.Slots_NotBeforeNow;
var
  LFrom, LTo: Int64;
  LStarts: TSlotStarts;
  LDay: TPcLocalDateTime;
begin
  LDay := TPcLocalDateTime.Create(2026, 11, 2);
  DaysWindow(NewYork, LDay, 1, LFrom, LTo);
  LStarts := FreeSlots(WorkingSpans(NewYork, Week([Interval(1, 540, 720)]), LDay, 1), nil,
    60, 0, 15, LFrom, LTo, NY_2026_11_02_1040);
  TAssert.AssertEquals('10:45, 11:00', 2, Length(LStarts));
  TAssert.AssertEquals(NY_2026_11_02_1040 + 5 * 60, LStarts[0]);
end;

procedure TSlotsTests.Slots_NoWeek_NoSlots;
var
  LFrom, LTo: Int64;
  LDay: TPcLocalDateTime;
begin
  LDay := TPcLocalDateTime.Create(2026, 11, 2);
  DaysWindow(NewYork, LDay, 7, LFrom, LTo);
  TAssert.AssertEquals(0, Length(FreeSlots(WorkingSpans(NewYork, nil, LDay, 7), nil,
    60, 0, 15, LFrom, LTo, 0)));
  TAssert.AssertEquals('a service longer than the day''s hours', 0,
    Length(FreeSlots(WorkingSpans(NewYork, Week([Interval(1, 540, 600)]), LDay, 7), nil,
    90, 0, 15, LFrom, LTo, 0)));
end;

initialization
  RegisterTest(TSlotsTests);

end.
