unit Agenda.HttpTransportTests;

{ Tests for Agenda.HttpTransport and its fake: header lines split as
  fphttpclient keeps them, headers found in any case, the methods that
  always carry a body, the fake's queue and its record of requests, and the
  compiler's own client on a closed port (no answer is EHttpTransport). An
  exchange with a real server is AgendaClientCheck's (tools/test_http.sh).

  DUnitX master. The FPCUnit mirror (tests/Unit/fpc) is generated by
  tools/gen_fpc_mirror.py; never edit the mirror by hand. }

interface

uses
  DUnitX.TestFramework,
  Agenda.DUnitXCompat,
  SysUtils,
  Agenda.HttpTransport,
  Agenda.HttpTransport.Fake;

type
  [TestFixture]
  THttpTransportTests = class
  private
    FTransport: IHttpTransport;
    procedure SendToFake;
    procedure SendToClosedPort;
  public
    [Test] procedure HeaderLine_Split;
    [Test] procedure HeaderLine_NotAHeader;
    [Test] procedure Header_AnyCase_FirstWins;
    [Test] procedure MethodsWithBody;
    [Test] procedure Fake_AnswersInOrder_KeepsRequests;
    [Test] procedure Fake_Fail_IsNoAnswer;
    [Test] procedure Fake_Empty_IsTheTestsFailure;
    [Test] procedure Native_ClosedPort_IsNoAnswer;
  end;

implementation

procedure THttpTransportTests.SendToFake;
begin
  FTransport.Send(TTransportRequest.Create('GET', 'http://agenda.test/health/live'));
end;

procedure THttpTransportTests.SendToClosedPort;
var
  LRequest: TTransportRequest;
begin
  // Port 1 on the loopback: nothing listens there (tcpmux, never enabled).
  LRequest := TTransportRequest.Create('POST', 'http://127.0.0.1:1/auth/login');
  LRequest.TimeoutMs := 1000;
  FTransport.Send(LRequest);
end;

procedure THttpTransportTests.HeaderLine_Split;
var
  LField: THttpField;
begin
  TAssert.AssertTrue(SplitHttpHeaderLine('ETag: "3"', LField));
  TAssert.AssertEquals('ETag', LField.Name);
  TAssert.AssertEquals('"3"', LField.Value);
  TAssert.AssertTrue(SplitHttpHeaderLine('Retry-After:5', LField));
  TAssert.AssertEquals('Retry-After', LField.Name);
  TAssert.AssertEquals('5', LField.Value);
  // Split at the first colon only.
  TAssert.AssertTrue(SplitHttpHeaderLine('Location:  http://127.0.0.1:9400/x ', LField));
  TAssert.AssertEquals('http://127.0.0.1:9400/x', LField.Value);
  TAssert.AssertTrue(SplitHttpHeaderLine('X-Empty:', LField));
  TAssert.AssertEquals('X-Empty', LField.Name);
  TAssert.AssertEquals('', LField.Value);
end;

procedure THttpTransportTests.HeaderLine_NotAHeader;
var
  LField: THttpField;
begin
  TAssert.AssertFalse(SplitHttpHeaderLine('HTTP/1.1 200 OK', LField));
  TAssert.AssertFalse(SplitHttpHeaderLine(': no name', LField));
  TAssert.AssertFalse(SplitHttpHeaderLine('', LField));
  TAssert.AssertEquals('', LField.Name);
end;

procedure THttpTransportTests.Header_AnyCase_FirstWins;
var
  LResponse: TTransportResponse;
  LRequest: TTransportRequest;
  LValue: string;
begin
  SetLength(LResponse.Headers, 3);
  LResponse.Headers[0].Name := 'Content-Type';
  LResponse.Headers[0].Value := 'application/json';
  LResponse.Headers[1].Name := 'etag';
  LResponse.Headers[1].Value := '"7"';
  LResponse.Headers[2].Name := 'ETag';
  LResponse.Headers[2].Value := '"8"';
  TAssert.AssertEquals('"7"', LResponse.Header('ETAG'));
  TAssert.AssertEquals('', LResponse.Header('Retry-After'));
  TAssert.AssertFalse(FindHttpField(LResponse.Headers, 'Retry-After', LValue));
  TAssert.AssertTrue(FindHttpField(LResponse.Headers, 'content-type', LValue));
  TAssert.AssertEquals('application/json', LValue);

  LRequest := TTransportRequest.Create('PATCH', 'http://agenda.test/customers/1');
  LRequest.AddHeader('If-Match', '"2"');
  LRequest.AddHeader('Authorization', 'Bearer t');
  TAssert.AssertEquals(2, Length(LRequest.Headers));
  TAssert.AssertEquals('"2"', LRequest.Header('if-match'));
  TAssert.AssertEquals(0, LRequest.TimeoutMs);
end;

procedure THttpTransportTests.MethodsWithBody;
begin
  TAssert.AssertTrue(HttpMethodHasBody('POST'));
  TAssert.AssertTrue(HttpMethodHasBody('put'));
  TAssert.AssertTrue(HttpMethodHasBody('Patch'));
  TAssert.AssertFalse(HttpMethodHasBody('GET'));
  TAssert.AssertFalse(HttpMethodHasBody('DELETE'));
  TAssert.AssertFalse(HttpMethodHasBody('HEAD'));
end;

procedure THttpTransportTests.Fake_AnswersInOrder_KeepsRequests;
var
  LFake: TFakeHttpTransport;
  LRequest: TTransportRequest;
  LResponse: TTransportResponse;
begin
  LFake := TFakeHttpTransport.Create;
  FTransport := LFake;
  LFake.Answer(200, '{"accessToken":"a"}', ['Content-Type: application/json']);
  LFake.Answer(412, '', ['ETag: "4"', 'Retry-After: 2']);
  TAssert.AssertEquals(2, LFake.Pending);

  LRequest := TTransportRequest.Create('POST', 'http://agenda.test/auth/login');
  LRequest.AddHeader('Content-Type', 'application/json');
  LRequest.Body := '{"email":"joao@demo.test"}';
  LResponse := FTransport.Send(LRequest);
  TAssert.AssertEquals(200, LResponse.Status);
  TAssert.AssertEquals('{"accessToken":"a"}', LResponse.Body);
  TAssert.AssertEquals('application/json', LResponse.Header('content-type'));

  LResponse := FTransport.Send(TTransportRequest.Create('PATCH', 'http://agenda.test/appointments/9'));
  TAssert.AssertEquals(412, LResponse.Status);
  TAssert.AssertEquals('', LResponse.Body);
  TAssert.AssertEquals('"4"', LResponse.Header('ETag'));
  TAssert.AssertEquals('2', LResponse.Header('Retry-After'));

  TAssert.AssertEquals(0, LFake.Pending);
  TAssert.AssertEquals(2, LFake.RequestCount);
  TAssert.AssertEquals('POST', LFake.Request(0).Method);
  TAssert.AssertEquals(LRequest.Body, LFake.Request(0).Body);
  TAssert.AssertEquals('application/json', LFake.Request(0).Header('Content-Type'));
  TAssert.AssertEquals('http://agenda.test/appointments/9', LFake.Requests[1].Url);
  FTransport := nil;
end;

procedure THttpTransportTests.Fake_Fail_IsNoAnswer;
var
  LFake: TFakeHttpTransport;
begin
  LFake := TFakeHttpTransport.Create;
  FTransport := LFake;
  LFake.Fail;
  LFake.Answer(204);
  TAssert.AssertException(EHttpTransport, SendToFake);
  // The failure took its place in the queue: the next one answers.
  TAssert.AssertEquals(204, FTransport.Send(
    TTransportRequest.Create('GET', 'http://agenda.test/me')).Status);
  TAssert.AssertEquals(2, LFake.RequestCount);
  FTransport := nil;
end;

procedure THttpTransportTests.Fake_Empty_IsTheTestsFailure;
var
  LFake: TFakeHttpTransport;
begin
  LFake := TFakeHttpTransport.Create;
  FTransport := LFake;
  TAssert.AssertException(EFakeHttpTransport, SendToFake);
  TAssert.AssertEquals(1, LFake.RequestCount);
  FTransport := nil;
end;

procedure THttpTransportTests.Native_ClosedPort_IsNoAnswer;
begin
  FTransport := NewHttpTransport;
  TAssert.AssertException(EHttpTransport, SendToClosedPort);
  FTransport := nil;
end;

initialization
  TDUnitX.RegisterTestFixture(THttpTransportTests);

end.
